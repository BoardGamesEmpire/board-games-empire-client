    "description": "The button beside the search field that opens the filters. It counts the filters in use, one per chip under the search field: one per chosen type or medium, one per range, and one for the missing-base-game switch.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "gameFiltersTitle": "Filters",
  "@gameFiltersTitle": {
    "description": "Heading of the sheet holding every search filter."
  },
  "gameFiltersClearAll": "Clear all",
