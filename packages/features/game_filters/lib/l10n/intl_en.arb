  "gameFiltersRangeFromNamed": "{range}, from",
  "@gameFiltersRangeFromNamed": {
    "description": "Accessible name, never shown, of the field for a filter range's lowest value, so a screen reader says which range it belongs to. {range} is the range's heading: Publish year, Players or Play time.",
    "placeholders": {
      "range": {
        "type": "String"
      }
    }
  },
  "gameFiltersRangeToNamed": "{range}, to",
