    "description": "Accessible name, never shown, of the field for a filter range's highest value, so a screen reader says which range it belongs to. {range} is the range's heading: Publish year, Players or Play time.",
    "placeholders": {
      "range": {
        "type": "String"
      }
    }
  },
  "gameFiltersYearHelper": "Use a minus sign for years BCE",
