    "description": "A filter choice under the Medium heading, and a filter in use under the collection's search field: physical copies of a game, such as a boxed board game or a game disc."
  },
  "gameFiltersMediumDigital": "Digital",
  "@gameFiltersMediumDigital": {
    "description": "A filter choice under the Medium heading, and a filter in use under the collection's search field: digital copies of a game, such as a download or an app."
  },
  "gameFiltersMissingBaseGame": "Only expansions missing their base game",
  "@gameFiltersMissingBaseGame": {
    "description": "Switch, last in the filter sheet. On, the list keeps only the expansions whose base game isn't in it."
  },
  "gameFiltersMissingBaseGameInUse": "Missing base game",
  "@gameFiltersMissingBaseGameInUse": {
    "description": "The filter in use, shown as a chip under the collection's search field, that keeps only the expansions whose base game isn't in the list. Also names that filter's leave-out switch to a screen reader."
  },
  "gameFiltersMissingBaseGameExcluded": "Not missing base game",
  "@gameFiltersMissingBaseGameExcluded": {
    "description": "gameFiltersMissingBaseGameInUse flipped, shown as a chip under the collection's search field: the list leaves out the expansions whose base game isn't in it, and keeps everything else."
  },
  "gameFiltersExclude": "Leave these out instead",
  "@gameFiltersExclude": {
    "description": "Switch under each section of the filter sheet. On, the list leaves out what the section's choices match and keeps everything else."
  },
  "gameFiltersExcludeNamed": "{filter}, leave these out instead",
  "@gameFiltersExcludeNamed": {
    "description": "Accessible name, never shown, of gameFiltersExclude, so a screen reader says which section's switch it is. {filter} is the section's heading, such as Platform, or gameFiltersMissingBaseGameInUse.",
    "placeholders": {
      "filter": {
        "type": "String",
        "example": "Platform"
      }
    }
  },
  "gameFiltersExcludeNothingChosen": "Choose something above first",
  "@gameFiltersExcludeNothingChosen": {
    "description": "Under gameFiltersExclude while it can't be turned: its section has nothing chosen, so there is nothing to leave out."
  },
  "gameFiltersInUseExcluded": "Not {filter}",
  "@gameFiltersInUseExcluded": {
    "description": "A filter in use that is flipped, shown as a chip under the collection's search field and read by a screen reader: the list leaves out what the filter matches. {filter} is the chip's own label, such as Tabletop or 2–4 players.",
    "placeholders": {
      "filter": {
        "type": "String",
        "example": "Tabletop"
      }
    }
  },
  "gameFiltersFilterRemove": "Remove {filter}",
  "@gameFiltersFilterRemove": {
    "description": "Tooltip and screen-reader label of the remove button on a filter in use, shown under the search field.",
    "placeholders": {
      "filter": {
        "type": "String",
        "example": "Expansion"
      }
    }
  },
  "gameFiltersFilterYear": "Publish year",
  "@gameFiltersFilterYear": {
    "description": "Heading over the filter sheet's publish-year range."
  },
  "gameFiltersFilterPlayers": "Players",
  "@gameFiltersFilterPlayers": {
    "description": "Heading over the filter sheet's player-count range."
  },
  "gameFiltersFilterPlayTime": "Play time",
  "@gameFiltersFilterPlayTime": {
    "description": "Heading over the filter sheet's play-time range and its length bands."
  },
  "gameFiltersRangeFrom": "From",
