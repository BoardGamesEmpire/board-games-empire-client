{
  "@@locale": "en",
  "apiKeysTitle": "API keys",
  "@apiKeysTitle": {
    "description": "Title of the screen that lists the signed-in user's API keys on this server. An API key lets a script or another app act as the user, with only the permissions the key holds. Also the title of the row in Settings that opens the screen."
  },
  "apiKeysSettingsSubtitle": "Keys for programs to use {serverName} as you",
  "@apiKeysSettingsSubtitle": {
    "description": "Second line of the API keys row in Settings, in the section for the server the user is signed in to. {serverName} is the name the server gives itself. The row opens the list of the user's API keys on that server.",
    "placeholders": {
      "serverName": {
        "type": "String",
        "example": "Board Game Night"
      }
    }
  },
  "apiKeysLoading": "Loading your API keys…",
  "@apiKeysLoading": {
    "description": "Shown beside a spinner, and read out by screen readers, while the list of the user's API keys is being read from the server."
  },
  "apiKeysLoadFailed": "Couldn't load your API keys",
  "@apiKeysLoadFailed": {
    "description": "Title of the message shown in place of the list when the user's API keys could not be read from the server."
  },
  "apiKeysLoadFailedBody": "Check your connection, then try again.",
  "@apiKeysLoadFailedBody": {
    "description": "Body under the title when the user's API keys could not be read from the server."
  },
  "apiKeysRetry": "Try again",
  "@apiKeysRetry": {
    "description": "Button that reads the list of API keys from the server again after it failed."
  },
  "apiKeysEmptyTitle": "No API keys yet",
  "@apiKeysEmptyTitle": {
    "description": "Title shown in place of the list when the user has no API keys on this server."
  },
  "apiKeysEmptyBody": "An API key lets a script or another app use this server as you, with only the permissions you give the key.",
  "@apiKeysEmptyBody": {
    "description": "Body under the empty list's title, explaining what an API key is."
  },
  "apiKeysEmptyEnabled": "No enabled keys",
  "@apiKeysEmptyEnabled": {
    "description": "Shown in place of the list when the 'Enabled' filter is chosen and none of the user's loaded API keys is enabled."
  },
  "apiKeysEmptyDisabled": "No disabled keys",
  "@apiKeysEmptyDisabled": {
    "description": "Shown in place of the list when the 'Disabled' filter is chosen and none of the user's loaded API keys is disabled."
  },
  "apiKeysEmptyFilterMore": "Some may be among the keys not loaded yet. Choose More to load them.",
  "@apiKeysEmptyFilterMore": {
    "description": "Body under 'No enabled keys' or 'No disabled keys' while the server has more keys than the list has loaded. 'More' is the name of the button under the list that loads the next keys."
  },
  "apiKeysFilterAll": "All",
  "@apiKeysFilterAll": {
    "description": "Filter choice above the API key list that shows every loaded key, enabled or disabled."
  },
  "apiKeysFilterEnabled": "Enabled",
  "@apiKeysFilterEnabled": {
    "description": "Filter choice above the API key list that shows only the keys that are enabled, which work."
  },
  "apiKeysFilterDisabled": "Disabled",
  "@apiKeysFilterDisabled": {
    "description": "Filter choice above the API key list that shows only the keys that are disabled, which don't work until enabled again."
  },
  "apiKeysMore": "More",
  "@apiKeysMore": {
    "description": "Button under the API key list that loads the next keys from the server."
  },
  "apiKeysLoadingMore": "Loading more keys…",
  "@apiKeysLoadingMore": {
    "description": "The name of the 'More' button while it is loading the next keys. Read out by screen readers as the button's name."
  },
  "apiKeysMoreFailed": "Couldn't load more keys. Choose More to try again.",
  "@apiKeysMoreFailed": {
    "description": "Shown above the 'More' button when the next keys could not be read from the server. The keys already shown stay."
  },
  "apiKeysRefreshFailed": "Couldn't refresh your API keys. They may be out of date.",
  "@apiKeysRefreshFailed": {
    "description": "Shown above the API key list when reading it again from the server failed. The keys already shown stay, but may have changed since they were read."
  },
  "apiKeysRefresh": "Refresh",
  "@apiKeysRefresh": {
    "description": "Name and tooltip of the app bar button that reads the API key list from the server again."
  },
  "apiKeysRefreshing": "Refreshing…",
  "@apiKeysRefreshing": {
    "description": "Name and tooltip of the refresh button while the API key list is being read again."
  },
  "apiKeyUnnamed": "Unnamed key",
  "@apiKeyUnnamed": {
    "description": "Shown as an API key's name when the server has no name for it."
  },
  "apiKeyStart": "{start}…",
  "@apiKeyStart": {
    "description": "The first characters of an API key's secret, followed by an ellipsis, so the user can tell keys apart. Only the first characters are ever shown.",
    "placeholders": {
      "start": {
        "type": "String",
        "example": "bge_a1B2"
      }
    }
  },
  "apiKeyScopeCount": "{count, plural, =1{1 permission} other{{count} permissions}}",
  "@apiKeyScopeCount": {
    "description": "How many permissions an API key holds, on its row in the key list, when the risk levels of its permissions aren't known.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "apiKeyScopeCountWithRisk": "{count, plural, =1{1 permission, highest risk {risk}} other{{count} permissions, highest risk {risk}}}",
  "@apiKeyScopeCountWithRisk": {
    "description": "How many permissions an API key holds and the highest risk level among them, on its row in the key list. {risk} is one of the risk level names: Low, Medium, High or Critical.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      },
      "risk": {
        "type": "String",
        "example": "High"
      }
    }
  },
  "apiKeyNoScopes": "No permissions: this key works nowhere",
  "@apiKeyNoScopes": {
    "description": "Shown for an API key that holds no permissions, which can't be used for anything until it is given some."
  },
  "apiKeyRiskLow": "Low",
  "@apiKeyRiskLow": {
    "description": "Name of the lowest risk level a permission can have."
  },
  "apiKeyRiskMedium": "Medium",
  "@apiKeyRiskMedium": {
    "description": "Name of the second of four risk levels a permission can have."
  },
  "apiKeyRiskHigh": "High",
  "@apiKeyRiskHigh": {
    "description": "Name of the third of four risk levels a permission can have."
  },
  "apiKeyRiskCritical": "Critical",
  "@apiKeyRiskCritical": {
    "description": "Name of the highest risk level a permission can have. Giving a key a Critical permission needs the user's confirmation."
  },
  "apiKeyRiskUnknown": "Unknown",
  "@apiKeyRiskUnknown": {
    "description": "Shown as a permission's risk level when the server named a level this app doesn't know."
  },
  "apiKeyExpires": "Expires {date}",
  "@apiKeyExpires": {
    "description": "When an API key stops working.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "yMMMd"
      }
    }
  },
  "apiKeyNeverExpires": "Never expires",
  "@apiKeyNeverExpires": {
    "description": "Shown in place of an expiry date for an API key that doesn't stop working on a date."
  },
  "apiKeyEnabled": "Enabled",
  "@apiKeyEnabled": {
    "description": "Says an API key is enabled: it works."
  },
  "apiKeyDisabled": "Disabled",
  "@apiKeyDisabled": {
    "description": "Says an API key is disabled: it doesn't work until it is enabled again."
  },
  "apiKeyLastUsed": "Last used {date}",
  "@apiKeyLastUsed": {
    "description": "When an API key was last used.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "yMMMd"
      }
    }
  },
  "apiKeyNeverUsed": "Never used",
  "@apiKeyNeverUsed": {
    "description": "Shown in place of a last-used date for an API key that hasn't been used yet."
  },
  "apiKeyDetailTitle": "API key",
  "@apiKeyDetailTitle": {
    "description": "Title of an API key's own page while the key itself isn't shown: as it loads, when it couldn't be loaded, and when it no longer exists. Once the key is shown, its name is the title."
  },
  "apiKeyDetailLoading": "Loading this key…",
  "@apiKeyDetailLoading": {
    "description": "Shown beside a spinner, and read out by screen readers, while one API key is being read from the server."
  },
  "apiKeyDetailLoadFailed": "Couldn't load this key",
  "@apiKeyDetailLoadFailed": {
    "description": "Title of the message shown in place of an API key's page when the key could not be read from the server."
  },
  "apiKeyDetailLoadFailedBody": "Check your connection, then try again.",
  "@apiKeyDetailLoadFailedBody": {
    "description": "Body under the title when an API key could not be read from the server."
  },
  "apiKeyDetailRetry": "Try again",
  "@apiKeyDetailRetry": {
    "description": "Button that reads the API key from the server again after it failed."
  },
  "apiKeyGoneTitle": "This key no longer exists",
  "@apiKeyGoneTitle": {
    "description": "Shown in place of an API key's page when the server has no such key: it was deleted, perhaps from another device, or it expired, which deletes it."
  },
  "apiKeyGoneBody": "It was deleted, or it expired.",
  "@apiKeyGoneBody": {
    "description": "Body under 'This key no longer exists'. An API key that expires is deleted by the server."
  },
  "apiKeyGoneBack": "Back to your API keys",
  "@apiKeyGoneBack": {
    "description": "Button under 'This key no longer exists' that goes back to the list of the user's API keys."
  },
  "apiKeyCreated": "Created {date}",
  "@apiKeyCreated": {
    "description": "When an API key was made, on its own page.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "yMMMd"
      }
    }
  },
  "apiKeyEnabledSwitch": "Enabled",
  "@apiKeyEnabledSwitch": {
    "description": "Label of the switch on an API key's own page that turns the key on or off. A disabled key is kept, but doesn't work until it is enabled again."
  },
  "apiKeyEnabledOn": "Programs can use this key.",
  "@apiKeyEnabledOn": {
    "description": "Under the 'Enabled' switch while the API key is enabled."
  },
  "apiKeyEnabledOff": "Programs using this key are refused until you enable it again.",
  "@apiKeyEnabledOff": {
    "description": "Under the 'Enabled' switch while the API key is disabled."
  },
  "apiKeySaving": "Saving…",
  "@apiKeySaving": {
    "description": "Read out by screen readers, beside a progress bar, while turning an API key on or off is on its way to the server."
  },
  "apiKeyDisableFailed": "Couldn't disable {name}",
  "@apiKeyDisableFailed": {
    "description": "Title of the message shown above the 'Enabled' switch when turning the API key off failed. {name} is the key's name, or 'Unnamed key'.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "CI deploy"
      }
    }
  },
  "apiKeyEnableFailed": "Couldn't enable {name}",
  "@apiKeyEnableFailed": {
    "description": "Title of the message shown above the 'Enabled' switch when turning the API key on failed. {name} is the key's name, or 'Unnamed key'.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "CI deploy"
      }
    }
  },
  "apiKeyDisabledDone": "Disabled {name}",
  "@apiKeyDisabledDone": {
    "description": "Said once the user has left an API key's page, when turning the key off they started there went through. {name} is the key's name, or 'Unnamed key'.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "CI deploy"
      }
    }
  },
  "apiKeyEnabledDone": "Enabled {name}",
  "@apiKeyEnabledDone": {
    "description": "Said once the user has left an API key's page, when turning the key on they started there went through. {name} is the key's name, or 'Unnamed key'.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "CI deploy"
      }
    }
  },
  "apiKeyPermissionsHeading": "Permissions",
  "@apiKeyPermissionsHeading": {
    "description": "Heading over the list of what an API key may do, on the key's own page."
  },
  "apiKeyScopeRisk": "Risk: {level}",
  "@apiKeyScopeRisk": {
    "description": "Under one permission an API key holds: how much harm it can do if the key leaks. {level} is one of the risk level names: Low, Medium, High, Critical or Unknown.",
    "placeholders": {
      "level": {
        "type": "String",
        "example": "Critical"
      }
    }
  },
  "apiKeyScopeNoLongerAvailable": "No longer available",
  "@apiKeyScopeNoLongerAvailable": {
    "description": "Under a permission an API key holds that the user may no longer give a key. The permission is shown by its code, as there is no description for it."
  },
  "apiKeyScopePinned": "Limited to one record",
  "@apiKeyScopePinned": {
    "description": "Under a permission an API key holds that covers a single record rather than every record the user may reach."
  },
  "apiKeyScopesEmpty": "This key has no permissions, so it works nowhere until it is given some.",
  "@apiKeyScopesEmpty": {
    "description": "Shown in place of the permissions on the page of an API key that holds none."
  },
  "apiKeyScopesUndescribed": "Couldn't load what these permissions allow, so each is shown by its code.",
  "@apiKeyScopesUndescribed": {
    "description": "Shown above an API key's permissions when the descriptions of the permissions could not be read from the server. Each permission is then shown by its code, such as 'collection:read'."
  },
  "apiKeyScopeEverything": "Everything I can do",
  "@apiKeyScopeEverything": {
    "description": "Label of the switch above the permissions to choose from, when creating an API key. On, it gives the key every permission the user may give a key, and each permission below shows as included."
  },
  "apiKeyScopeEverythingIncludes": "{count, plural, =1{Includes 1 permission} other{Includes {count} permissions}}",
  "@apiKeyScopeEverythingIncludes": {
    "description": "Under the 'Everything I can do' switch while it is on: how many permissions it gives the key. Each of them is listed below it.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "apiKeyScopeNoLongerAvailableRemoved": "No longer available; saving removes it",
  "@apiKeyScopeNoLongerAvailableRemoved": {
    "description": "Under a permission an API key holds that the user may no longer give a key, once the user has changed the key's permissions: saving the change takes this permission off the key. The permission is shown by its code, as there is no description for it."
  },
  "apiKeyScopesNoneWarning": "With no permissions, this key works nowhere.",
  "@apiKeyScopesNoneWarning": {
    "description": "Warning under the permissions to choose from when none is chosen. A key may be saved with none, but it can't be used for anything until it is given some."
  },
  "apiKeyDelete": "Delete key",
  "@apiKeyDelete": {
    "description": "Button at the end of an API key's page that deletes the key, after asking."
  },
  "apiKeyDeleting": "Deleting…",
  "@apiKeyDeleting": {
    "description": "The name of the 'Delete key' button while the key is being deleted. Read out by screen readers as the button's name."
  },
  "apiKeyDeleteConfirmTitle": "Delete {name}?",
  "@apiKeyDeleteConfirmTitle": {
    "description": "Title of the dialog that asks before deleting an API key. {name} is the key's name, or 'Unnamed key'.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "CI deploy"
      }
    }
  },
  "apiKeyDeleteConfirmBody": "Programs using it stop working at once. This can't be undone.",
  "@apiKeyDeleteConfirmBody": {
    "description": "Body of the dialog that asks before deleting an API key."
  },
  "apiKeyDeleteCancel": "Cancel",
  "@apiKeyDeleteCancel": {
    "description": "Button in the dialog that asks before deleting an API key: closes it and deletes nothing."
  },
  "apiKeyDeleteConfirm": "Delete",
  "@apiKeyDeleteConfirm": {
    "description": "Button in the dialog that asks before deleting an API key: deletes it."
  },
  "apiKeyDeleted": "Deleted {name}",
  "@apiKeyDeleted": {
    "description": "Said once an API key has been deleted, on the page the user goes back to. {name} is the key's name, or 'Unnamed key'.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "CI deploy"
      }
    }
  },
  "apiKeyDeleteFailed": "Couldn't delete {name}",
  "@apiKeyDeleteFailed": {
    "description": "Title of the message shown above 'Delete key' when deleting the API key failed. {name} is the key's name, or 'Unnamed key'.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "CI deploy"
      }
    }
  },
  "apiKeyFailedLate": "{what}: {why}",
  "@apiKeyFailedLate": {
    "description": "Said once the user has left an API key's page, when a change they started there failed. {what} says which change, as 'Couldn't delete CI deploy'; {why} is the reason, as 'Couldn't reach the server. Check your connection, then try again.'",
    "placeholders": {
      "what": {
        "type": "String",
        "example": "Couldn't delete CI deploy"
      },
      "why": {
        "type": "String",
        "example": "Couldn't reach the server. Check your connection, then try again."
      }
    }
  },
  "apiKeyFailureNeedsRecentSignIn": "This needs a recent sign-in. Sign out, sign in again, then try once more.",
  "@apiKeyFailureNeedsRecentSignIn": {
    "description": "Shown when the server refused a change to an API key because the user signed in too long ago."
  },
  "apiKeyFailureCriticalNeedsConfirmation": "A Critical permission needs your confirmation first.",
  "@apiKeyFailureCriticalNeedsConfirmation": {
    "description": "Shown when the server refused to give a key a permission of the Critical risk level because the user hadn't confirmed it."
  },
  "apiKeyFailureScopeNotGrantable": "You can't give a key the permission {permission}.",
  "@apiKeyFailureScopeNotGrantable": {
    "description": "Shown when the server refused a permission the user tried to give an API key, because the user may not give it. {permission} is the permission's description, or its code when the app doesn't have its description.",
    "placeholders": {
      "permission": {
        "type": "String",
        "example": "Read your game collection"
      }
    }
  },
  "apiKeyFailureScopeNotPinnable": "The permission {permission} can't be limited to one record.",
  "@apiKeyFailureScopeNotPinnable": {
    "description": "Shown when the server refused to limit a permission of an API key to a single record. {permission} is the permission's description, or its code when the app doesn't have its description.",
    "placeholders": {
      "permission": {
        "type": "String",
        "example": "Manage your households"
      }
    }
  },
  "apiKeyFailureScopeUnnamed": "You can't give a key one of these permissions.",
  "@apiKeyFailureScopeUnnamed": {
    "description": "Shown when the server refused one of the permissions the user tried to give an API key without saying which."
  },
  "apiKeyFailureScopeUnpinnableUnnamed": "One of these permissions can't be limited to one record.",
  "@apiKeyFailureScopeUnpinnableUnnamed": {
    "description": "Shown when the server refused to limit one of an API key's permissions to a single record without saying which."
  },
  "apiKeyFailureExpiryOutOfRange": "A key can last from {min, plural, =1{1 day} other{{min} days}} to {max, plural, =1{1 day} other{{max} days}}.",
  "@apiKeyFailureExpiryOutOfRange": {
    "description": "Shown when the server refused the lifetime the user chose for an API key.",
    "placeholders": {
      "min": {
        "type": "int",
        "example": "1"
      },
      "max": {
        "type": "int",
        "example": "365"
      }
    }
  },
  "apiKeyFailureNotFound": "This key no longer exists.",
  "@apiKeyFailureNotFound": {
    "description": "Shown when the server says the API key the user acted on doesn't exist, for example because it was deleted elsewhere."
  },
  "apiKeyFailureTransient": "Couldn't reach the server. Check your connection, then try again.",
  "@apiKeyFailureTransient": {
    "description": "Shown when a request about an API key got no answer from the server that says anything about it."
  },
  "apiKeyFailureGeneric": "The server couldn't do that. Try again later.",
  "@apiKeyFailureGeneric": {
    "description": "Shown when the server refused a request about an API key and gave no message of its own."
  },
  "apiKeyExpiryPreset": "{count, plural, =1{1 day} other{{count} days}}",
  "@apiKeyExpiryPreset": {
    "description": "Label of a choice of how long a new API key lasts, such as '30 days' or '90 days'. One of a row of choices next to 'Custom'.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "30"
      }
    }
  },
  "apiKeyExpiryCustom": "Custom",
  "@apiKeyExpiryCustom": {
    "description": "Label of the choice of how long an API key lasts that lets the user type their own number of days. Next to choices such as '30 days'. Choosing it shows a field for the number."
  },
  "apiKeyExpiryCustomField": "Number of days",
  "@apiKeyExpiryCustomField": {
    "description": "Label of the field where the user types how many days an API key lasts, shown after they choose 'Custom'."
  },
  "apiKeyExpiryCustomHelper": "Whole days, from {min} to {max}",
  "@apiKeyExpiryCustomHelper": {
    "description": "Under the field where the user types how many days an API key lasts: the fewest and the most days the server allows.",
    "placeholders": {
      "min": {
        "type": "int",
        "example": "1"
      },
      "max": {
        "type": "int",
        "example": "365"
      }
    }
  },
  "apiKeyExpiryCustomInvalid": "Enter a whole number of days from {min} to {max}.",
  "@apiKeyExpiryCustomInvalid": {
    "description": "Error under the field where the user types how many days an API key lasts, when what they typed isn't a whole number in the range the server allows.",
    "placeholders": {
      "min": {
        "type": "int",
        "example": "1"
      },
      "max": {
        "type": "int",
        "example": "365"
      }
    }
  },
  "apiKeyExpiryDate": "Expires {date}",
  "@apiKeyExpiryDate": {
    "description": "Under the choices of how long an API key lasts: the day the key stops working if the user chooses what is selected, in the device's time zone. It is read out when the choice changes.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "yMMMd"
      }
    }
  }
}
