  "apiKeyFailureCriticalNeedsConfirmation": "A Critical permission needs your confirmation first.",
  "@apiKeyFailureCriticalNeedsConfirmation": {
    "description": "Shown when the server refused to give a key a permission of the Critical risk level because the user hadn't confirmed it."
