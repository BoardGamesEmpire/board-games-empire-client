  "apiKeyDeleteConfirm": "Delete",
  "@apiKeyDeleteConfirm": {
    "description": "Button in the dialog that asks before deleting an API key: deletes it."
  },
  "apiKeyDeleted": "Deleted {name}",
  "@apiKeyDeleted": {
    "description": "Said once an API key has been deleted, on the page the user goes back to. {name} is the key's name, or 'Unnamed key'.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "CI deploy"
      }
    }
  },
  "apiKeyDeleteFailed": "Couldn't delete {name}",
  "@apiKeyDeleteFailed": {
    "description": "Title of the message shown above 'Delete key' when deleting the API key failed. {name} is the key's name, or 'Unnamed key'.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "CI deploy"
      }
    }
  },
  "apiKeyFailedLate": "{what}: {why}",
  "@apiKeyFailedLate": {
    "description": "Said once the user has left an API key's page, when a change they started there failed. {what} says which change, as 'Couldn't delete CI deploy'; {why} is the reason, as 'Couldn't reach the server. Check your connection, then try again.'",
    "placeholders": {
      "what": {
        "type": "String",
        "example": "Couldn't delete CI deploy"
      },
      "why": {
        "type": "String",
        "example": "Couldn't reach the server. Check your connection, then try again."
      }
    }
  },
  "apiKeyFailureNeedsRecentSignIn": "Giving a key a Critical permission needs a recent sign-in. Sign out, sign in again, then try once more.",
  "@apiKeyFailureNeedsRecentSignIn": {
    "description": "Shown when the server refused to make an API key, or to change one, because it would give the key a permission of the Critical risk level and the user signed in too long ago. The server only asks for a recent sign-in for a Critical permission."
