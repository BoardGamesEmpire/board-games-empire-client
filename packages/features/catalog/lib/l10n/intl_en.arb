{
  "@@locale": "en",
  "catalogBrowseTitle": "Games",
  "@catalogBrowseTitle": {
    "description": "Title of the screen listing every game on the server, and the label of the drawer entry that opens it."
  },
  "catalogBrowseLoading": "Loading games…",
  "@catalogBrowseLoading": {
    "description": "Announced and shown while the first page of the server's games is being fetched."
  },
  "catalogBrowseEmpty": "There are no games on this server yet.",
  "@catalogBrowseEmpty": {
    "description": "Shown when the server answered and has no games at all."
  },
  "catalogBrowseFromCache": "Couldn't load games from the server. These are the games saved on this device.",
  "@catalogBrowseFromCache": {
    "description": "Banner over the games list when the server's list could not be loaded, for any reason, so the list shows the games this device saved earlier instead. Offers a retry. Deliberately names no cause."
  },
  "catalogBrowseFailedTitle": "Couldn't load games",
  "@catalogBrowseFailedTitle": {
    "description": "Heading shown when the server could not be reached and this device has no saved games to show instead."
  },
  "catalogBrowseFailedBody": "Check your connection and try again.",
  "@catalogBrowseFailedBody": {
    "description": "Body under catalogBrowseFailedTitle."
  },
  "catalogBrowseMore": "Show more games",
  "@catalogBrowseMore": {
    "description": "Button at the end of the games list that loads the next page of games."
  },
  "catalogBrowseMoreLoading": "Loading more games…",
  "@catalogBrowseMoreLoading": {
    "description": "Replaces catalogBrowseMore while the next page of games is loading, and is announced."
  },
  "catalogBrowseMoreFailed": "Couldn't load more games.",
  "@catalogBrowseMoreFailed": {
    "description": "Shown at the end of the games list when the next page could not be loaded. The games already shown stay. Followed by a retry button."
  },
  "catalogRetry": "Try again",
  "@catalogRetry": {
    "description": "Button that asks the server again after a failure, on every screen of this feature."
  },
  "catalogRetrying": "Trying again…",
  "@catalogRetrying": {
    "description": "Replaces catalogRetry on the banner over games saved on this device while the server is being asked again, and is announced. The saved games stay shown meanwhile."
  },
  "catalogDeniedTitle": "You don't have access to this server's games",
  "@catalogDeniedTitle": {
    "description": "Heading shown instead of the games list or search results when the server refuses this user its games."
  },
  "catalogDeniedBody": "Ask an admin of this server if you need them, then try again.",
  "@catalogDeniedBody": {
    "description": "Body under catalogDeniedTitle. Followed by a retry button."
  },
  "catalogTitleWithSubtitle": "{title}: {subtitle}",
  "@catalogTitleWithSubtitle": {
    "description": "A game's name when the game also has a subtitle, for example 'Catan: Seafarers'. Reorder or change the punctuation as your language needs.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Catan"
      },
      "subtitle": {
        "type": "String",
        "example": "Seafarers"
      }
    }
  },
  "catalogDetailSeparator": " · ",
  "@catalogDetailSeparator": {
    "description": "Shown between the facts on a game's row, for example '1995 · 3–4 players · Expansion'. Keep or drop the surrounding spaces as your language's punctuation needs."
  },
  "catalogDetailSpokenSeparator": ", ",
  "@catalogDetailSpokenSeparator": {
    "description": "Joins the same facts when a screen reader reads a game's row aloud, in place of catalogDetailSeparator, whose symbol would be read out. It should sound like a short pause."
  },
  "catalogPlayerCount": "{count, plural, =1{1 player} other{{count} players}}",
  "@catalogPlayerCount": {
    "description": "A game played by exactly this many players.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "catalogPlayerRange": "{min}–{max} players",
  "@catalogPlayerRange": {
    "description": "A game played by between min and max players, as shown on screen.",
    "placeholders": {
      "min": {
        "type": "String",
        "example": "3"
      },
      "max": {
        "type": "String",
        "example": "4"
      }
    }
  },
  "catalogPlayerRangeSpoken": "{min} to {max} players",
  "@catalogPlayerRangeSpoken": {
    "description": "catalogPlayerRange as a screen reader reads it, without the dash.",
    "placeholders": {
      "min": {
        "type": "String",
        "example": "3"
      },
      "max": {
        "type": "String",
        "example": "4"
      }
    }
  },
  "catalogPlayersAtLeast": "{min}+ players",
  "@catalogPlayersAtLeast": {
    "description": "A game played by at least this many players, with no maximum known, as shown on screen.",
    "placeholders": {
      "min": {
        "type": "String",
        "example": "2"
      }
    }
  },
  "catalogPlayersAtLeastSpoken": "{min} or more players",
  "@catalogPlayersAtLeastSpoken": {
    "description": "catalogPlayersAtLeast as a screen reader reads it.",
    "placeholders": {
      "min": {
        "type": "String",
        "example": "2"
      }
    }
  },
  "catalogPlayersUpTo": "Up to {max} players",
  "@catalogPlayersUpTo": {
    "description": "A game played by at most this many players, with no minimum known.",
    "placeholders": {
      "max": {
        "type": "String",
        "example": "6"
      }
    }
  },
  "catalogContentTypeBaseGame": "Base game",
  "@catalogContentTypeBaseGame": {
    "description": "A complete game, as opposed to an expansion for one. A filter choice on the search screen and a fact on a game's detail."
  },
  "catalogContentTypeExpansion": "Expansion",
  "@catalogContentTypeExpansion": {
    "description": "Extra content that needs the base game to play."
  },
  "catalogContentTypeStandaloneExpansion": "Standalone expansion",
  "@catalogContentTypeStandaloneExpansion": {
    "description": "An expansion that can also be played on its own."
  },
  "catalogContentTypeExpandedEdition": "Expanded edition",
  "@catalogContentTypeExpandedEdition": {
    "description": "A game released again with its expansions included."
  },
  "catalogContentTypeAccessory": "Accessory",
  "@catalogContentTypeAccessory": {
    "description": "Something to play a game with that is not a game itself, such as card sleeves or an organizer."
  },
  "catalogContentTypeBundle": "Bundle",
  "@catalogContentTypeBundle": {
    "description": "Several games or expansions sold together."
  },
  "catalogContentTypeDlc": "DLC",
  "@catalogContentTypeDlc": {
    "description": "Downloadable content for a video game."
  },
  "catalogContentTypeMod": "Mod",
  "@catalogContentTypeMod": {
    "description": "A fan-made modification of a video game."
  },
  "catalogContentTypePort": "Port",
  "@catalogContentTypePort": {
    "description": "A game adapted to run on another platform."
  },
  "catalogContentTypeRemake": "Remake",
  "@catalogContentTypeRemake": {
    "description": "A game rebuilt from scratch, based on an earlier one."
  },
  "catalogContentTypeRemaster": "Remaster",
  "@catalogContentTypeRemaster": {
    "description": "An earlier game released again with improved graphics or sound."
  },
  "catalogPlatformTypeTabletop": "Tabletop",
  "@catalogPlatformTypeTabletop": {
    "description": "A kind of platform games are played on: a filter choice on the search screen, and a filter in use under the search field. Board, card and other games played at a table."
  },
  "catalogPlatformTypeConsole": "Console",
  "@catalogPlatformTypeConsole": {
    "description": "A kind of platform games are played on: a filter choice on the search screen, and a filter in use under the search field. Games for home video-game consoles."
  },
  "catalogPlatformTypePortable": "Portable",
  "@catalogPlatformTypePortable": {
    "description": "A kind of platform games are played on: a filter choice on the search screen, and a filter in use under the search field. Games for handheld game consoles."
  },
  "catalogPlatformTypePc": "PC",
  "@catalogPlatformTypePc": {
    "description": "A kind of platform games are played on: a filter choice on the search screen, and a filter in use under the search field. Games for personal computers."
  },
  "catalogPlatformTypeMobile": "Mobile",
  "@catalogPlatformTypeMobile": {
    "description": "A kind of platform games are played on: a filter choice on the search screen, and a filter in use under the search field. Games for phones and tablets."
  },
  "catalogPlatformTypeArcade": "Arcade",
  "@catalogPlatformTypeArcade": {
    "description": "A kind of platform games are played on: a filter choice on the search screen, and a filter in use under the search field. Arcade cabinet games."
  },
  "catalogPlatformTypeOther": "Other",
  "@catalogPlatformTypeOther": {
    "description": "A kind of platform games are played on: a filter choice on the search screen, and a filter in use under the search field. Any platform that is none of the others."
  },
  "catalogSearchTitle": "Search games",
  "@catalogSearchTitle": {
    "description": "Title of the search screen, and the tooltip of the button on the games list that opens it."
  },
  "catalogSearchFieldLabel": "Search by title",
  "@catalogSearchFieldLabel": {
    "description": "Label of the text field the user types a game's title into."
  },
  "catalogSearchFiltersButton": "{count, plural, =0{Filters} other{Filters ({count})}}",
  "@catalogSearchFiltersButton": {
    "description": "The button beside the search field that opens the filters. It counts the filters in use, one per chosen type and one per range.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "catalogSearchFiltersTitle": "Filters",
  "@catalogSearchFiltersTitle": {
    "description": "Heading of the sheet holding every search filter."
  },
  "catalogSearchFiltersClearAll": "Clear all",
  "@catalogSearchFiltersClearAll": {
    "description": "Button in the filter sheet that turns every filter off at once."
  },
  "catalogSearchFilterContentType": "Content type",
  "@catalogSearchFilterContentType": {
    "description": "Heading over the content-type filter choices, such as 'Base game' and 'Expansion'. With none chosen, every type is shown."
  },
  "catalogSearchFilterPlatformType": "Platform",
  "@catalogSearchFilterPlatformType": {
    "description": "Heading over the platform-type filter choices, such as 'Tabletop' and 'PC'. With none chosen, every platform is shown."
  },
  "catalogSearchFilterRemove": "Remove {filter}",
  "@catalogSearchFilterRemove": {
    "description": "Tooltip and screen-reader label of the remove button on a filter in use, shown under the search field.",
    "placeholders": {
      "filter": {
        "type": "String",
        "example": "Expansion"
      }
    }
  },
  "catalogSearchFilterYear": "Publish year",
  "@catalogSearchFilterYear": {
    "description": "Heading over the filter sheet's publish-year range."
  },
  "catalogSearchFilterPlayers": "Players",
  "@catalogSearchFilterPlayers": {
    "description": "Heading over the filter sheet's player-count range."
  },
  "catalogSearchFilterPlayTime": "Play time",
  "@catalogSearchFilterPlayTime": {
    "description": "Heading over the filter sheet's play-time range and its length bands."
  },
  "catalogSearchRangeFrom": "From",
  "@catalogSearchRangeFrom": {
    "description": "Label of the field for a filter range's lowest value: the earliest year, the fewest players or the shortest play time. It may be left empty."
  },
  "catalogSearchRangeTo": "To",
  "@catalogSearchRangeTo": {
    "description": "Label of the field for a filter range's highest value: the latest year, the most players or the longest play time. It may be left empty."
  },
  "catalogSearchYearHelper": "Use a minus sign for years BCE",
  "@catalogSearchYearHelper": {
    "description": "Help under the publish-year fields: a year before the common era is typed as a negative number, such as -3000."
  },
  "catalogSearchPlayersHelper": "Fill in one for an exact count",
  "@catalogSearchPlayersHelper": {
    "description": "Help under the player-count fields: filling in only From, or only To, finds games for exactly that many players."
  },
  "catalogSearchPlayTimeHelper": "In minutes",
  "@catalogSearchPlayTimeHelper": {
    "description": "Help under the play-time fields: the numbers are minutes."
  },
  "catalogSearchRangeReversed": "From can't be after To",
  "@catalogSearchRangeReversed": {
    "description": "Error on a filter range's To field when its From value is larger. Nothing is searched until it is fixed."
  },
  "catalogSearchRangeTooLow": "Must be at least {lowest}",
  "@catalogSearchRangeTooLow": {
    "description": "Error on a filter range's field when its value is below the lowest the search accepts, such as 0 players.",
    "placeholders": {
      "lowest": {
        "type": "int",
        "example": "1"
      }
    }
  },
  "catalogSearchRangeTooHigh": "Too large",
  "@catalogSearchRangeTooHigh": {
    "description": "Error on a filter range's field when its value is larger than the search accepts."
  },
  "catalogSearchYearNotApplied": "Publish year not applied. {problem}.",
  "@catalogSearchYearNotApplied": {
    "description": "A SnackBar after the filter sheet closes on a publish-year range it couldn't send, as when From is after To. The range is dropped, and the problem is the error its field would show.",
    "placeholders": {
      "problem": {
        "type": "String",
        "example": "From can't be after To"
      }
    }
  },
  "catalogSearchPlayersNotApplied": "Player count not applied. {problem}.",
  "@catalogSearchPlayersNotApplied": {
    "description": "A SnackBar after the filter sheet closes on a player-count range it couldn't send, as when From is after To. The range is dropped, and the problem is the error its field would show.",
    "placeholders": {
      "problem": {
        "type": "String",
        "example": "From can't be after To"
      }
    }
  },
  "catalogSearchPlayTimeNotApplied": "Play time not applied. {problem}.",
  "@catalogSearchPlayTimeNotApplied": {
    "description": "A SnackBar after the filter sheet closes on a play-time range it couldn't send, as when From is after To. The range is dropped, and the problem is the error its field would show.",
    "placeholders": {
      "problem": {
        "type": "String",
        "example": "From can't be after To"
      }
    }
  },
  "catalogSearchIncludeUnknownYear": "Include games with no year",
  "@catalogSearchIncludeUnknownYear": {
    "description": "Switch under the publish-year range. On, games with no known publish year are kept. It changes nothing until a year is filled in."
  },
  "catalogSearchIncludeUnknownPlayers": "Include games with no player count",
  "@catalogSearchIncludeUnknownPlayers": {
    "description": "Switch under the player-count range. On, games with no known player count are kept. It changes nothing until a count is filled in."
  },
  "catalogSearchIncludeUnknownPlayTime": "Include games with no play time",
  "@catalogSearchIncludeUnknownPlayTime": {
    "description": "Switch under the play-time range. On, games with no known play time are kept. It changes nothing until a time is filled in."
  },
  "catalogSearchFromYear": "From {year}",
  "@catalogSearchFromYear": {
    "description": "A publish-year filter in use with only its earliest year, shown as a chip under the search field.",
    "placeholders": {
      "year": {
        "type": "String",
        "example": "1990"
      }
    }
  },
  "catalogSearchUpToYear": "Up to {year}",
  "@catalogSearchUpToYear": {
    "description": "A publish-year filter in use with only its latest year, shown as a chip under the search field.",
    "placeholders": {
      "year": {
        "type": "String",
        "example": "2000"
      }
    }
  },
  "catalogSearchYearRange": "{from}–{to}",
  "@catalogSearchYearRange": {
    "description": "A publish-year filter in use with both years, shown as a chip under the search field. Either year may read as BCE.",
    "placeholders": {
      "from": {
        "type": "String",
        "example": "1990"
      },
      "to": {
        "type": "String",
        "example": "2000"
      }
    }
  },
  "catalogSearchYearRangeSpoken": "{from} to {to}",
  "@catalogSearchYearRangeSpoken": {
    "description": "catalogSearchYearRange as a screen reader reads it, without the dash.",
    "placeholders": {
      "from": {
        "type": "String",
        "example": "1990"
      },
      "to": {
        "type": "String",
        "example": "2000"
      }
    }
  },
  "catalogSearchOrNoYear": "{range} or no year",
  "@catalogSearchOrNoYear": {
    "description": "A publish year filter in use that also keeps games with no publish year, shown as a chip under the search field and read by a screen reader. The range is the chip's own label, such as 1990–2000.",
    "placeholders": {
      "range": {
        "type": "String",
        "example": "1990–2000"
      }
    }
  },
  "catalogSearchOrNoPlayerCount": "{range} or no player count",
  "@catalogSearchOrNoPlayerCount": {
    "description": "A player count filter in use that also keeps games with no player count, shown as a chip under the search field and read by a screen reader. The range is the chip's own label, such as 4 players.",
    "placeholders": {
      "range": {
        "type": "String",
        "example": "4 players"
      }
    }
  },
  "catalogSearchOrNoPlayTime": "{range} or no play time",
  "@catalogSearchOrNoPlayTime": {
    "description": "A play time filter in use that also keeps games with no play time, shown as a chip under the search field and read by a screen reader. The range is the chip's own label, such as Medium.",
    "placeholders": {
      "range": {
        "type": "String",
        "example": "Medium"
      }
    }
  },
  "catalogBandFiller": "Filler",
  "@catalogBandFiller": {
    "description": "A game-length band the play-time filter offers, by the server's name for it. Up to 15 minutes: ultra-quick games while waiting."
  },
  "catalogBandQuick": "Quick",
  "@catalogBandQuick": {
    "description": "A game-length band the play-time filter offers, by the server's name for it. 15 to 30 minutes: short and sweet."
  },
  "catalogBandShort": "Short",
  "@catalogBandShort": {
    "description": "A game-length band the play-time filter offers, by the server's name for it. 30 minutes to an hour: a standard game length."
  },
  "catalogBandMedium": "Medium",
  "@catalogBandMedium": {
    "description": "A game-length band the play-time filter offers, by the server's name for it. 1 to 2 hours: a solid gaming session."
  },
  "catalogBandLong": "Long",
  "@catalogBandLong": {
    "description": "A game-length band the play-time filter offers, by the server's name for it. 2 to 4 hours: a dedicated evening game."
  },
  "catalogBandEpic": "Epic",
  "@catalogBandEpic": {
    "description": "A game-length band the play-time filter offers, by the server's name for it. 4 to 8 hours: a major time commitment."
  },
  "catalogBandMarathon": "Marathon",
  "@catalogBandMarathon": {
    "description": "A game-length band the play-time filter offers, by the server's name for it. 8 hours or more: all-day or multi-session games."
  },
  "catalogBandLabel": "{name} ({range})",
  "@catalogBandLabel": {
    "description": "A game-length band's choice in the play-time filter: its name, then the play times it covers, such as \"Medium (1–2 hr)\".",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Medium"
      },
      "range": {
        "type": "String",
        "example": "1–2 hr"
      }
    }
  },
  "catalogSearchClear": "Clear search",
  "@catalogSearchClear": {
    "description": "Tooltip of the button that empties the search field."
  },
  "catalogSearchIdle": "Search this server and its data sources for a game.",
  "@catalogSearchIdle": {
    "description": "Shown on the search screen before anything is typed. A data source is another catalog of games the server can search, such as BoardGameGeek."
  },
  "catalogSearchLoading": "Searching… Data sources can take up to 15 seconds to answer.",
  "@catalogSearchLoading": {
    "description": "Announced and shown while a search runs. The server waits for each data source for up to 15 seconds."
  },
  "catalogSearchResultCount": "{count, plural, =0{No results} =1{1 result} other{{count} results}}",
  "@catalogSearchResultCount": {
    "description": "How many games a search found, shown above the results and announced when they arrive.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "catalogSearchNoResults": "No games match “{query}”.",
  "@catalogSearchNoResults": {
    "description": "Shown when a search found nothing.",
    "placeholders": {
      "query": {
        "type": "String",
        "example": "Catan"
      }
    }
  },
  "catalogSearchOnServer": "On this server",
  "@catalogSearchOnServer": {
    "description": "Heading over the search results the server already holds."
  },
  "catalogSearchOnDevice": "Saved on this device",
  "@catalogSearchOnDevice": {
    "description": "Heading over the search results when the server could not be reached, so the results are the games this device saved earlier."
  },
  "catalogSearchFromSources": "From data sources",
  "@catalogSearchFromSources": {
    "description": "Heading over the search results that other catalogs found, such as BoardGameGeek, which the server does not hold yet."
  },
  "catalogSearchFromCache": "Couldn't search the server, so this searched the games saved on this device.",
  "@catalogSearchFromCache": {
    "description": "Banner over the search results when the server's search failed, for any reason, so the results are the games this device saved earlier. Offers a retry."
  },
  "catalogSearchFailedTitle": "Couldn't search",
  "@catalogSearchFailedTitle": {
    "description": "Heading shown when the search could not run and this device had nothing saved to search instead."
  },
  "catalogSearchFailedBody": "Check your connection and try again.",
  "@catalogSearchFailedBody": {
    "description": "Body under catalogSearchFailedTitle."
  },
  "catalogSearchMissingNamed": "No answer from {sources}, so some results may be missing.",
  "@catalogSearchMissingNamed": {
    "description": "A quiet note under the search results naming the data sources that did not answer in time, so the user does not read their absence as 'nothing found'.",
    "placeholders": {
      "sources": {
        "type": "String",
        "example": "BoardGameGeek, Steam"
      }
    }
  },
  "catalogSearchMissingUnnamed": "{count, plural, =1{A data source didn't answer} other{{count} data sources didn't answer}}, so some results may be missing.",
  "@catalogSearchMissingUnnamed": {
    "description": "catalogSearchMissingNamed for a user who may not see the data sources' names.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "catalogSearchSourceSeparator": ", ",
  "@catalogSearchSourceSeparator": {
    "description": "Joins data source names in catalogSearchMissingNamed and the catalogSearchUnfilterableNamed notes."
  },
  "catalogSearchUnfilterableNamedPlayers": "{sources} can't filter by player count, so {count, plural, =1{its games aren't} other{their games aren't}} shown. Include games with no player count to see them.",
  "@catalogSearchUnfilterableNamedPlayers": {
    "description": "A quiet note under the search results naming the data sources the search skipped because the search names a player count and they can't filter by it. It says how to see their games: the filter's switch that keeps games with no value. Only shown to a user who may see the data sources' names.",
    "placeholders": {
      "sources": {
        "type": "String",
        "example": "BoardGameGeek, IGDB"
      },
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "catalogSearchUnfilterableNamedTime": "{sources} can't filter by play time, so {count, plural, =1{its games aren't} other{their games aren't}} shown. Include games with no play time to see them.",
  "@catalogSearchUnfilterableNamedTime": {
    "description": "A quiet note under the search results naming the data sources the search skipped because the search names a play time and they can't filter by it. It says how to see their games: the filter's switch that keeps games with no value. Only shown to a user who may see the data sources' names.",
    "placeholders": {
      "sources": {
        "type": "String",
        "example": "BoardGameGeek, IGDB"
      },
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "catalogSearchUnfilterableNamedBoth": "{sources} can't filter by player count, play time or both, so {count, plural, =1{its games aren't} other{their games aren't}} shown. Include games with no player count and games with no play time to see them.",
  "@catalogSearchUnfilterableNamedBoth": {
    "description": "A quiet note under the search results naming the data sources the search skipped because the search names both a player count and a play time. The server doesn't say which of the two skipped each source, so the note says it may be either or both, and asks for both switches that keep games with no value: that always brings their games back. Only shown to a user who may see the data sources' names.",
    "placeholders": {
      "sources": {
        "type": "String",
        "example": "BoardGameGeek, IGDB"
      },
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "catalogSearchUnfilterableUnnamedPlayers": "{count, plural, =1{A data source can't filter by player count, so its games aren't shown.} other{{count} data sources can't filter by player count, so their games aren't shown.}} Include games with no player count to see them.",
  "@catalogSearchUnfilterableUnnamedPlayers": {
    "description": "catalogSearchUnfilterableNamedPlayers for a user who may not see the data sources' names.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "catalogSearchUnfilterableUnnamedTime": "{count, plural, =1{A data source can't filter by play time, so its games aren't shown.} other{{count} data sources can't filter by play time, so their games aren't shown.}} Include games with no play time to see them.",
  "@catalogSearchUnfilterableUnnamedTime": {
    "description": "catalogSearchUnfilterableNamedTime for a user who may not see the data sources' names.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
