{
  "@@locale": "en",
  "catalogBrowseTitle": "Games",
  "@catalogBrowseTitle": {
    "description": "Title of the screen listing every game on the server, and the label of the drawer entry that opens it."
  },
  "catalogBrowseLoading": "Loading games…",
  "@catalogBrowseLoading": {
    "description": "Announced and shown while the first page of the server's games is being fetched."
  },
  "catalogBrowseEmpty": "There are no games on this server yet.",
  "@catalogBrowseEmpty": {
    "description": "Shown when the server answered and has no games at all."
  },
  "catalogBrowseFromCache": "Couldn't load games from the server. These are the games saved on this device.",
  "@catalogBrowseFromCache": {
    "description": "Banner over the games list when the server's list could not be loaded, for any reason, so the list shows the games this device saved earlier instead. Offers a retry. Deliberately names no cause."
  },
  "catalogBrowseFailedTitle": "Couldn't load games",
  "@catalogBrowseFailedTitle": {
    "description": "Heading shown when the server could not be reached and this device has no saved games to show instead."
  },
  "catalogBrowseFailedBody": "Check your connection and try again.",
  "@catalogBrowseFailedBody": {
    "description": "Body under catalogBrowseFailedTitle."
  },
  "catalogExpansionOf": "{title}, expansion for {baseGame}",
  "@catalogExpansionOf": {
    "description": "What a screen reader says for a game's row listed under its base game: the expansion's title, then the base game it belongs to.",
    "placeholders": {
      "title": {"type": "String", "example": "Seafarers"},
      "baseGame": {"type": "String", "example": "Catan"}
    }
  },
  "catalogBaseGameMissing": "Base game not on this server",
  "@catalogBaseGameMissing": {
    "description": "A note on an expansion's row in the games list when its base game is not on the server. Shown and spoken."
  },
  "catalogBaseGameNotSaved": "Base game not saved on this device",
  "@catalogBaseGameNotSaved": {
    "description": "Replaces catalogBaseGameMissing, on a row or a cover, while the games list shows the games saved on the device, offline: the server lists the expansion's base game, but it was never saved here. Shown and spoken."
  },
  "catalogExpansionsBadge": "{title} expansions, {count}",
  "@catalogExpansionsBadge": {
    "description": "What a screen reader says for the badge on a base game's cover in the games grid, which counts the game's expansions and shows or hides them under the cover. The badge also says whether they are shown, so this doesn't. {title} is the base game's title, with its subtitle where it has one; {count} is how many expansions it has, at least one.",
    "placeholders": {
      "title": {"type": "String", "example": "Catan"},
      "count": {"type": "int", "example": "2"}
    }
  },
  "catalogShowExpansions": "Show expansions",
  "@catalogShowExpansions": {
    "description": "An action a screen reader offers on a base game's cover in the games grid while its expansions are hidden: it shows the expansions' covers in a row under the cover, as the cover's badge does."
  },
  "catalogHideExpansions": "Hide expansions",
  "@catalogHideExpansions": {
    "description": "An action a screen reader offers on a base game's cover in the games grid while its expansions are shown under it: it hides them again. Replaces catalogShowExpansions."
  },
  "catalogExpansionsStrip": "{title} expansions",
  "@catalogExpansionsStrip": {
    "description": "Heading of the row of expansion covers shown under a base game's cover in the games grid. Shown, and spoken as a heading. {title} is the base game's title, with its subtitle where it has one.",
    "placeholders": {
      "title": {"type": "String", "example": "Catan"}
    }
  },
  "catalogBrowseMore": "Show more games",
  "@catalogBrowseMore": {
    "description": "Button at the end of the games list that loads the next page of games."
  },
  "catalogBrowseMoreLoading": "Loading more games…",
  "@catalogBrowseMoreLoading": {
    "description": "Replaces catalogBrowseMore while the next page of games is loading, and is announced."
  },
  "catalogBrowseMoreFailed": "Couldn't load more games.",
  "@catalogBrowseMoreFailed": {
    "description": "Shown at the end of the games list when the next page could not be loaded. The games already shown stay. Followed by a retry button."
  },
  "catalogBrowseSort": "Sort games",
  "@catalogBrowseSort": {
    "description": "Tooltip and spoken label of the button on the games list that opens the menu of orders to list the games in."
  },
  "catalogLayoutList": "List",
  "@catalogLayoutList": {
    "description": "Tooltip and spoken name of the segment on the games list's layout toggle that shows the games as rows, one per line."
  },
  "catalogLayoutThumbnails": "Thumbnails",
  "@catalogLayoutThumbnails": {
    "description": "Tooltip and spoken name of the segment on the games list's layout toggle that shows the games as a grid of covers, each opening a quick look."
  },
  "catalogBrowseSortTitle": "Title",
  "@catalogBrowseSortTitle": {
    "description": "Entry of the games list's sort menu: the games in alphabetical order of their titles."
  },
  "catalogBrowseSortNewest": "Newest first",
  "@catalogBrowseSortNewest": {
    "description": "Entry of the games list's sort menu: the games most recently added to the server first."
  },
  "catalogNewestHeading": "Recently added",
  "@catalogNewestHeading": {
    "description": "Heading of the home page's row of the games most recently added to the server."
  },
  "catalogNewestSeeAll": "See all",
  "@catalogNewestSeeAll": {
    "description": "Link in the header of the home page's recently added row that opens the full list of games, newest first. Spoken as catalogNewestSeeAllSpoken, which says what it opens."
  },
  "catalogNewestSeeAllSpoken": "See all recently added games",
  "@catalogNewestSeeAllSpoken": {
    "description": "Spoken label of the catalogNewestSeeAll link, which alone doesn't say of what."
  },
  "catalogNewestFailed": "Couldn't load recently added games.",
  "@catalogNewestFailed": {
    "description": "Shown and announced in the home page's recently added row when the server's games could not be loaded and none are saved on this device. Followed by a catalogRetry button."
  },
  "catalogEmptyServerAdmin": "No games here yet. Connect a DataGateway to bring them in.",
  "@catalogEmptyServerAdmin": {
    "description": "Shown and announced in a card on the home page, in the place of the recently added row, when the server has no games, to someone who can connect a DataGateway. Followed by a catalogEmptyServerAdminAction button."
  },
  "catalogEmptyServerAdminAction": "Go to DataGateways",
  "@catalogEmptyServerAdminAction": {
    "description": "Button on the catalogEmptyServerAdmin card that opens the list of the server's DataGateways, where one is connected."
  },
  "catalogEmptyServer": "No games yet — check back soon.",
  "@catalogEmptyServer": {
    "description": "Shown and announced on the home page, in the place of the recently added row, when the server has no games, to someone who can't connect a DataGateway. Also what stands there until it is known whether they can."
  },
  "catalogShelfPrevious": "Previous games",
  "@catalogShelfPrevious": {
    "description": "Tooltip and spoken label of the button on a row of games that scrolls the row back to the games before the ones in view. Used on the home page's rows of games, and on the row of a base game's expansion covers shown under its cover in the games grid."
  },
  "catalogShelfNext": "Next games",
  "@catalogShelfNext": {
    "description": "Tooltip and spoken label of the button on a row of games that scrolls the row on to the games after the ones in view. Used on the home page's rows of games, and on the row of a base game's expansion covers shown under its cover in the games grid."
  },
  "catalogSomethingToPlayHeading": "Something to play",
  "@catalogSomethingToPlayHeading": {
    "description": "Heading of the row on the home page holding a random pick of games: from the households the user is in and the user's own collection, or the server's games when those have none."
  },
  "catalogReshuffle": "Reshuffle",
  "@catalogReshuffle": {
    "description": "Button on the home page's catalogSomethingToPlayHeading row that replaces its games with a new random pick."
  },
  "catalogReshuffled": "New games to play",
  "@catalogReshuffled": {
    "description": "Announced to screen readers, and never shown, when the home page's catalogSomethingToPlayHeading row has a new random pick of games."
  },
  "catalogRetry": "Try again",
  "@catalogRetry": {
    "description": "Button that asks the server again after a failure, on every screen of this feature."
  },
  "catalogRetrying": "Trying again…",
  "@catalogRetrying": {
    "description": "Replaces catalogRetry on a retry button while the server is being asked again, and is announced. On the banner over games saved on this device, and after catalogNewestFailed on the home page, whatever was shown stays shown meanwhile."
  },
  "catalogDeniedTitle": "You don't have access to this server's games",
  "@catalogDeniedTitle": {
    "description": "Heading shown instead of the games list or search results when the server refuses this user its games."
  },
  "catalogDeniedBody": "Ask an admin of this server if you need them, then try again.",
  "@catalogDeniedBody": {
    "description": "Body under catalogDeniedTitle. Followed by a retry button."
  },
  "catalogTitleWithSubtitle": "{title}: {subtitle}",
  "@catalogTitleWithSubtitle": {
    "description": "A game's name when the game also has a subtitle, for example 'Catan: Seafarers'. Reorder or change the punctuation as your language needs.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Catan"
      },
      "subtitle": {
        "type": "String",
        "example": "Seafarers"
      }
    }
  },
  "catalogDetailSeparator": " · ",
  "@catalogDetailSeparator": {
    "description": "Shown between the facts on a game's row, for example '1995 · 3–4 players · Expansion'. Keep or drop the surrounding spaces as your language's punctuation needs."
  },
  "catalogDetailSpokenSeparator": ", ",
  "@catalogDetailSpokenSeparator": {
    "description": "Joins the same facts when a screen reader reads a game's row aloud, in place of catalogDetailSeparator, whose symbol would be read out. It should sound like a short pause."
  },
  "catalogSearchTitle": "Search games",
  "@catalogSearchTitle": {
    "description": "Title of the search screen, and the tooltip of the button on the games list that opens it."
  },
  "catalogSearchFieldLabel": "Search by title",
  "@catalogSearchFieldLabel": {
    "description": "Label of the text field the user types a game's title into."
  },
  "catalogSearchClear": "Clear search",
  "@catalogSearchClear": {
    "description": "Tooltip of the button that empties the search field."
  },
  "catalogSearchIdle": "Search this server and its data sources for a game.",
  "@catalogSearchIdle": {
    "description": "Shown on the search screen before anything is typed. A data source is another catalog of games the server can search, such as BoardGameGeek."
  },
  "catalogSearchLoading": "Searching… Data sources can take up to 15 seconds to answer.",
  "@catalogSearchLoading": {
    "description": "Announced and shown while a search runs. The server waits for each data source for up to 15 seconds."
  },
  "catalogSearchResultCount": "{count, plural, =0{No results} =1{1 result} other{{count} results}}",
  "@catalogSearchResultCount": {
    "description": "How many games a search found, shown above the results and announced when they arrive.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "catalogSearchNoResults": "No games match “{query}”.",
  "@catalogSearchNoResults": {
    "description": "Shown when a search found nothing.",
    "placeholders": {
      "query": {
        "type": "String",
        "example": "Catan"
      }
    }
  },
  "catalogSearchOnServer": "On this server",
  "@catalogSearchOnServer": {
    "description": "Heading over the search results the server already holds."
  },
  "catalogSearchOnDevice": "Saved on this device",
  "@catalogSearchOnDevice": {
    "description": "Heading over the search results when the server could not be reached, so the results are the games this device saved earlier."
  },
  "catalogSearchFromSources": "From data sources",
  "@catalogSearchFromSources": {
    "description": "Heading over the search results that other catalogs found, such as BoardGameGeek, which the server does not hold yet."
  },
  "catalogSearchFromCache": "Couldn't search the server, so this searched the games saved on this device.",
  "@catalogSearchFromCache": {
    "description": "Banner over the search results when the server's search failed, for any reason, so the results are the games this device saved earlier. Offers a retry."
  },
  "catalogSearchFailedTitle": "Couldn't search",
  "@catalogSearchFailedTitle": {
    "description": "Heading shown when the search could not run and this device had nothing saved to search instead."
  },
  "catalogSearchFailedBody": "Check your connection and try again.",
  "@catalogSearchFailedBody": {
    "description": "Body under catalogSearchFailedTitle."
  },
  "catalogSearchMissingNamed": "No answer from {sources}, so some results may be missing.",
  "@catalogSearchMissingNamed": {
    "description": "A quiet note under the search results naming the data sources that did not answer in time, so the user does not read their absence as 'nothing found'.",
    "placeholders": {
      "sources": {
        "type": "String",
        "example": "BoardGameGeek, Steam"
      }
    }
  },
  "catalogSearchMissingUnnamed": "{count, plural, =1{A data source didn't answer} other{{count} data sources didn't answer}}, so some results may be missing.",
  "@catalogSearchMissingUnnamed": {
    "description": "catalogSearchMissingNamed for a user who may not see the data sources' names.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "catalogSearchSourceSeparator": ", ",
  "@catalogSearchSourceSeparator": {
    "description": "Joins data source names in catalogSearchMissingNamed and the catalogSearchUnfilterableNamed notes."
  },
  "catalogSearchUnfilterableNamedPlayers": "{sources} can't filter by player count, so {count, plural, =1{its games aren't} other{their games aren't}} shown. Include games with no player count to see them.",
  "@catalogSearchUnfilterableNamedPlayers": {
    "description": "A quiet note under the search results naming the data sources the search skipped because the search names a player count and they can't filter by it. It says how to see their games: the filter's switch that keeps games with no value. Only shown to a user who may see the data sources' names.",
    "placeholders": {
      "sources": {
        "type": "String",
        "example": "BoardGameGeek, IGDB"
      },
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "catalogSearchUnfilterableNamedTime": "{sources} can't filter by play time, so {count, plural, =1{its games aren't} other{their games aren't}} shown. Include games with no play time to see them.",
  "@catalogSearchUnfilterableNamedTime": {
    "description": "A quiet note under the search results naming the data sources the search skipped because the search names a play time and they can't filter by it. It says how to see their games: the filter's switch that keeps games with no value. Only shown to a user who may see the data sources' names.",
    "placeholders": {
      "sources": {
        "type": "String",
        "example": "BoardGameGeek, IGDB"
      },
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "catalogSearchUnfilterableNamedBoth": "{sources} can't filter by player count, play time or both, so {count, plural, =1{its games aren't} other{their games aren't}} shown. Include games with no player count and games with no play time to see them.",
  "@catalogSearchUnfilterableNamedBoth": {
    "description": "A quiet note under the search results naming the data sources the search skipped because the search names both a player count and a play time. The server doesn't say which of the two skipped each source, so the note says it may be either or both, and asks for both switches that keep games with no value: that always brings their games back. Only shown to a user who may see the data sources' names.",
    "placeholders": {
      "sources": {
        "type": "String",
        "example": "BoardGameGeek, IGDB"
      },
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "catalogSearchUnfilterableUnnamedPlayers": "{count, plural, =1{A data source can't filter by player count, so its games aren't shown.} other{{count} data sources can't filter by player count, so their games aren't shown.}} Include games with no player count to see them.",
  "@catalogSearchUnfilterableUnnamedPlayers": {
    "description": "catalogSearchUnfilterableNamedPlayers for a user who may not see the data sources' names.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "catalogSearchUnfilterableUnnamedTime": "{count, plural, =1{A data source can't filter by play time, so its games aren't shown.} other{{count} data sources can't filter by play time, so their games aren't shown.}} Include games with no play time to see them.",
  "@catalogSearchUnfilterableUnnamedTime": {
    "description": "catalogSearchUnfilterableNamedTime for a user who may not see the data sources' names.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "catalogSearchUnfilterableUnnamedBoth": "{count, plural, =1{A data source can't filter by player count, play time or both, so its games aren't shown.} other{{count} data sources can't filter by player count, play time or both, so their games aren't shown.}} Include games with no player count and games with no play time to see them.",
  "@catalogSearchUnfilterableUnnamedBoth": {
    "description": "catalogSearchUnfilterableNamedBoth for a user who may not see the data sources' names.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "catalogSearchPlatformOffline": "Platform type can't be checked on this device, so nothing here matches. Clear it to search this device.",
  "@catalogSearchPlatformOffline": {
    "description": "Shown under the note that the search failed and these are games saved on this device, when the search is narrowed by platform type. The device doesn't know games' platform types, so nothing can match until that filter is cleared."
  },
  "catalogDetailTitle": "Game",
  "@catalogDetailTitle": {
    "description": "Title of a game's screen until the game has loaded, and when it cannot be shown."
  },
  "catalogDetailLoading": "Loading game…",
  "@catalogDetailLoading": {
    "description": "Announced and shown while a game is being fetched."
  },
  "catalogDetailUnavailableTitle": "This game isn't available",
  "@catalogDetailUnavailableTitle": {
    "description": "Heading shown when the server has no such game, or the user may not see it. Deliberately the same either way."
  },
  "catalogDetailUnavailableBody": "It may have been removed, or it may not be shared with you.",
  "@catalogDetailUnavailableBody": {
    "description": "Body under catalogDetailUnavailableTitle."
  },
  "catalogDetailFailedTitle": "Couldn't load this game",
  "@catalogDetailFailedTitle": {
    "description": "Heading shown when the server could not be reached and this device has not saved the game."
  },
  "catalogDetailFailedBody": "Check your connection and try again.",
  "@catalogDetailFailedBody": {
    "description": "Body under catalogDetailFailedTitle."
  },
  "catalogDetailFromCache": "Couldn't load this game from the server. This is the copy saved on this device.",
  "@catalogDetailFromCache": {
    "description": "Banner on a game's screen when the server's copy could not be loaded, for any reason, so it shows the game as this device saved it earlier. Offers a retry."
  },
  "catalogDetailPublished": "Published {year}",
  "@catalogDetailPublished": {
    "description": "The year a game was first published.",
    "placeholders": {
      "year": {
        "type": "String",
        "example": "1995"
      }
    }
  },
  "catalogDetailMinAge": "Ages {age}+",
  "@catalogDetailMinAge": {
    "description": "The youngest age a game is recommended for, as shown on screen.",
    "placeholders": {
      "age": {
        "type": "String",
        "example": "10"
      }
    }
  },
  "catalogDetailMinAgeSpoken": "Ages {age} and up",
  "@catalogDetailMinAgeSpoken": {
    "description": "catalogDetailMinAge as a screen reader reads it.",
    "placeholders": {
      "age": {
        "type": "String",
        "example": "10"
      }
    }
  },
  "catalogDetailDescription": "About this game",
  "@catalogDetailDescription": {
    "description": "Heading over a game's description."
  },
  "catalogDescriptionMore": "More",
  "@catalogDescriptionMore": {
    "description": "Button under a game's description, shown cut to its first few lines, that shows the whole description in place. A screen reader also hears that it is collapsed."
  },
  "catalogDescriptionLess": "Less",
  "@catalogDescriptionLess": {
    "description": "Button under a game's whole description, after catalogDescriptionMore was pressed, that cuts it back to its first few lines. A screen reader also hears that it is expanded."
  },
  "catalogQuickLookViewDetails": "View full details",
  "@catalogQuickLookViewDetails": {
    "description": "Button in a game's quick look, the pop-up a tapped cover opens over the page, that opens the game's own page with everything about it."
  },
  "catalogQuickLookPartial": "Some details couldn't be loaded.",
  "@catalogQuickLookPartial": {
    "description": "Banner in a game's quick look when the server's copy of the game could not be loaded, for any reason. What the list already knew about the game stays shown, or the copy saved on this device. Names no cause. Beside it, catalogRetry asks the server again."
  },
  "catalogDetailAvailableOn": "Available on",
  "@catalogDetailAvailableOn": {
    "description": "Heading over the list of platforms a game can be played on, such as Tabletop or Steam."
  },
  "catalogDetailAddToCollection": "Add to collection",
  "@catalogDetailAddToCollection": {
    "description": "Button under a game's platforms that opens a form to add the game to the user's collection, on a platform chosen in the form. Not shown once the user owns the game on every platform, as both a physical and a digital copy."
  },
  "catalogDetailPlatformOwnedSpoken": "{platform}, in your collection, opens your copy",
  "@catalogDetailPlatformOwnedSpoken": {
    "description": "What a screen reader says for a platform the user owns the game on, in the list of platforms on a game's page. Pressing it opens the user's copy, or a choice of copies when they own it there as both a physical and a digital copy. Shown on screen as the platform's name with a check mark.",
    "placeholders": {
      "platform": {
        "type": "String",
        "example": "Tabletop"
      }
    }
  },
  "catalogDetailPlatformNotOwnedSpoken": "{platform}, not in your collection, add",
  "@catalogDetailPlatformNotOwnedSpoken": {
    "description": "What a screen reader says for a platform the user does not own the game on, in the list of platforms on a game's page. Pressing it opens a form to add the game to the user's collection on that platform. Shown on screen as the platform's name alone.",
    "placeholders": {
      "platform": {
        "type": "String",
        "example": "Android"
      }
    }
  },
  "catalogDetailOwnedLegend": "In your collection",
  "@catalogDetailOwnedLegend": {
    "description": "A legend under a game's platforms, shown when the user owns the game on at least one of them. A check mark is drawn as an icon before it: the same mark drawn on each platform the user owns the game on, so the legend says what that mark means. The icon is not part of this text."
  },
  "catalogImportStarting": "Sending the import to the server…",
  "@catalogImportStarting": {
    "description": "Shown and announced in the import dialog while the request to import a game from a data source is on its way to the server. The dialog's title is the game's name."
  },
  "catalogImportQueued": "Waiting for the server to start the import…",
  "@catalogImportQueued": {
    "description": "Shown and announced once the server has accepted a game's import and before it starts importing."
  },
  "catalogImportRunning": "Importing from the data source…",
  "@catalogImportRunning": {
    "description": "Shown and announced while the server imports the game from the data source (an external catalog such as BoardGameGeek)."
  },
  "catalogImportStillRunning": "This is taking longer than usual. The server is still importing it, so you can check again, or close this and search for it later.",
  "@catalogImportStillRunning": {
    "description": "Shown when an import has run for 90 seconds without finishing. Not a failure: the server keeps importing the game. Followed by the catalogImportCheckAgain and catalogImportClose buttons."
  },
  "catalogImportFailedNotOnDataGateway": "The data source no longer has this game.",
  "@catalogImportFailedNotOnDataGateway": {
    "description": "Shown when an import failed because the data source no longer has the game. Trying again can't help, so no retry is offered."
  },
  "catalogImportFailedDataGateway": "The data source didn't answer. Try again later.",
  "@catalogImportFailedDataGateway": {
    "description": "Shown when an import failed because the data source didn't answer the server."
  },
  "catalogImportFailedServer": "The server couldn't import this game.",
  "@catalogImportFailedServer": {
    "description": "Shown when the server failed to import the game, or answered in a way the app couldn't follow. Deliberately names no cause."
  },
  "catalogImportFailedCancelled": "The import was cancelled.",
  "@catalogImportFailedCancelled": {
    "description": "Shown when the import was cancelled on the server."
  },
  "catalogImportFailedForbidden": "You don't have permission to import games on this server.",
  "@catalogImportFailedForbidden": {
    "description": "Shown when the server refused the import because this user may not import games there. No retry is offered."
  },
  "catalogImportFailedUnreachable": "Couldn't reach the server. Check your connection and try again.",
  "@catalogImportFailedUnreachable": {
    "description": "Shown when the request to start the import got no answer from the server. Followed by the catalogImportTryAgain button."
  },
  "catalogImportCheckAgain": "Check again",
  "@catalogImportCheckAgain": {
    "description": "Button under catalogImportStillRunning that asks the server about the same import again. It doesn't start another import."
  },
  "catalogImportTryAgain": "Try again",
  "@catalogImportTryAgain": {
    "description": "Button in the import dialog, after a failure, that starts the import again."
  },
  "catalogImportClose": "Close",
  "@catalogImportClose": {
    "description": "Button that closes the import dialog. The server still finishes an import it has started."
  },
  "catalogImageAlt": "Image: {alt}",
  "@catalogImageAlt": {
    "description": "Stands in for a picture in a game's description that cannot be shown, giving its description.",
    "placeholders": {
      "alt": {
        "type": "String",
        "example": "The game's box"
      }
    }
  }
}
