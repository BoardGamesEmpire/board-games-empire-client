{
  "@@locale": "en",
  "dataGatewayListTitle": "Data gateways",
  "@dataGatewayListTitle": {
    "description": "Title of the admin screen listing the server's data gateways. A data gateway is the server's connection to an outside source of game data, such as BoardGameGeek."
  },
  "dataGatewayListLoading": "Loading data gateways…",
  "@dataGatewayListLoading": {
    "description": "Announced and shown while the list of data gateways is being read from the server."
  },
  "dataGatewayListEmptyTitle": "No data gateways yet",
  "@dataGatewayListEmptyTitle": {
    "description": "Heading of the empty state shown when the server has no data gateways."
  },
  "dataGatewayListEmptyBody": "A data gateway connects this server to a source of game data, such as BoardGameGeek.",
  "@dataGatewayListEmptyBody": {
    "description": "Body of the empty state shown when the server has no data gateways. Explains what one is."
  },
  "dataGatewayListErrorTitle": "We couldn't load the data gateways",
  "@dataGatewayListErrorTitle": {
    "description": "Heading shown when the list of data gateways could not be read, for a reason other than the user's role: the server was unreachable, or it answered with an error."
  },
  "dataGatewayListErrorBody": "Check your connection, then try again.",
  "@dataGatewayListErrorBody": {
    "description": "Body under the could-not-load heading, on the data gateway list and on the edit form when the data gateway to edit could not be read."
  },
  "dataGatewayRetry": "Try again",
  "@dataGatewayRetry": {
    "description": "Button that reads from the server again what failed to load: the data gateway list, the data gateway being edited, the data gateway on its own screen, the language names to review on that screen, or the languages in the language picker. Under the language names and in the picker it also tries a next page again."
  },
  "dataGatewayDeniedTitle": "You don't have access to data gateways",
  "@dataGatewayDeniedTitle": {
    "description": "Heading shown when the server refuses to show data gateways to the signed-in user, because of their role on the server. Also shown in place of the language names to review on a data gateway's own screen, when the server refuses those."
  },
  "dataGatewayDeniedBody": "Ask an admin of this server if you need to manage them.",
  "@dataGatewayDeniedBody": {
    "description": "Body under the access-denied heading on the data gateway screens, and in place of the language names to review."
  },
  "dataGatewayEnabled": "Enabled",
  "@dataGatewayEnabled": {
    "description": "Status on a data gateway row and on its own screen: the server uses this data gateway. It does not say whether the server is connected to it right now; the server does not record that."
  },
  "dataGatewayDisabled": "Disabled",
  "@dataGatewayDisabled": {
    "description": "Status on a data gateway row and on its own screen: the server does not use this data gateway. An admin turned it off, or the server turned it off after repeated connection failures."
  },
  "dataGatewayStatusWaiting": "Not in use yet: waiting for its first interview",
  "@dataGatewayStatusWaiting": {
    "description": "Status line under the Enabled status, on the row and own screen of a data gateway that has never been interviewed and has no failure to report. The server interviews a data gateway to learn what it can do, and does not use it until one interview has succeeded. Nothing has gone wrong yet; the interview is still to come."
  },
  "dataGatewayStatusNotInUse": "Not in use: {reason}",
  "@dataGatewayStatusNotInUse": {
    "description": "Status line under the Enabled status, on the row and own screen of a data gateway that no interview has succeeded for, and whose latest interview failed. The server does not use it. {reason} is a short phrase that follows the colon, such as it didn't answer.",
    "placeholders": {
      "reason": {
        "type": "String",
        "example": "it didn't answer"
      }
    }
  },
  "dataGatewayStatusLastFailed": "Last interview failed: {reason}",
  "@dataGatewayStatusLastFailed": {
    "description": "Status line under the Enabled status, on the row and own screen of a data gateway that an earlier interview succeeded for, and whose latest interview failed. The server keeps using what the earlier interview found. {reason} is a short phrase that follows the colon, such as it didn't answer.",
    "placeholders": {
      "reason": {
        "type": "String",
        "example": "it didn't answer"
      }
    }
  },
  "dataGatewayStatusInUse": "In use",
  "@dataGatewayStatusInUse": {
    "description": "Status line under the Enabled status, on the row and own screen of a data gateway that an interview succeeded for and no later one has failed: the server uses it. It does not say whether the server is connected right now; the server does not record that."
  },
  "dataGatewayInterviewFailurePingFailed": "it didn't answer",
  "@dataGatewayInterviewFailurePingFailed": {
    "description": "Why an interview of a data gateway failed, said after a colon in a sentence such as Not in use: it didn't answer. Keep it a short phrase that starts in lower case, with no full stop. The interview's first check, that the data gateway is there at all, went unanswered."
  },
  "dataGatewayInterviewFailureDescribeUnsupported": "it can't describe itself, so it may need updating",
  "@dataGatewayInterviewFailureDescribeUnsupported": {
    "description": "Why an interview of a data gateway failed, said after a colon in a sentence such as Not in use: it can't describe itself. Keep it a short phrase that starts in lower case, with no full stop. The data gateway does not implement the call that asks what it can do, which an older version of it would not."
  },
  "dataGatewayInterviewFailureDescribeFailed": "it couldn't describe itself",
  "@dataGatewayInterviewFailureDescribeFailed": {
    "description": "Why an interview of a data gateway failed, said after a colon in a sentence such as Not in use: it couldn't describe itself. Keep it a short phrase that starts in lower case, with no full stop. The call that asks the data gateway what it can do failed in some other way."
  },
  "dataGatewayInterviewFailureUnknown": "something went wrong",
  "@dataGatewayInterviewFailureUnknown": {
    "description": "Why an interview of a data gateway failed, said after a colon in a sentence such as Not in use: something went wrong. Keep it a short phrase that starts in lower case, with no full stop. Used when the server gives a reason this app does not know."
  },
  "dataGatewayAdd": "Add data gateway",
  "@dataGatewayAdd": {
    "description": "Button that opens the form to add a data gateway, and the title of that form."
  },
