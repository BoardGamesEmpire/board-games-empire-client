  "authContinueWith": "Continue with {provider}",
  "@authContinueWith": {
    "description": "OIDC button label",
    "placeholders": {
      "provider": {
        "type": "String"
      }
    }
  },
  "authContinueWithInProgress": "Waiting for {provider}…",
  "@authContinueWithInProgress": {
    "description": "Label of a sign-in provider's button while that provider's sign-in is open in the browser and the app is waiting for it to finish. Also the button's screen-reader name, so it says why pressing the button does nothing meanwhile. {provider} is the provider's display name, as the server gives it.",
    "placeholders": {
      "provider": {
        "type": "String",
        "example": "Authentik"
      }
    }
  },
  "authContinueWithUnavailable": "Continue with {provider} (not available on this device yet)",
  "@authContinueWithUnavailable": {
    "description": "Label of a sign-in provider's button on a device that can't sign in through a provider yet (Windows and Linux). The button is disabled, and this label is the only place the reason is given. 'Yet' because support is planned. {provider} is the provider's display name, as the server gives it.",
    "placeholders": {
      "provider": {
        "type": "String",
        "example": "Authentik"
      }
    }
  },
  "authProviderAddressMismatch": "Sign-in providers only work when this server is reached at {address}.",
  "@authProviderAddressMismatch": {
    "description": "Note under the sign-in provider buttons, which are disabled, when this server was added under a different address from the one it reports as its own. The provider would send the user back to that other address, so provider sign-in can't work here; email sign-in still does. {address} is that address, a URL inserted exactly as the server reports it: don't translate, reformat or shorten it.",
    "placeholders": {
      "address": {
        "type": "String",
        "example": "https://bge.example.com"
      }
    }
  },
  "authProviderErrorRegistrationDisabled": "This server isn't accepting new accounts. If you already have an account here, you can still sign in with it.",
  "@authProviderErrorRegistrationDisabled": {
    "description": "Provider sign-in failure, under the heading authSignInErrorTitle: the provider signed the user in, but they have no account on this server and the server doesn't create new ones. Someone who already has an account here can still sign in to it."
  },
  "authProviderErrorEmailUnverified": "Your sign-in provider hasn't confirmed your email address. Confirm it with the provider, then try again.",
  "@authProviderErrorEmailUnverified": {
    "description": "Provider sign-in failure, under the heading authSignInErrorTitle: the provider reports the user's email address as unconfirmed, so this server won't sign them in with it. The fix is with the provider, not this server."
  },
  "authProviderErrorAccountNotLinked": "An account with this email already exists here. Sign in another way, then link this provider from Sign-in methods in Settings.",
  "@authProviderErrorAccountNotLinked": {
    "description": "Provider sign-in failure, under the heading authSignInErrorTitle: an account with the provider's email address already exists on this server, and the provider isn't linked to it. Names the next step, linking the provider from Sign-in methods (#582). Shown when the server's provider linking policy is SignedIn, or when it isn't known (#791)."
  },
  "authProviderErrorAccountNotLinkedAutomatic": "An account with this email already exists here, and it couldn't be linked automatically because an email address isn't confirmed. Sign in another way, then link this provider from Sign-in methods in Settings.",
  "@authProviderErrorAccountNotLinkedAutomatic": {
    "description": "Same failure as authProviderErrorAccountNotLinked, shown when the server's provider linking policy is AutomaticWhenVerified (#791): the server would have linked the provider by itself had both email addresses been confirmed, so the message says that one isn't. The next step is the same, Sign-in methods (#582)."
  },
  "authProviderErrorAccessDenied": "The sign-in provider didn't allow this sign-in. If you think it should have, ask this server's administrator.",
  "@authProviderErrorAccessDenied": {
    "description": "Provider sign-in failure, under the heading authSignInErrorTitle: the provider refused the sign-in, for example because the user isn't given access to this server's app there. Not shown when the user closes the browser, which is a cancel and shows nothing."
  },
  "authProviderErrorUnavailable": "This sign-in provider isn't available right now. Try again later.",
  "@authProviderErrorUnavailable": {
    "description": "Provider sign-in failure, under the heading authSignInErrorTitle: the provider the button named isn't working right now, usually because it is down. The server still offers it, and signing in through it works again by itself once the provider is back, which is why the message says to try again later rather than asking the user to change anything."
  },
  "authProviderErrorStartAgain": "The sign-in didn't finish, or took too long. Start it again.",
  "@authProviderErrorStartAgain": {
    "description": "Provider sign-in failure, under the heading authSignInErrorTitle: the sign-in can't be completed as it stands (it expired, came back incomplete, or was already used), and pressing the provider's button again is the fix."
  },
  "authProviderErrorGeneric": "Something went wrong signing in with the provider. Try again.",
  "@authProviderErrorGeneric": {
    "description": "Provider sign-in failure, under the heading authSignInErrorTitle, for any cause no other message covers. The server's and the provider's own error text is never shown, so this must not promise a specific reason."
  },
  "authProviderErrorDeviceStorage": "Couldn't save your sign-in on this device. Make sure it has free storage space, then try again.",
  "@authProviderErrorDeviceStorage": {
    "description": "The provider section's copy of authErrorDeviceStorage, under the heading authSignInErrorTitle: the provider and the server signed the user in, but this device could not store the session, so the app ended it. The fault is the device's, not the server's, the provider's or the user's account; the copy must not suggest any of those."
  },
  "authErrorRequired": "This field is required",
  "@authErrorRequired": {
    "description": "Validation error for empty required field"
  },
  "authErrorInvalidEmail": "Enter a valid email address",
  "@authErrorInvalidEmail": {
    "description": "Validation error for bad email format"
  },
  "authErrorPasswordTooShort": "Password must be at least {minLength} characters",
  "@authErrorPasswordTooShort": {
    "description": "Validation error for short password",
    "placeholders": {
      "minLength": {
        "type": "int"
      }
    }
  },
  "authErrorUsernameTooShort": "Username must be at least {minLength} characters",
  "@authErrorUsernameTooShort": {
    "description": "Validation error for short username",
    "placeholders": {
      "minLength": {
        "type": "int"
      }
    }
  },
  "authSignInErrorTitle": "Couldn't sign in",
  "@authSignInErrorTitle": {
    "description": "Heading shown above any sign-in failure message. Names the operation, because some of the messages beneath it only give a cause (a connection problem, a server fault) and never say that signing in failed."
  },
  "authRegisterErrorTitle": "Couldn't finish signing up",
  "@authRegisterErrorTitle": {
    "description": "Heading shown above any account-creation failure message. Names the operation for the same reason as authSignInErrorTitle. Must be true of every one of those messages, including a server that accepted the details but started no session, and a reply this device could not read: in both the account may exist, so the heading must not say it was not created."
  },
  "authErrorInvalidCredentials": "Incorrect email or password.",
  "@authErrorInvalidCredentials": {
    "description": "Submission error: sign-in rejected for a wrong email or password (a 401, or a 403 that gives no other reason)"
  },
  "authErrorEmailExists": "An account with this email already exists.",
  "@authErrorEmailExists": {
    "description": "Submission error: registration email already taken"
  },
  "authErrorNetwork": "Could not reach the server. Check your connection.",
  "@authErrorNetwork": {
    "description": "Submission error: connectivity failure or timeout"
  },
  "authErrorLocalDecode": "This device could not read the server's reply. Please try again.",
  "@authErrorLocalDecode": {
    "description": "Submission error: the server answered, but this device could not decode its reply (a local, momentary fault). Must not suggest checking the connection."
  },
  "authErrorSessionNotGranted": "This server accepted your details but didn't sign you in. It may need you to confirm your email first — check your inbox, then sign in.",
  "@authErrorSessionNotGranted": {
    "description": "Submission error: the server accepted the credentials but started no session, typically because it requires email verification. The server does not say why, and a duplicate sign-up gets the same answer as a new account, so the copy must not claim an account was created or that verification is certainly the reason."
  },
  "authErrorDeviceStorage": "Couldn't save your sign-in on this device. Make sure it has free storage space, then try again.",
  "@authErrorDeviceStorage": {
    "description": "Submission error: the server signed the user in, but this device could not store the session, so the app ended it. The fault is the device's, not the server's or the password's; the copy must not suggest either."
  },
  "authErrorTwoFactorRequired": "This account needs a verification code to sign in, and this app can't ask for one yet.",
  "@authErrorTwoFactorRequired": {
    "description": "Submission error: the password was right, but the account has two-factor turned on and the app has no second step yet (#1121). Must not suggest the password was wrong or that the server failed."
  },
  "authErrorEmailNotVerified": "Confirm your email before signing in. Check your inbox for the link, then try again.",
  "@authErrorEmailNotVerified": {
    "description": "Submission error: the server checked the email and password and refuses to sign in until the email is confirmed from the link it sent. The password was right, so the copy must not suggest it was wrong."
  },
  "authErrorServer": "Something went wrong on the server. Please try again.",
  "@authErrorServer": {
    "description": "Submission error: unexpected server failure"
  },
  "authErrorRateLimited": "Too many attempts. Try again in {seconds, plural, =1{1 second} other{{seconds} seconds}}.",
  "@authErrorRateLimited": {
    "description": "Submission error: the server refused a sign-in or sign-up for too many attempts and said how long to wait. Announced once when it appears, with no countdown: a ticking number would be re-announced every second. The submit button stays enabled during the wait.",
    "placeholders": {
      "seconds": {
        "type": "int"
      }
    }
  },
  "authErrorRateLimitedNoWait": "Too many attempts. Wait a moment, then try again.",
  "@authErrorRateLimitedNoWait": {
    "description": "Submission error: the server refused a sign-in or sign-up for too many attempts and gave no usable wait (none, or under a second). Announced once, with no countdown."
  },
  "authPasswordVisibilityShow": "Show password",
  "@authPasswordVisibilityShow": {
    "description": "Semantic label to show password"
  },
  "authPasswordVisibilityHide": "Hide password",
  "@authPasswordVisibilityHide": {
    "description": "Semantic label to hide password"
  },
  "authServerLabel": "Server",
  "@authServerLabel": {
    "description": "Label showing which server the user is signing into"
  },
  "authManageServers": "Manage servers",
  "@authManageServers": {
    "description": "Link that opens the list of servers added on this device, where another server can be picked or added (#134). It ends the sign-in screen, and follows Try Again when a saved session could not be checked. Shown on every platform but the web, with one server added or more, so someone who added a wrong server, or whose server cannot be reached, can leave it."
  },
  "authRegistrationDisabled": "Registration is currently disabled on this server.",
  "@authRegistrationDisabled": {
    "description": "Error when server disables sign-up"
  },
  "authNoStrategiesMessage": "This server has no authentication methods configured. Please contact the server administrator.",
  "@authNoStrategiesMessage": {
    "description": "Shown when the server advertises no usable auth strategies"
  },
  "authSessionUnreachableTitle": "Can't reach {serverName}",
  "@authSessionUnreachableTitle": {
    "description": "Title of the session-restore failure view (#37): the stored session could not be verified because the server is unreachable",
    "placeholders": {
      "serverName": {
        "type": "String"
      }
    }
  },
  "authSessionUnreachableBody": "Your session could not be verified. Check your connection and try again.",
  "@authSessionUnreachableBody": {
    "description": "Body of the session-restore failure view (#37)"
  },
  "authSessionServerFaultTitle": "{serverName} isn't working right now",
  "@authSessionServerFaultTitle": {
    "description": "Title of the session-restore failure view when the server answered and failed (a 5xx, or a reply that isn't what it should be). The server is reachable, so the copy must not mention the connection.",
    "placeholders": {
      "serverName": {
        "type": "String"
      }
    }
  },
  "authSessionServerFaultBody": "The server answered but couldn't check your session. Try again in a moment.",
  "@authSessionServerFaultBody": {
    "description": "Body of the session-restore failure view when the server answered and failed. Says a retry shortly is worth it, and nothing about the connection."
  },
  "authSessionUnexpectedTitle": "Couldn't check your session",
  "@authSessionUnexpectedTitle": {
    "description": "Title of the session-restore failure view when the fault is on this device (a reply it couldn't decode, or a locked keychain), not the server or the connection."
  },
  "authSessionUnexpectedBody": "Something went wrong on this device. Try again.",
  "@authSessionUnexpectedBody": {
    "description": "Body of the session-restore failure view when the fault is on this device. Must not mention the connection or the server."
  },
  "authRetryButton": "Try Again",
  "@authRetryButton": {
    "description": "Retry button on the session-restore failure view"
  },
  "authSignOutButton": "Sign Out",
  "@authSignOutButton": {
    "description": "Sign-out control label (#37)"
  },
  "authUnsentChangesNotice": "{count, plural, =1{1 change hasn't reached the server yet. Sign in with the same account to send it.} other{{count} changes haven't reached the server yet. Sign in with the same account to send them.}}",
  "@authUnsentChangesNotice": {
    "description": "Notice on the sign-in screen after a session ended without the user signing out (the server rejected it, or the app had to sign out to recover) while changes made on this device were still waiting to be sent (#142). Counts the changes and never names the account: on a shared device, the next person may see it. Must not read as an error or say anything was lost. The changes are kept, and signing in with the account that made them sends them.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "signInMethodsTitle": "Sign-in methods",
  "@signInMethodsTitle": {
    "description": "Title of the Sign-in methods screen, and of its row in Settings (#582): the ways the signed-in user can sign in to this server, a password or a linked sign-in provider such as a company's single sign-on."
  },
  "signInMethodsSettingsSubtitle": "How you sign in to {serverName}",
  "@signInMethodsSettingsSubtitle": {
    "description": "Second line of the Sign-in methods row in Settings, in the section for the server the user is signed in to (#582). {serverName} is the name the server gives itself.",
    "placeholders": {
      "serverName": {
        "type": "String",
        "example": "Board Game Night"
      }
    }
  },
  "signInMethodsYourMethods": "Your sign-in methods",
  "@signInMethodsYourMethods": {
    "description": "Heading over the list of ways the user can sign in now, on the Sign-in methods screen (#582)."
  },
  "signInMethodsPassword": "Password",
  "@signInMethodsPassword": {
    "description": "Name of the row for the user's password in the list of sign-in methods (#582). The password itself is never shown."
  },
  "signInMethodsPasswordNotOffered": "This server no longer accepts sign-in with a password",
  "@signInMethodsPasswordNotOffered": {
    "description": "Shown under the Password row in the list of sign-in methods when the server has turned email and password sign-in off (#582). The user still holds a password, but it no longer signs them in, so it doesn't count as a way in, and a provider's Unlink may be withheld because of it. Read together with the row's name, signInMethodsPassword."
  },
  "signInMethodsRemovedProvider": "A sign-in provider this server no longer offers",
  "@signInMethodsRemovedProvider": {
    "description": "Name of a row for a sign-in provider the user linked once that the server has since stopped offering, on the Sign-in methods screen (#582). Its own name is gone with it, so this stands in for it, as a row's name and in the message after it is unlinked. It can't be used to sign in any more, and can't be linked again."
  },
  "signInMethodsLinkedOn": "Linked {date}",
  "@signInMethodsLinkedOn": {
    "description": "Second line of a sign-in provider's row on the Sign-in methods screen (#582): when the user linked it, as in 'Linked Nov 3, 2026'.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "yMMMd"
      }
    }
  },
  "signInMethodsLinkSection": "Link a sign-in provider",
  "@signInMethodsLinkSection": {
    "description": "Heading over the buttons that link another sign-in provider to the user's account, on the Sign-in methods screen (#582). Only shown while there is a provider left to link."
  },
  "signInMethodsLink": "Link {provider}",
  "@signInMethodsLink": {
    "description": "Button that links the sign-in provider {provider} to the user's account, so they can sign in with it too (#582). It opens the provider's own page. {provider} is the provider's display name, as the server gives it.",
    "placeholders": {
      "provider": {
        "type": "String",
        "example": "Authentik"
      }
    }
  },
  "signInMethodsLinkInProgress": "Linking {provider}…",
  "@signInMethodsLinkInProgress": {
    "description": "Label of a Link button while the link it started is on its way to the provider's page (#582). Also the button's screen-reader name, so it says why pressing it does nothing meanwhile. {provider} is the provider's display name, as the server gives it.",
    "placeholders": {
      "provider": {
        "type": "String",
        "example": "Authentik"
      }
    }
  },
  "signInMethodsLinkUnavailable": "Linking {provider} isn't available in this app yet. Link it from the web app.",
  "@signInMethodsLinkUnavailable": {
    "description": "Label of a disabled Link button where this app can't link a sign-in provider yet (#582): the phone and desktop apps. The label is the only place the reason is given. 'Yet' because support is planned; the web app can link it today. {provider} is the provider's display name, as the server gives it.",
    "placeholders": {
      "provider": {
        "type": "String",
        "example": "Authentik"
      }
    }
  },
  "signInMethodsUnlink": "Unlink",
  "@signInMethodsUnlink": {
    "description": "Button under a sign-in provider's row that removes it from the user's ways in, after asking first (#582). Its screen-reader name is signInMethodsUnlinkSemantics, which says which row it belongs to."
  },
  "signInMethodsUnlinkSemantics": "Unlink {method}",
  "@signInMethodsUnlinkSemantics": {
    "description": "Screen-reader name of the Unlink button under a sign-in provider's row (#582), whose visible text is signInMethodsUnlink. Every row's button reads 'Unlink', so the name says which row it is for, and it must start with the visible text so a voice-control user can say what they see. {method} is the provider's display name, as the server gives it. A provider the server no longer offers has its own name, signInMethodsUnlinkRemovedSemantics.",
    "placeholders": {
      "method": {
        "type": "String",
        "example": "Authentik"
      }
    }
  },
  "signInMethodsUnlinkRemovedSemantics": "Unlink the sign-in provider this server no longer offers",
  "@signInMethodsUnlinkRemovedSemantics": {
    "description": "Screen-reader name of the Unlink button under the row of a sign-in provider the server has stopped offering (#582), whose visible text is signInMethodsUnlink. Its own name is gone with it, so the name describes it instead, as signInMethodsUnlinkRemovedConfirmTitle does, and it must start with the visible text so a voice-control user can say what they see."
  },
  "signInMethodsUnlinkInProgress": "Unlinking…",
  "@signInMethodsUnlinkInProgress": {
    "description": "Label of the Unlink button while its unlink is under way (#582). Also the button's screen-reader name, so it says why pressing it does nothing meanwhile."
  },
  "signInMethodsUnlinkLastWayIn": "Can't unlink: you have no other way to sign in",
  "@signInMethodsUnlinkLastWayIn": {
    "description": "Label of a disabled Unlink button, on a row the user can't unlink because nothing else would let them sign in (#582): their only way in, or a provider the server no longer offers when no other row is a way in. Such a provider is no way in itself, so the label mustn't call it one. The label is the only place the reason is given."
  },
  "signInMethodsUnlinkConfirmTitle": "Unlink {method}?",
  "@signInMethodsUnlinkConfirmTitle": {
    "description": "Title of the dialog that asks before a sign-in provider is unlinked (#582). {method} is the provider's display name, as the server gives it. A provider the server no longer offers has its own title, signInMethodsUnlinkRemovedConfirmTitle.",
    "placeholders": {
      "method": {
        "type": "String",
        "example": "Authentik"
      }
    }
  },
  "signInMethodsUnlinkConfirmBody": "You won't be able to sign in with {method} until you link it again, which needs a recent sign-in.",
  "@signInMethodsUnlinkConfirmBody": {
    "description": "Body of the dialog that asks before a sign-in provider is unlinked (#582): what the user loses, and what undoing it takes. {method} is the provider's display name, as the server gives it. A provider the server no longer offers has its own body, signInMethodsUnlinkRemovedConfirmBody.",
    "placeholders": {
      "method": {
        "type": "String",
        "example": "Authentik"
      }
    }
  },
  "signInMethodsUnlinkRemovedConfirmTitle": "Unlink the sign-in provider this server no longer offers?",
  "@signInMethodsUnlinkRemovedConfirmTitle": {
    "description": "Title of the dialog that asks before unlinking a sign-in provider the server has stopped offering (#582). Its name is gone with it, so the title describes it instead."
  },
  "signInMethodsUnlinkRemovedConfirmBody": "This server no longer offers it, so it can't be linked again.",
  "@signInMethodsUnlinkRemovedConfirmBody": {
    "description": "Body of the dialog that asks before unlinking a sign-in provider the server has stopped offering (#582): once unlinked it is gone for good, since the server can't link it again. It can't be used to sign in now either."
  },
  "signInMethodsUnlinkConfirmAction": "Unlink",
  "@signInMethodsUnlinkConfirmAction": {
    "description": "The dialog's button that unlinks the sign-in provider it names (#582)."
  },
  "signInMethodsUnlinkCancel": "Cancel",
  "@signInMethodsUnlinkCancel": {
    "description": "The dialog's button that closes it and unlinks nothing (#582)."
  },
  "signInMethodsLinked": "{provider} is linked",
  "@signInMethodsLinked": {
    "description": "Announced on the Sign-in methods screen when the user is back from the provider's page and the link worked (#582). {provider} is the provider's display name, as the server gives it.",
    "placeholders": {
      "provider": {
        "type": "String",
        "example": "Authentik"
      }
    }
  },
  "signInMethodsLinkedUnknown": "The sign-in provider is linked",
  "@signInMethodsLinkedUnknown": {
    "description": "Stands in for signInMethodsLinked when the provider that was linked is one the server no longer lists, so there is no name to give (#582)."
  },
  "signInMethodsUnlinked": "{method} is unlinked",
  "@signInMethodsUnlinked": {
    "description": "Announced on the Sign-in methods screen once a sign-in provider has been unlinked (#582). {method} is the provider's display name, as the server gives it, or signInMethodsRemovedProvider for one the server no longer offers.",
    "placeholders": {
      "method": {
        "type": "String",
        "example": "Authentik"
      }
    }
  },
  "signInMethodsLinkFailedTitle": "Couldn't link the sign-in provider",
  "@signInMethodsLinkFailedTitle": {
    "description": "Heading over any message that says why linking a sign-in provider failed (#582). Names the operation, because some of the messages beneath it only give a cause, such as a connection problem."
  },
  "signInMethodsUnlinkFailedTitle": "Couldn't unlink",
  "@signInMethodsUnlinkFailedTitle": {
    "description": "Heading over any message that says why unlinking a sign-in provider failed (#582). Names the operation, because some of the messages beneath it only give a cause, such as a connection problem."
  },
