{
  "@@locale": "en",
  "authSignInTitle": "Sign In",
  "@authSignInTitle": {
    "description": "Title for the sign-in form"
  },
  "authRegisterTitle": "Create Account",
  "@authRegisterTitle": {
    "description": "Title for the registration form"
  },
  "authSwitchToRegister": "Don't have an account? Register",
  "@authSwitchToRegister": {
    "description": "Link to switch to registration form"
  },
  "authSwitchToSignIn": "Already have an account? Sign in",
  "@authSwitchToSignIn": {
    "description": "Link to switch to sign-in form"
  },
  "authEmailLabel": "Email",
  "@authEmailLabel": {
    "description": "Email field label"
  },
  "authEmailHint": "Enter your email address",
  "@authEmailHint": {
    "description": "Email field hint text"
  },
  "authPasswordLabel": "Password",
  "@authPasswordLabel": {
    "description": "Password field label"
  },
  "authPasswordHint": "Enter your password",
  "@authPasswordHint": {
    "description": "Password field hint text"
  },
  "authPasswordCreateHint": "Create a password",
  "@authPasswordCreateHint": {
    "description": "Password field hint text on the registration form"
  },
  "authPasswordShow": "Show password",
  "@authPasswordShow": {
    "description": "Tooltip and screen-reader label for the control that reveals the typed password"
  },
  "authPasswordHide": "Hide password",
  "@authPasswordHide": {
    "description": "Tooltip and screen-reader label for the control that re-obscures the typed password"
  },
  "authUsernameLabel": "Username",
  "@authUsernameLabel": {
    "description": "Username field label"
  },
  "authUsernameHint": "Choose a username",
  "@authUsernameHint": {
    "description": "Username field hint text"
  },
  "authFirstNameLabel": "First Name",
  "@authFirstNameLabel": {
    "description": "First name field label"
  },
  "authLastNameLabel": "Last Name",
  "@authLastNameLabel": {
    "description": "Last name field label"
  },
  "authSignInButton": "Sign In",
  "@authSignInButton": {
    "description": "Sign-in submit button label"
  },
  "authRegisterButton": "Create Account",
  "@authRegisterButton": {
    "description": "Registration submit button label"
  },
  "authLoadingLabel": "Signing in, please wait",
  "@authLoadingLabel": {
    "description": "Semantic label for the sign-in loading indicator"
  },
  "authRegisterLoadingLabel": "Creating account, please wait",
  "@authRegisterLoadingLabel": {
    "description": "Semantic label for the registration loading indicator"
  },
  "authOrDivider": "or",
  "@authOrDivider": {
    "description": "Divider between email/password and OIDC options"
  },
  "authContinueWith": "Continue with {provider}",
  "@authContinueWith": {
    "description": "OIDC button label",
    "placeholders": {
      "provider": {
        "type": "String"
      }
    }
  },
  "authContinueWithInProgress": "Waiting for {provider}…",
  "@authContinueWithInProgress": {
    "description": "Label of a sign-in provider's button while that provider's sign-in is open in the browser and the app is waiting for it to finish. Also the button's screen-reader name, so it says why pressing the button does nothing meanwhile. {provider} is the provider's display name, as the server gives it.",
    "placeholders": {
      "provider": {
        "type": "String",
        "example": "Authentik"
      }
    }
  },
  "authContinueWithUnavailable": "Continue with {provider} (not available on this device yet)",
  "@authContinueWithUnavailable": {
    "description": "Label of a sign-in provider's button on a device that can't sign in through a provider yet (Windows and Linux). The button is disabled, and this label is the only place the reason is given. 'Yet' because support is planned. {provider} is the provider's display name, as the server gives it.",
    "placeholders": {
      "provider": {
        "type": "String",
        "example": "Authentik"
      }
    }
  },
  "authProviderAddressMismatch": "Sign-in providers only work when this server is reached at {address}.",
  "@authProviderAddressMismatch": {
    "description": "Note under the sign-in provider buttons, which are disabled, when this server was added under a different address from the one it reports as its own. The provider would send the user back to that other address, so provider sign-in can't work here; email sign-in still does. {address} is that address, a URL inserted exactly as the server reports it: don't translate, reformat or shorten it.",
    "placeholders": {
      "address": {
        "type": "String",
        "example": "https://bge.example.com"
      }
    }
  },
  "authProviderErrorRegistrationDisabled": "This server isn't accepting new accounts. If you already have an account here, you can still sign in with it.",
  "@authProviderErrorRegistrationDisabled": {
    "description": "Provider sign-in failure, under the heading authSignInErrorTitle: the provider signed the user in, but they have no account on this server and the server doesn't create new ones. Someone who already has an account here can still sign in to it."
  },
  "authProviderErrorEmailUnverified": "Your sign-in provider hasn't confirmed your email address. Confirm it with the provider, then try again.",
  "@authProviderErrorEmailUnverified": {
    "description": "Provider sign-in failure, under the heading authSignInErrorTitle: the provider reports the user's email address as unconfirmed, so this server won't sign them in with it. The fix is with the provider, not this server."
  },
  "authProviderErrorAccountNotLinked": "An account with this email already exists here. Sign in with its password instead.",
  "@authProviderErrorAccountNotLinked": {
    "description": "Provider sign-in failure, under the heading authSignInErrorTitle: an account with the provider's email address already exists on this server, and the provider isn't linked to it. For now the only way in is that account's password. #582 adds the next step later (linking the provider from the account's sign-in methods), and will extend this message when it does."
  },
  "authProviderErrorAccessDenied": "The sign-in provider didn't allow this sign-in. If you think it should have, ask this server's administrator.",
  "@authProviderErrorAccessDenied": {
    "description": "Provider sign-in failure, under the heading authSignInErrorTitle: the provider refused the sign-in, for example because the user isn't given access to this server's app there. Not shown when the user closes the browser, which is a cancel and shows nothing."
  },
  "authProviderErrorUnavailable": "This sign-in provider isn't available right now. Try again later.",
  "@authProviderErrorUnavailable": {
    "description": "Provider sign-in failure, under the heading authSignInErrorTitle: the provider the button named isn't working right now, usually because it is down. The server still offers it, and signing in through it works again by itself once the provider is back, which is why the message says to try again later rather than asking the user to change anything."
  },
  "authProviderErrorStartAgain": "The sign-in didn't finish, or took too long. Start it again.",
  "@authProviderErrorStartAgain": {
    "description": "Provider sign-in failure, under the heading authSignInErrorTitle: the sign-in can't be completed as it stands (it expired, came back incomplete, or was already used), and pressing the provider's button again is the fix."
  },
  "authProviderErrorGeneric": "Something went wrong signing in with the provider. Try again.",
  "@authProviderErrorGeneric": {
    "description": "Provider sign-in failure, under the heading authSignInErrorTitle, for any cause no other message covers. The server's and the provider's own error text is never shown, so this must not promise a specific reason."
  },
  "authErrorRequired": "This field is required",
  "@authErrorRequired": {
    "description": "Validation error for empty required field"
  },
  "authErrorInvalidEmail": "Enter a valid email address",
  "@authErrorInvalidEmail": {
    "description": "Validation error for bad email format"
  },
  "authErrorPasswordTooShort": "Password must be at least {minLength} characters",
  "@authErrorPasswordTooShort": {
    "description": "Validation error for short password",
    "placeholders": {
      "minLength": {
        "type": "int"
      }
    }
  },
  "authErrorUsernameTooShort": "Username must be at least {minLength} characters",
  "@authErrorUsernameTooShort": {
    "description": "Validation error for short username",
    "placeholders": {
      "minLength": {
        "type": "int"
      }
    }
  },
  "authSignInErrorTitle": "Couldn't sign in",
  "@authSignInErrorTitle": {
    "description": "Heading shown above any sign-in failure message. Names the operation, because some of the messages beneath it only give a cause (a connection problem, a server fault) and never say that signing in failed."
  },
  "authRegisterErrorTitle": "Couldn't finish signing up",
  "@authRegisterErrorTitle": {
    "description": "Heading shown above any account-creation failure message. Names the operation for the same reason as authSignInErrorTitle. Must be true of every one of those messages, including a server that accepted the details but started no session, and a reply this device could not read: in both the account may exist, so the heading must not say it was not created."
  },
  "authErrorInvalidCredentials": "Incorrect email or password.",
  "@authErrorInvalidCredentials": {
    "description": "Submission error: sign-in rejected for a wrong email or password (a 401, or a 403 that gives no other reason)"
  },
  "authErrorEmailExists": "An account with this email already exists.",
  "@authErrorEmailExists": {
    "description": "Submission error: registration email already taken"
  },
  "authErrorNetwork": "Could not reach the server. Check your connection.",
  "@authErrorNetwork": {
    "description": "Submission error: connectivity failure or timeout"
  },
  "authErrorLocalDecode": "This device could not read the server's reply. Please try again.",
  "@authErrorLocalDecode": {
    "description": "Submission error: the server answered, but this device could not decode its reply (a local, momentary fault). Must not suggest checking the connection."
  },
  "authErrorSessionNotGranted": "This server accepted your details but didn't sign you in. It may need you to confirm your email first — check your inbox, then sign in.",
  "@authErrorSessionNotGranted": {
    "description": "Submission error: the server accepted the credentials but started no session, typically because it requires email verification. The server does not say why, and a duplicate sign-up gets the same answer as a new account, so the copy must not claim an account was created or that verification is certainly the reason."
  },
  "authErrorEmailNotVerified": "Confirm your email before signing in. Check your inbox for the link, then try again.",
  "@authErrorEmailNotVerified": {
    "description": "Submission error: the server checked the email and password and refuses to sign in until the email is confirmed from the link it sent. The password was right, so the copy must not suggest it was wrong."
  },
  "authErrorServer": "Something went wrong on the server. Please try again.",
  "@authErrorServer": {
    "description": "Submission error: unexpected server failure"
  },
  "authErrorRateLimited": "Too many attempts. Try again in {seconds, plural, =1{1 second} other{{seconds} seconds}}.",
  "@authErrorRateLimited": {
    "description": "Submission error: the server refused a sign-in or sign-up for too many attempts and said how long to wait. Announced once when it appears, with no countdown: a ticking number would be re-announced every second. The submit button stays enabled during the wait.",
    "placeholders": {
      "seconds": {
        "type": "int"
      }
    }
  },
  "authErrorRateLimitedNoWait": "Too many attempts. Wait a moment, then try again.",
  "@authErrorRateLimitedNoWait": {
    "description": "Submission error: the server refused a sign-in or sign-up for too many attempts and gave no usable wait (none, or under a second). Announced once, with no countdown."
  },
  "authPasswordVisibilityShow": "Show password",
  "@authPasswordVisibilityShow": {
    "description": "Semantic label to show password"
  },
  "authPasswordVisibilityHide": "Hide password",
  "@authPasswordVisibilityHide": {
    "description": "Semantic label to hide password"
  },
  "authServerLabel": "Server",
  "@authServerLabel": {
    "description": "Label showing which server the user is signing into"
  },
  "authRegistrationDisabled": "Registration is currently disabled on this server.",
  "@authRegistrationDisabled": {
    "description": "Error when server disables sign-up"
  },
  "authNoStrategiesMessage": "This server has no authentication methods configured. Please contact the server administrator.",
  "@authNoStrategiesMessage": {
    "description": "Shown when the server advertises no usable auth strategies"
  },
  "authSessionUnreachableTitle": "Can't reach {serverName}",
  "@authSessionUnreachableTitle": {
    "description": "Title of the session-restore failure view (#37): the stored session could not be verified because the server is unreachable",
    "placeholders": {
      "serverName": {
        "type": "String"
      }
    }
  },
  "authSessionUnreachableBody": "Your session could not be verified. Check your connection and try again.",
  "@authSessionUnreachableBody": {
    "description": "Body of the session-restore failure view (#37)"
  },
  "authSessionServerFaultTitle": "{serverName} isn't working right now",
  "@authSessionServerFaultTitle": {
    "description": "Title of the session-restore failure view when the server answered and failed (a 5xx, or a reply that isn't what it should be). The server is reachable, so the copy must not mention the connection.",
    "placeholders": {
      "serverName": {
        "type": "String"
      }
    }
  },
  "authSessionServerFaultBody": "The server answered but couldn't check your session. Try again in a moment.",
  "@authSessionServerFaultBody": {
    "description": "Body of the session-restore failure view when the server answered and failed. Says a retry shortly is worth it, and nothing about the connection."
  },
  "authSessionUnexpectedTitle": "Couldn't check your session",
  "@authSessionUnexpectedTitle": {
    "description": "Title of the session-restore failure view when the fault is on this device (a reply it couldn't decode, or a locked keychain), not the server or the connection."
  },
  "authSessionUnexpectedBody": "Something went wrong on this device. Try again.",
  "@authSessionUnexpectedBody": {
    "description": "Body of the session-restore failure view when the fault is on this device. Must not mention the connection or the server."
  },
  "authRetryButton": "Try Again",
  "@authRetryButton": {
    "description": "Retry button on the session-restore failure view"
  },
  "authSignOutButton": "Sign Out",
  "@authSignOutButton": {
    "description": "Sign-out control label (#37)"
  },
  "authUnsentChangesNotice": "{count, plural, =1{1 change hasn't reached the server yet. Sign in with the same account to send it.} other{{count} changes haven't reached the server yet. Sign in with the same account to send them.}}",
  "@authUnsentChangesNotice": {
    "description": "Notice on the sign-in screen after a session ended without the user signing out (the server rejected it, or the app had to sign out to recover) while changes made on this device were still waiting to be sent (#142). Counts the changes and never names the account: on a shared device, the next person may see it. Must not read as an error or say anything was lost. The changes are kept, and signing in with the account that made them sends them.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  }
}
