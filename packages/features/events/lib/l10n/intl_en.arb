      "status": {
        "type": "String",
        "example": "Voting"
      }
    }
  },
  "eventsNominationPausedUnknown": "Paused: whoever brings it isn't coming. It goes back to {status} if they come back.",
  "@eventsNominationPausedUnknown": {
    "description": "eventsNominationPaused when the app can't tell who brings the game: their copy is no longer among the games offered. {status} is where it stood, one of the eventsNominationStatus… labels, such as 'Voting'.",
    "placeholders": {
      "status": {
        "type": "String",
        "example": "Voting"
      }
    }
  },
  "eventsVoteFor": "For",
  "@eventsVoteFor": {
    "description": "One of the three choices of the control under a nominated game in the Nominations section of an event's Games tab, with which the user votes on it: they want it played. Also names a For vote in the who-voted list (eventsVoterLine). Short: the three choices share the width of a phone's row, and a long word is drawn smaller to fit. Screen readers hear eventsVoteForNamed instead on the control."
  },
  "eventsVoteAgainst": "Against",
  "@eventsVoteAgainst": {
    "description": "One of the three choices of the vote control under a nominated game in the Nominations section of an event's Games tab (see eventsVoteFor): the user doesn't want it played. Also names an Against vote in the who-voted list (eventsVoterLine). Screen readers hear eventsVoteAgainstNamed instead on the control."
  },
  "eventsVoteInterested": "Interested",
  "@eventsVoteInterested": {
    "description": "One of the three choices of the vote control under a nominated game in the Nominations section of an event's Games tab (see eventsVoteFor): the user is interested in the game without backing it outright. How it counts depends on the event's rules, which the row says. Also names an Interested vote in the who-voted list (eventsVoterLine). Screen readers hear eventsVoteInterestedNamed instead on the control."
  },
  "eventsVoteUnknown": "Unknown",
  "@eventsVoteUnknown": {
    "description": "Names a vote in the who-voted list (eventsVoterLine) of a nominated game when the server gave a kind of vote this version of the app doesn't know."
  },
  "eventsNominationYourVote": "Your vote: {vote}",
  "@eventsNominationYourVote": {
    "description": "A line on a nominated game's row in the Nominations section of an event's Games tab, where the vote control isn't shown: the nomination is paused or decided, or the user can't vote now. It says how the user voted. {vote} is eventsVoteFor, eventsVoteAgainst, eventsVoteInterested or eventsVoteUnknown.",
    "placeholders": {
      "vote": {
        "type": "String",
        "example": "For"
      }
    }
  },
  "eventsNominationYourVoteNotCounting": "Your vote: {vote}. It doesn't count.",
  "@eventsNominationYourVoteNotCounting": {
    "description": "eventsNominationYourVote for a vote that doesn't count: the user has left the event, or the event doesn't count their vote. The who-voted list (eventsVotersNotCountingNote) gives the reasons.",
    "placeholders": {
      "vote": {
        "type": "String",
        "example": "For"
      }
    }
  },
  "eventsVoteForNamed": "For {title}",
  "@eventsVoteForNamed": {
    "description": "eventsVoteFor as a screen reader reads it on the vote control, naming the game, since every nominated game has the same three choices. Keep the choice's own word first, so that a person controlling the device by voice can say what they see.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Catan"
      }
    }
  },
  "eventsVoteAgainstNamed": "Against {title}",
  "@eventsVoteAgainstNamed": {
    "description": "eventsVoteAgainst as a screen reader reads it on the vote control, naming the game, since every nominated game has the same three choices. Keep the choice's own word first, so that a person controlling the device by voice can say what they see.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Catan"
      }
    }
  },
  "eventsVoteInterestedNamed": "Interested in {title}",
  "@eventsVoteInterestedNamed": {
    "description": "eventsVoteInterested as a screen reader reads it on the vote control, naming the game, since every nominated game has the same three choices. Keep the choice's own word first, so that a person controlling the device by voice can say what they see.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Catan"
      }
    }
  },
  "eventsVoteInProgress": "{vote}, saving your vote…",
  "@eventsVoteInProgress": {
    "description": "What a screen reader says for the choice of the vote control the user just pressed, while the vote it sent is being saved. The choice still shows its word alone, with a spinner, and can't be pressed until saving ends. {vote} is eventsVoteForNamed, eventsVoteAgainstNamed or eventsVoteInterestedNamed.",
    "placeholders": {
      "vote": {
        "type": "String",
        "example": "For Catan"
      }
    }
  },
  "eventsVoteHintAttending": "Your vote counts once you say you're going.",
  "@eventsVoteHintAttending": {
    "description": "Above the vote control under a nominated game in the Nominations section of an event's Games tab, when this event counts only the votes of people who said they are coming, and the user hasn't. They can still vote, but their vote isn't counted until they answer Going (eventsRsvpAttending) to the question on the same screen, \"Are you coming?\" (eventsRsvpQuestion). Use the words that question and its answer use."
  },
  "eventsVoteHintOffering": "Your vote counts once you offer a game.",
  "@eventsVoteHintOffering": {
    "description": "Above the vote control under a nominated game in the Nominations section of an event's Games tab, when this event counts only the votes of people bringing a game, and the user isn't bringing any. They can still vote, but their vote isn't counted until they offer a game from their collection on the same tab."
  },
  "eventsVoteAddNote": "Add a note",
  "@eventsVoteAddNote": {
    "description": "Button under the vote control of a nominated game in the Nominations section of an event's Games tab, once the user has voted on it and left no note with the vote. Opens a dialog to write a short note that goes with the vote, such as 'Only if we have time'. Screen readers hear eventsVoteAddNoteNamed instead."
  },
  "eventsVoteEditNote": "Edit note",
  "@eventsVoteEditNote": {
    "description": "The same button as eventsVoteAddNote, when the user has already left a note with their vote. Opens the dialog to change or remove it. Screen readers hear eventsVoteEditNoteNamed instead."
  },
  "eventsVoteAddNoteNamed": "Add a note to your vote on {title}",
  "@eventsVoteAddNoteNamed": {
    "description": "eventsVoteAddNote as a screen reader reads it, naming the game, since every nominated game the user votes on has its own.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Catan"
      }
    }
  },
  "eventsVoteEditNoteNamed": "Edit your note on {title}",
  "@eventsVoteEditNoteNamed": {
    "description": "eventsVoteEditNote as a screen reader reads it, naming the game, since every nominated game the user votes on has its own.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Catan"
      }
    }
  },
  "eventsVoteNoteInProgress": "Saving your note…",
  "@eventsVoteNoteInProgress": {
    "description": "Shown in place of eventsVoteAddNote or eventsVoteEditNote on the note button under a nominated game, beside a spinner, while the note the user saved is being sent with their vote. The button can't be pressed until saving ends."
  },
  "eventsVoteNoteTitle": "Your note on {title}",
  "@eventsVoteNoteTitle": {
    "description": "Title of the dialog, opened from eventsVoteAddNote or eventsVoteEditNote, where the user writes, changes or removes the short note that goes with their vote on a nominated game. {title} is the game's.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Catan"
      }
    }
  },
  "eventsVoteNoteBody": "Everyone on this event can read it.",
  "@eventsVoteNoteBody": {
    "description": "Body of the vote's note dialog (eventsVoteNoteTitle), above its field, so the user knows the note isn't private: it goes to everyone who can read the event's nominated games, including people who aren't shown who voted (eventsVotersTitle)."
  },
  "eventsVoteNoteLabel": "Note",
  "@eventsVoteNoteLabel": {
    "description": "Label of the text field in the vote's note dialog (eventsVoteNoteTitle). Left empty, saving removes the note."
  },
  "eventsVoteNoteKeep": "Cancel",
  "@eventsVoteNoteKeep": {
    "description": "Button in the vote's note dialog (eventsVoteNoteTitle) that closes it and leaves the note as it was."
  },
  "eventsVoteNoteSave": "Save note",
  "@eventsVoteNoteSave": {
    "description": "Button in the vote's note dialog (eventsVoteNoteTitle) that sends the note, with the user's vote as it stands, to the server. An empty field removes the note."
  },
  "eventsVotersOpen": "Who voted ({count})",
  "@eventsVotersOpen": {
    "description": "Button under a nominated game in the Nominations section of an event's Games tab, once anyone has voted on it. Opens a list of who voted and how (eventsVotersTitle). {count} is how many votes it has, those that don't count included. Screen readers hear eventsVotersOpenNamed instead.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "eventsVotersOpenNamed": "{count, plural, =1{Who voted on {title}: 1 vote} other{Who voted on {title}: {count} votes}}",
  "@eventsVotersOpenNamed": {
    "description": "eventsVotersOpen as a screen reader reads it, naming the game, since every nominated game with votes has its own, and saying the count in words rather than in brackets.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      },
      "title": {
        "type": "String",
        "example": "Catan"
      }
    }
  },
  "eventsVotersTitle": "Who voted on {title}",
  "@eventsVotersTitle": {
    "description": "Heading of the list, opened from eventsVotersOpen, of each vote on a nominated game: who cast it and how, with the note they left under it. Also the list's name to a screen reader as it opens. {title} is the game's.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Catan"
      }
    }
  },
  "eventsVoterLine": "{name}: {vote}",
  "@eventsVoterLine": {
    "description": "One vote in the who-voted list (eventsVotersTitle): who cast it and how. {name} is the voter's name, eventsVoterYou for the user, or eventsAttendeeSomeoneStart for someone with no name the app can show. {vote} is eventsVoteFor, eventsVoteAgainst, eventsVoteInterested or eventsVoteUnknown. A vote that doesn't count is drawn crossed out (struck through), and screen readers hear eventsVoterLineNotCounting for it instead.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Ada"
      },
      "vote": {
        "type": "String",
        "example": "For"
      }
    }
  },
  "eventsVoterLineNotCounting": "{name}: {vote}. Doesn't count.",
  "@eventsVoterLineNotCounting": {
    "description": "eventsVoterLine as a screen reader reads it for a vote that doesn't count, which the list draws crossed out (struck through) instead. eventsVotersNotCountingNote gives the reasons a vote doesn't count.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Ada"
      },
      "vote": {
        "type": "String",
        "example": "For"
      }
    }
  },
  "eventsVoterYou": "You",
  "@eventsVoterYou": {
    "description": "Names the user in the who-voted list (eventsVotersTitle), as {name} in eventsVoterLine, in place of their own name."
  },
  "eventsVotersNotCountingNote": "Struck-through votes don't count: their voter has left, or this event doesn't count them yet.",
  "@eventsVotersNotCountingNote": {
    "description": "One line above the who-voted list (eventsVotersTitle), shown only when it holds a vote that doesn't count, which it draws crossed out (struck through). A vote doesn't count when the person who cast it is no longer on the event, or when the event's rules don't count it yet: for example, until they say they're coming or offer a game. Explains the crossing out to someone who sees it: a screen reader already hears eventsVoterLineNotCounting for each such vote."
  },
  "eventsVotersNotCountingCountsOnly": "Some votes don't count: their voter has left, or this event doesn't count them yet.",
  "@eventsVotersNotCountingCountsOnly": {
    "description": "eventsVotersNotCountingNote for the who-voted list (eventsVotersTitle) when it shows only how many votes are for, against and interested, because who voted isn't shown to this user (eventsVotersHidden): no vote is drawn, so none is crossed out. Shown only when a vote doesn't count, so that the count on the button that opened the list (eventsVotersOpen), which includes those votes, is explained beside a smaller total. A vote doesn't count when the person who cast it is no longer on the event, or when the event's rules don't count it yet: for example, until they say they're coming or offer a game."
  },
  "eventsVotersHidden": "Who voted isn't shown to you.",
  "@eventsVotersHidden": {
    "description": "In the who-voted list (eventsVotersTitle) in place of the votes, under how many votes are for, against and interested, when the server won't show this user who is on the event, and so who voted."
  },
  "eventsOfferTitle": "Offer games",
  "@eventsOfferTitle": {
    "description": "Title of the page, opened from the Games tab of an event's screen, that lists the user's collection so they can pick games to offer to bring to the event."
  },
  "eventsOfferSearchLabel": "Search your collection",
  "@eventsOfferSearchLabel": {
    "description": "Label of the search field on the Offer games page, which narrows the user's collection by title as they type."
  },
  "eventsOfferSearchClear": "Clear search",
  "@eventsOfferSearchClear": {
    "description": "Accessible name and tooltip of the button inside the Offer games page's search field (eventsOfferSearchLabel) that empties it."
  },
  "eventsOfferSelectAll": "Select all shown",
  "@eventsOfferSelectAll": {
    "description": "Button on the Offer games page that picks every game the search and the filters show that can be offered, adding them to the games already picked."
  },
  "eventsOfferClearSelection": "Clear selection",
  "@eventsOfferClearSelection": {
    "description": "Takes the place of eventsOfferSelectAll on the Offer games page once every game shown that can be offered is picked: it unpicks every game, those the filters hide included."
  },
  "eventsOfferNothingToSelect": "None of the games shown can be offered.",
  "@eventsOfferNothingToSelect": {
    "description": "Read by a screen reader with the Select all shown button (eventsOfferSelectAll) on the Offer games page while it can't be pressed: every game the search and the filters show is offered already or not on the server, and each of those says which."
  },
  "eventsOfferCount": "{count, plural, =1{1 game shown} other{{count} games shown}}",
  "@eventsOfferCount": {
    "description": "Under the search field and the filters on the Offer games page: how many of the user's games the search and the filters show.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "eventsOfferTitleWithSubtitle": "{title}: {subtitle}",
  "@eventsOfferTitleWithSubtitle": {
    "description": "A game's name on its row of the Offer games page when the game also has a subtitle, for example 'Catan: Seafarers', as the collection list names it. The subtitle is often what tells two rows apart. Reorder or change the punctuation as your language needs.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Catan"
      },
      "subtitle": {
        "type": "String",
        "example": "Seafarers"
      }
    }
  },
  "eventsOfferAlready": "Already offered",
  "@eventsOfferAlready": {
    "description": "Under a game on the Offer games page, which is ticked and can't be changed, because the user has already offered it to this event."
  },
  "eventsOfferNotSynced": "Not synced yet",
  "@eventsOfferNotSynced": {
    "description": "Under a game on the Offer games page that can't be picked, because the user added it to their collection while offline and the server doesn't have it."
  },
  "eventsOfferSend": "{count, plural, =0{Offer games} =1{Offer 1 game} other{Offer {count} games}}",
  "@eventsOfferSend": {
    "description": "Button at the foot of the Offer games page that goes back to the event and offers the games picked there; {count} is how many are picked, those the filters hide included. It can't be pressed with none picked.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "eventsOfferEmptyTitle": "Your collection is empty",
  "@eventsOfferEmptyTitle": {
    "description": "On the Offer games page when the user's collection holds no games to offer."
  },
  "eventsOfferNoMatchesTitle": "No games match",
  "@eventsOfferNoMatchesTitle": {
    "description": "On the Offer games page when the user's collection has games but the search or the filters leave none of them."
  },
  "eventsOfferClearFilters": "Clear filters",
  "@eventsOfferClearFilters": {
    "description": "Button under eventsOfferNoMatchesTitle that empties the search and clears every filter, so the whole collection shows again."
  },
  "eventsOfferLoading": "Loading your collection",
  "@eventsOfferLoading": {
    "description": "Read by a screen reader, never drawn, while the Offer games page waits for the user's collection."
  },
  "eventsOfferFailedTitle": "Couldn't read your collection",
  "@eventsOfferFailedTitle": {
    "description": "On the Offer games page when the user's collection couldn't be read from this device, or stopped being readable, for example because the user signed out."
  },
  "eventsOfferFailedBody": "Go back to the event and try again.",
  "@eventsOfferFailedBody": {
    "description": "Under eventsOfferFailedTitle, above the button that goes back to the event (eventsOfferBack). Opening the page again reads the collection again."
  },
  "eventsOfferBack": "Back to the event",
  "@eventsOfferBack": {
    "description": "Button under eventsOfferFailedBody on the Offer games page: leaves the page without offering anything, back to the event's screen."
  },
  "eventsDetailAttendeesNotLoaded": "Not loaded yet.",
  "@eventsDetailAttendeesNotLoaded": {
    "description": "In the who's-coming section of an event's screen, when this device has not yet read the list of people from the server, for example because it has been offline since the event arrived."
  },
  "eventsDetailAttendeesHidden": "You can't see who's coming to this event.",
  "@eventsDetailAttendeesHidden": {
    "description": "In the who's-coming section of an event's screen, when the server said the user may not see the list of people. It does NOT mean nobody is coming."
  },
  "eventsDetailRefreshFailed": "This may be out of date: we couldn't refresh it.",
  "@eventsDetailRefreshFailed": {
    "description": "Banner over an event's details when they could not be read again from the server, for ANY reason: the server was unreachable, or it answered with an error. The details already on this device are still shown. Deliberately does not name a cause, because the screen does not know which one it was."
  },
  "eventsDetailNotFoundTitle": "We couldn't find this event",
  "@eventsDetailNotFoundTitle": {
    "description": "Heading shown in place of an event the server no longer shows this user: it was deleted, or they may no longer see it. The server does not say which."
  },
  "eventsDetailNotFoundBody": "It may have been deleted, or you may no longer be able to see it.",
  "@eventsDetailNotFoundBody": {
    "description": "Under eventsDetailNotFoundTitle. Gives both reasons, because the app cannot tell them apart."
  },
  "eventsDetailNotFoundAction": "Back to events",
  "@eventsDetailNotFoundAction": {
    "description": "Button under eventsDetailNotFoundBody that returns to the events overview."
  },
  "eventsDetailError": "We couldn't load this event.",
  "@eventsDetailError": {
    "description": "Shown in place of an event when nothing about it is on this device and it could not be read, from the server or from the device. A retry button may follow."
  },
  "eventsDetailErrorBody": "Nothing about it could be shown. Trying again may work.",
  "@eventsDetailErrorBody": {
    "description": "Body under eventsDetailError, above a button that tries again, on the screen for one event. Deliberately names no cause: the failure may be the read from the server or the device's own copy of the event, and the screen cannot tell the user which."
  },
  "eventsDetailYourRole": "You're {role} at this event",
  "@eventsDetailYourRole": {
    "description": "On an event's screen: the user's own role at the event. The role arrives as one of the eventsRole phrases, with its article, such as 'the host' or 'a guest'. Reword as your language needs; the phrases are translated on their own.",
    "placeholders": {
      "role": {
        "type": "String",
        "example": "the host"
      }
    }
  },
  "eventsDetailUntil": "until {time}",
  "@eventsDetailUntil": {
    "description": "Under the start of one of an event's dates, on the event's screen: when it ends. The time arrives already formatted. It is the time of day alone ('11:00 PM') when the date ends on the day it starts, and the day and time in the eventsWhen form ('Sat, Nov 7 · 2:00 AM') when it ends on another day.",
    "placeholders": {
      "time": {
        "type": "String",
        "example": "11:00 PM"
      }
    }
  },
  "eventsDetailMoreActions": "More actions",
  "@eventsDetailMoreActions": {
    "description": "Tooltip and accessible name of the three-dot button in the top bar of an event's screen. Opens a menu of what the user may do to the event, such as deleting it. Shown only to someone who may do one of those things."
  },
  "eventsDetailDelete": "Delete event",
  "@eventsDetailDelete": {
    "description": "Item in the More actions menu of an event's screen. Asks for confirmation, then deletes the event for everyone on it. Offered to the event's host alone."
  },
  "eventsDeleteConfirmTitle": "Delete {title}?",
  "@eventsDeleteConfirmTitle": {
    "description": "Title of the dialog asking the host to confirm deleting an event, by the event's own title, which the host chose and may be long.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Catan night"
      }
    }
  },
  "eventsDeleteConfirmBody": "This can't be undone. Everyone on the event loses it, and they won't be told.",
  "@eventsDeleteConfirmBody": {
    "description": "Body of the dialog asking to confirm deleting an event. Says three things, and a translation must keep all three: the delete is permanent, every person on the event loses it, and nobody is notified that it happened."
  },
  "eventsDeleteConfirmKeep": "Keep event",
  "@eventsDeleteConfirmKeep": {
    "description": "Button in the delete-event dialog that closes it and deletes nothing. Deliberately not 'Cancel': cancelling an event, calling it off while keeping it, is a different action in this app."
  },
  "eventsDeleteConfirm": "Delete",
  "@eventsDeleteConfirm": {
    "description": "Confirm button of the delete-event dialog, shown in the error colour. Deletes the event for everyone on it."
  },
  "eventsDeleted": "Event deleted",
  "@eventsDeleted": {
    "description": "Brief message at the foot of the screen once the server has deleted an event, as the app leaves that event's screen."
  },
  "eventsDeleteGone": "This event was already deleted.",
  "@eventsDeleteGone": {
    "description": "Banner on an event's screen after trying to delete it, when the server has no live event by that id: perhaps an earlier delete went through and its answer was lost on the way back. Either way the event is gone, so this is not an error."
  },
  "eventsDeleteRefused": "You can't delete this event.",
  "@eventsDeleteRefused": {
    "description": "Banner on an event's screen when the server refused to delete it: the user is not allowed to, for example because they are no longer its host after a change made on another device."
  },
  "eventsDeleteFailed": "An error occurred while deleting this event. You may need to try again.",
  "@eventsDeleteFailed": {
    "description": "Banner on an event's screen when deleting it ended without an answer that says what happened, most often because there was no connection. The delete may or may not have gone through, so the copy must not say the event wasn't deleted. Trying again is safe: if the first delete did go through, the second finds the event already deleted."
  },
  "eventsDeleteFailedUnexpected": "Something went wrong, and the event wasn't deleted.",
  "@eventsDeleteFailedUnexpected": {
    "description": "Banner on an event's screen when deleting it failed for any reason other than the connection: the server rejected the request, or the app sent nothing, for example because a different account signed in from another tab. The event is still there. Unlike the connection failure it does not suggest trying again, since the same press would most likely fail the same way."
  },
  "eventsDeleteCancelInstead": "Cancel event instead",
  "@eventsDeleteCancelInstead": {
    "description": "Button in the delete-event dialog, beside Keep event and Delete. Closes that dialog and opens the cancel-event dialog in its place. Cancelling calls the event off and tells everyone on it, but keeps the event, where deleting removes it for everyone without telling them. Shown only to someone who may cancel the event, while it is not already cancelled or archived."
  },
  "eventsDetailCancel": "Cancel event",
  "@eventsDetailCancel": {
    "description": "Item in the More actions menu of an event's screen. Asks for an optional reason, then calls the event off for everyone on it, who are told. The event is kept, and can be reopened. Offered to the event's host and co-hosts and to its household's owners and admins, while the event is not cancelled or archived."
  },
  "eventsDetailReopen": "Reopen event",
  "@eventsDetailReopen": {
    "description": "Item in the More actions menu of a cancelled event's screen. Asks for confirmation, then takes the cancellation back. Everyone on the event is told."
  },
  "eventsDetailArchive": "Archive event",
  "@eventsDetailArchive": {
    "description": "Item in the More actions menu of a cancelled or completed event's screen. Puts the event away on the events' Archived page, at once and without asking: nobody is told, and Unarchive event undoes it. Offered to the event's host and co-hosts."
  },
  "eventsDetailUnarchive": "Unarchive event",
  "@eventsDetailUnarchive": {
    "description": "Item in the More actions menu of an archived event's screen. Takes the event off the events' Archived page, at once and without asking."
  },
  "eventsCancelConfirmTitle": "Cancel {title}?",
  "@eventsCancelConfirmTitle": {
    "description": "Title of the dialog asking to confirm cancelling an event, by the event's own title, which the host chose and may be long. Cancelling calls the event off and keeps it: it is not deleting it.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Catan night"
      }
    }
  },
  "eventsCancelConfirmBody": "Everyone on the event is told, with your reason if you give one. You can reopen it later.",
  "@eventsCancelConfirmBody": {
