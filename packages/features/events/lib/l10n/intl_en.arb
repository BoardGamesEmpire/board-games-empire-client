  },
  "eventsRoleLabelCoHost": "Co-host",
  "@eventsRoleLabelCoHost": {
    "description": "A person's role at an event, beside their name in the event's who's-coming list: someone hosting the event alongside its host."
  },
  "eventsRoleLabelOrganizer": "Organizer",
  "@eventsRoleLabelOrganizer": {
    "description": "A person's role at an event, beside their name in the event's who's-coming list: someone helping to organize the event."
  },
  "eventsRoleLabelModerator": "Moderator",
  "@eventsRoleLabelModerator": {
    "description": "A person's role at an event, beside their name in the event's who's-coming list: someone keeping order at the event."
  },
  "eventsRoleLabelParticipant": "Participant",
  "@eventsRoleLabelParticipant": {
    "description": "A person's role at an event, beside their name in the event's who's-coming list: someone taking part in the event."
  },
  "eventsRoleLabelGuest": "Guest",
  "@eventsRoleLabelGuest": {
    "description": "A person's role at an event, beside their name in the event's who's-coming list: someone invited to the event as a guest."
  },
  "eventsRoleLabelSpectator": "Spectator",
  "@eventsRoleLabelSpectator": {
    "description": "A person's role at an event, beside their name in the event's who's-coming list: someone coming to watch rather than play."
  },
  "eventsOccurrenceProposed": "Proposed",
  "@eventsOccurrenceProposed": {
    "description": "Where one of an event's dates stands, in the dates on the event's screen: suggested while a vote chooses the date, and not settled yet."
  },
  "eventsOccurrenceConfirmed": "Confirmed",
  "@eventsOccurrenceConfirmed": {
    "description": "Where one of an event's dates stands, in the dates on the event's screen: settled: the event happens then."
  },
  "eventsOccurrenceDeclined": "Declined",
  "@eventsOccurrenceDeclined": {
