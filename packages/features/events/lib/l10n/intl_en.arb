  "eventsStatusWriteGone": "This event was deleted.",
  "@eventsStatusWriteGone": {
    "description": "Banner on an event's screen when cancelling, reopening, archiving or unarchiving it found no event by that id on the server: it was deleted meanwhile, perhaps from another device. A warning, not an error."
  },
  "eventsStatusWriteRefused": "You can't change this event's status any more.",
  "@eventsStatusWriteRefused": {
    "description": "Banner on an event's screen when the server refused to cancel, reopen, archive or unarchive the event: the user is no longer allowed to, for example because their role on it changed on another device. The screen reads the event again."
  },
  "eventsStatusWriteChanged": "This event changed before that went through. Check it below before trying again.",
  "@eventsStatusWriteChanged": {
    "description": "Banner on an event's screen when cancelling, reopening, archiving or unarchiving the event was turned down because its status had changed since the screen showed it: for example, it was archived or cancelled from another device. It shows as the screen starts reading the event again, and stays if that read fails, so the copy must not say the event below is up to date: the refresh banner says whether the read went through. It also shows, with no read, when the screen didn't send the change at all: by the time its dialog closed the event no longer offered it, because a sync changed the event or the user's role on it, or the event ended. A warning, not an error."
  },
  "eventsStatusWriteFailed": "An error occurred, and the event's status may not have changed. You may need to try again.",
  "@eventsStatusWriteFailed": {
    "description": "Banner on an event's screen when cancelling, reopening, archiving or unarchiving the event ended without an answer that says what happened, most often because there was no connection. The change may or may not have gone through, so the copy must not say the status didn't change."
  },
  "eventsStatusWriteFailedUnexpected": "Something went wrong. Check the event's status before trying again.",
  "@eventsStatusWriteFailedUnexpected": {
    "description": "Banner on an event's screen when cancelling, reopening, archiving or unarchiving the event failed for any reason other than the connection: the server rejected the request, the server answered with something the app could not read, or the app sent nothing, for example because a different account signed in from another tab. An answer the app could not read may follow a change that went through, and the screen reads the event again, so the copy must not say the status didn't change. Unlike the connection failure it does not invite a retry straight away."
  },
  "eventsDetailCancelledNote": "This event was cancelled.",
  "@eventsDetailCancelledNote": {
    "description": "On a cancelled event's screen, under the line saying what kind of event it is and where it stands: says in words that the event was called off. The reason, where the person who cancelled it gave one, follows on the next line (eventsDateCancelReason)."
  },
  "eventsActionDismiss": "Dismiss",
  "@eventsActionDismiss": {
    "description": "Button on the banner that says how the last change made on an event's screen went, such as deleting the event or confirming one of its dates. Closes the banner."
  },
  "eventsDateChanged": "This date changed meanwhile. Check it below before trying again.",
  "@eventsDateChanged": {
    "description": "Banner on an event's screen when a change to one of its dates was turned down because the date had changed since the screen showed it: someone else changed, confirmed or cancelled it, or an earlier attempt from this device went through. It shows as the screen starts reading the event again, and stays if that read fails, so the copy must not say the date below is up to date: the refresh banner says whether the read went through. It also shows, with no read, when the screen didn't send the change at all: by the time its dialog closed the date no longer offered it, because a sync changed the date, cancelled the event or changed the user's role on it, or a proposed date passed. A warning, not an error."
  },
  "eventsDateCancelledRemoveUnconfirmed": "The date was cancelled. If it's still below, you can remove it now.",
  "@eventsDateCancelledRemoveUnconfirmed": {
    "description": "Banner on an event's screen after trying to remove a confirmed date, which happens in two steps: the date is cancelled first, then removed. The cancel went through and the removal did not come back done, so whether the date is still there is for the re-read of the event to say. It may have been removed after all. If it is still listed it shows as cancelled, and removing it again is offered on the date itself."
  },
  "eventsDateActions": "Actions for {date}",
  "@eventsDateActions": {
    "description": "Tooltip and accessible name of the three-dot button beside one of the dates on an event's screen. Opens a menu of what the user may do to that date, such as confirm or remove it. Every date has one, so it names its date: by the date's label, or when it starts where it has none.",
    "placeholders": {
