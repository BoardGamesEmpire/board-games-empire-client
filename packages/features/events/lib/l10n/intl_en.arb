{
  "@@locale": "en",
  "eventsTitle": "Events",
  "@eventsTitle": {
    "description": "Title of the screen giving an overview of the user's events, and the label of the drawer entry that opens it. Also the title bar of the screen showing one event, whose own title is the heading under it."
  },
  "eventsGroupUpcoming": "Upcoming",
  "@eventsGroupUpcoming": {
    "description": "Heading of the group of events whose date is still ahead, or under way, soonest first. Also the title of the page listing the whole group."
  },
  "eventsGroupPlanning": "Planning",
  "@eventsGroupPlanning": {
    "description": "Heading of the group of events that have no confirmed date yet, because one is being chosen or none has been set. Also the title of the page listing the whole group."
  },
  "eventsGroupPast": "Past",
  "@eventsGroupPast": {
    "description": "Heading of the group of events whose every date is over, most recent first. Also the title of the page listing the whole group."
  },
  "eventsGroupSeeAll": "See all ({count})",
  "@eventsGroupSeeAll": {
    "description": "Button beside a group's heading on the events overview, which shows only the first few events of each group. It opens a page listing every event in the group; the number is how many events the group holds. Screen readers hear eventsGroupSeeAllSpoken instead.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "eventsGroupSeeAllSpoken": "{group}: see all {count, plural, =1{1 event} other{{count} events}}",
  "@eventsGroupSeeAllSpoken": {
    "description": "What a screen reader says for the eventsGroupSeeAll button, which on its own would not say which group it opens or what the number counts. The group is one of the group headings, such as 'Upcoming'.",
    "placeholders": {
      "group": {
        "type": "String",
        "example": "Upcoming"
      },
      "count": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "eventsGroupEmpty": "Nothing here right now.",
  "@eventsGroupEmpty": {
    "description": "Shown on the page listing one group of events when the group has no events left, for example once the last upcoming event has moved to Past."
  },
  "eventsLoading": "Loading your events",
  "@eventsLoading": {
    "description": "Announced and shown while the user's events are still being fetched for the first time."
  },
  "eventsEmptyTitle": "No events yet",
  "@eventsEmptyTitle": {
    "description": "Heading of the empty state shown when the user has no events at all."
  },
  "eventsEmptyBody": "Events you're hosting or invited to show up here.",
  "@eventsEmptyBody": {
    "description": "Body of the empty state shown when the user has no events at all. Says where events come from. The New event button, where there is one, sits under it."
  },
  "eventsError": "Your events couldn't be read.",
  "@eventsError": {
    "description": "Shown when the events kept on this device could not be read at all, so none can be displayed. Not a network failure."
  },
  "eventsErrorBody": "Something went wrong opening them on this device.",
  "@eventsErrorBody": {
    "description": "Body under eventsError, above a button that tries again. Says the failure is on this device, so that the user doesn't go looking for a connection problem."
  },
  "eventsRefreshFailed": "Couldn't refresh your events. What's shown may be out of date.",
  "@eventsRefreshFailed": {
    "description": "Banner shown when the user's events could not be refreshed from the server, for ANY reason: the server was unreachable, or it answered with an error. The events already on this device are still shown. Deliberately does not name a cause, because the screen does not know which one it was."
  },
  "eventsRefreshRetry": "Try again",
  "@eventsRefreshRetry": {
    "description": "Button that asks the server again: for the user's events, on the couldn't-refresh banner and when the events could not be read, and for one event, on that event's screen. Kept as a plain retry: nothing here can promise the next attempt will work."
  },
  "eventsRefreshInProgress": "Refreshing…",
  "@eventsRefreshInProgress": {
    "description": "Replaces the couldn't-refresh banner copy while a refresh the user asked for is running, and is the retry button's label while it is disabled, on the events overview and on one event's screen. Shown ONLY for a refresh the user asked for: one started by reconnecting, by resuming the app or by opening the screen is not narrated."
  },
  "eventsWhen": "{date} · {time}",
  "@eventsWhen": {
    "description": "When an event happens, on its row and in the dates on its screen: the day, then the time it starts, for a date in the current year, for example 'Fri, Nov 6 · 7:30 PM'. The time arrives already formatted, in the 12- or 24-hour form the user's device is set to. Reorder or change the punctuation as your language needs.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "MMMEd"
      },
      "time": {
        "type": "String",
        "example": "7:30 PM"
      }
    }
  },
  "eventsWhenWithYear": "{date} · {time}",
  "@eventsWhenWithYear": {
    "description": "eventsWhen for a date in another year, which carries the year, for example 'Wed, Jan 6, 2027 · 7:30 PM'. Reorder or change the punctuation as your language needs.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "yMMMEd"
      },
      "time": {
        "type": "String",
        "example": "7:30 PM"
      }
    }
  },
  "eventsDateBeingChosen": "Date being chosen",
  "@eventsDateBeingChosen": {
    "description": "In place of a date on an event's row, and in the dates on its screen, while the people invited are voting on when it should happen."
  },
  "eventsNoDateYet": "No date yet",
  "@eventsNoDateYet": {
    "description": "In place of a date on an event's row, and in the dates on its screen, when the event has no date set and no vote is choosing one."
  },
  "eventsRsvpAttending": "Going",
  "@eventsRsvpAttending": {
    "description": "An answer to an event's invitation, on the event's row (the user's own) and beside each person in its who's-coming list: they will attend."
  },
  "eventsRsvpMaybe": "Maybe",
  "@eventsRsvpMaybe": {
    "description": "An answer to an event's invitation, on the event's row (the user's own) and beside each person in its who's-coming list: they might attend."
  },
  "eventsRsvpNotAttending": "Not going",
  "@eventsRsvpNotAttending": {
    "description": "An answer to an event's invitation, on the event's row (the user's own) and beside each person in its who's-coming list: they will not attend."
  },
  "eventsRsvpInvited": "Invited",
  "@eventsRsvpInvited": {
    "description": "On the event's row (the user's own) and beside each person in its who's-coming list: they were invited and have not answered yet."
  },
  "eventsDetailSeparator": " · ",
  "@eventsDetailSeparator": {
    "description": "Shown between the parts of one line about an event, for example 'Back room · The Smiths · Going' on its row, 'Strategy night · Scheduled' on its screen, or 'Host · Going' beside a person coming to it. Keep or drop the surrounding spaces as your language's punctuation needs."
  },
  "eventsDetailSpokenSeparator": ", ",
  "@eventsDetailSpokenSeparator": {
    "description": "Joins the same parts when a screen reader reads such a line aloud, in place of eventsDetailSeparator, whose symbol would be read out. It should sound like a short pause between list items."
  },
  "eventsCreate": "New event",
  "@eventsCreate": {
    "description": "Label of the buttons that start creating an event: on the events overview, in its empty state, and on the page of each group of events."
  },
  "eventsDetailLoading": "Loading this event",
  "@eventsDetailLoading": {
    "description": "Announced and shown on the screen for one event while it is read for the first time, before anything about it is on this device."
  },
  "eventsDetailDates": "Dates",
  "@eventsDetailDates": {
    "description": "Heading of the section of an event's screen listing when it happens: each of its dates, or the dates proposed while a vote chooses one."
  },
  "eventsDetailAttendees": "Who's coming",
  "@eventsDetailAttendees": {
    "description": "Heading of the section of an event's screen listing the people invited to it, each with their role and their answer."
  },
  "eventsDetailGames": "Games",
  "@eventsDetailGames": {
    "description": "Heading of the section of an event's screen that will list the games planned for it."
  },
  "eventsDetailAttendeesNotLoaded": "Not loaded yet.",
  "@eventsDetailAttendeesNotLoaded": {
    "description": "In the who's-coming section of an event's screen, when this device has not yet read the list of people from the server, for example because it has been offline since the event arrived."
  },
  "eventsDetailAttendeesHidden": "You can't see who's coming to this event.",
  "@eventsDetailAttendeesHidden": {
    "description": "In the who's-coming section of an event's screen, when the server said the user may not see the list of people. It does NOT mean nobody is coming."
  },
  "eventsDetailGamesNotYet": "This event's games will show here.",
  "@eventsDetailGamesNotYet": {
    "description": "In the games section of an event's screen, which this version of the app does not fill yet. Says where the games will appear, without promising when."
  },
  "eventsDetailRefreshFailed": "This may be out of date: we couldn't refresh it.",
  "@eventsDetailRefreshFailed": {
    "description": "Banner over an event's details when they could not be read again from the server, for ANY reason: the server was unreachable, or it answered with an error. The details already on this device are still shown. Deliberately does not name a cause, because the screen does not know which one it was."
  },
  "eventsDetailNotFoundTitle": "We couldn't find this event",
  "@eventsDetailNotFoundTitle": {
    "description": "Heading shown in place of an event the server no longer shows this user: it was deleted, or they may no longer see it. The server does not say which."
  },
  "eventsDetailNotFoundBody": "It may have been deleted, or you may no longer be able to see it.",
  "@eventsDetailNotFoundBody": {
    "description": "Under eventsDetailNotFoundTitle. Gives both reasons, because the app cannot tell them apart."
  },
  "eventsDetailNotFoundAction": "Back to events",
  "@eventsDetailNotFoundAction": {
    "description": "Button under eventsDetailNotFoundBody that returns to the events overview."
  },
  "eventsDetailError": "We couldn't load this event.",
  "@eventsDetailError": {
    "description": "Shown in place of an event when nothing about it is on this device and it could not be read, from the server or from the device. A retry button may follow."
  },
  "eventsDetailErrorBody": "Nothing about it could be shown. Trying again may work.",
  "@eventsDetailErrorBody": {
    "description": "Body under eventsDetailError, above a button that tries again, on the screen for one event. Deliberately names no cause: the failure may be the read from the server or the device's own copy of the event, and the screen cannot tell the user which."
  },
  "eventsDetailYourRole": "You're {role} at this event",
  "@eventsDetailYourRole": {
    "description": "On an event's screen: the user's own role at the event. The role arrives as one of the eventsRole phrases, with its article, such as 'the host' or 'a guest'. Reword as your language needs; the phrases are translated on their own.",
    "placeholders": {
      "role": {
        "type": "String",
        "example": "the host"
      }
    }
  },
  "eventsDetailUntil": "until {time}",
  "@eventsDetailUntil": {
    "description": "Under the start of one of an event's dates, on the event's screen: when it ends. The time arrives already formatted. It is the time of day alone ('11:00 PM') when the date ends on the day it starts, and the day and time in the eventsWhen form ('Sat, Nov 7 · 2:00 AM') when it ends on another day.",
    "placeholders": {
      "time": {
        "type": "String",
        "example": "11:00 PM"
      }
    }
  },
  "eventsDetailMoreActions": "More actions",
  "@eventsDetailMoreActions": {
    "description": "Tooltip and accessible name of the three-dot button in the top bar of an event's screen. Opens a menu of what the user may do to the event, such as deleting it. Shown only to someone who may do one of those things."
  },
  "eventsDetailDelete": "Delete event",
  "@eventsDetailDelete": {
    "description": "Item in the More actions menu of an event's screen. Asks for confirmation, then deletes the event for everyone on it. Offered to the event's host alone."
  },
  "eventsDeleteConfirmTitle": "Delete {title}?",
  "@eventsDeleteConfirmTitle": {
    "description": "Title of the dialog asking the host to confirm deleting an event, by the event's own title, which the host chose and may be long.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Catan night"
      }
    }
  },
  "eventsDeleteConfirmBody": "This can't be undone. Everyone on the event loses it, and they won't be told.",
  "@eventsDeleteConfirmBody": {
    "description": "Body of the dialog asking to confirm deleting an event. Says three things, and a translation must keep all three: the delete is permanent, every person on the event loses it, and nobody is notified that it happened."
  },
  "eventsDeleteConfirmKeep": "Keep event",
  "@eventsDeleteConfirmKeep": {
    "description": "Button in the delete-event dialog that closes it and deletes nothing. Deliberately not 'Cancel': cancelling an event, calling it off while keeping it, is a different action in this app."
  },
  "eventsDeleteConfirm": "Delete",
  "@eventsDeleteConfirm": {
    "description": "Confirm button of the delete-event dialog, shown in the error colour. Deletes the event for everyone on it."
  },
  "eventsDeleted": "Event deleted",
  "@eventsDeleted": {
    "description": "Brief message at the foot of the screen once the server has deleted an event, as the app leaves that event's screen."
  },
  "eventsDeleteGone": "This event was already deleted.",
  "@eventsDeleteGone": {
    "description": "Banner on an event's screen after trying to delete it, when the server has no live event by that id: perhaps an earlier delete went through and its answer was lost on the way back. Either way the event is gone, so this is not an error."
  },
  "eventsDeleteRefused": "You can't delete this event.",
  "@eventsDeleteRefused": {
    "description": "Banner on an event's screen when the server refused to delete it: the user is not allowed to, for example because they are no longer its host after a change made on another device."
  },
  "eventsDeleteFailed": "An error occurred while deleting this event. You may need to try again.",
  "@eventsDeleteFailed": {
    "description": "Banner on an event's screen when deleting it ended without an answer that says what happened, most often because there was no connection. The delete may or may not have gone through, so the copy must not say the event wasn't deleted. Trying again is safe: if the first delete did go through, the second finds the event already deleted."
  },
  "eventsDeleteFailedUnexpected": "Something went wrong, and the event wasn't deleted.",
  "@eventsDeleteFailedUnexpected": {
    "description": "Banner on an event's screen when deleting it failed for any reason other than the connection: the server rejected the request, or the app sent nothing, for example because a different account signed in from another tab. The event is still there. Unlike the connection failure it does not suggest trying again, since the same press would most likely fail the same way."
  },
  "eventsActionDismiss": "Dismiss",
  "@eventsActionDismiss": {
    "description": "Button on the banner that says how the last change made on an event's screen went, such as deleting the event or confirming one of its dates. Closes the banner."
  },
  "eventsDateChanged": "This date changed meanwhile. Check it below before trying again.",
  "@eventsDateChanged": {
    "description": "Banner on an event's screen when a change to one of its dates was turned down because the date had changed since the screen showed it: someone else changed, confirmed or cancelled it, or an earlier attempt from this device went through. It shows as the screen starts reading the event again, and stays if that read fails, so the copy must not say the date below is up to date: the refresh banner says whether the read went through. A warning, not an error."
  },
  "eventsDateCancelledRemoveUnconfirmed": "The date was cancelled. If it's still below, you can remove it now.",
  "@eventsDateCancelledRemoveUnconfirmed": {
    "description": "Banner on an event's screen after trying to remove a confirmed date, which happens in two steps: the date is cancelled first, then removed. The cancel went through and the removal did not come back done, so whether the date is still there is for the re-read of the event to say. It may have been removed after all. If it is still listed it shows as cancelled, and removing it again is offered on the date itself."
  },
  "eventsDateActions": "Actions for {date}",
  "@eventsDateActions": {
    "description": "Tooltip and accessible name of the three-dot button beside one of the dates on an event's screen. Opens a menu of what the user may do to that date, such as confirm or remove it. Every date has one, so it names its date: by the date's label, or when it starts where it has none.",
    "placeholders": {
      "date": {
        "type": "String",
        "example": "Fri, Nov 6 · 7:30 PM"
      }
    }
  },
  "eventsDateAdd": "Add a date",
  "@eventsDateAdd": {
    "description": "Button under the dates on an event's screen. Opens a dialog that adds another date to the event. Shown only to someone who may add one, and on a one-date event only while it has none."
  },
  "eventsDateEdit": "Edit",
  "@eventsDateEdit": {
    "description": "Item in a date's menu on an event's screen. Opens a dialog that changes the date's label, when it starts and ends, or its place."
  },
  "eventsDateConfirm": "Confirm",
  "@eventsDateConfirm": {
    "description": "Item in a proposed date's menu on an event's screen, and the confirm button of the dialog it opens. Settles on that date for the event. A verb."
  },
  "eventsDateDecline": "Decline",
  "@eventsDateDecline": {
    "description": "Item in a proposed date's menu on an event's screen, and the confirm button of the dialog it opens. Turns the proposed date down for good. A verb."
  },
  "eventsDateCancel": "Cancel date",
  "@eventsDateCancel": {
    "description": "Item in a confirmed date's menu on an event's screen, and the confirm button of the dialog it opens. Calls that date off, and tells everyone who answered it. Names the date so it is not read as closing the dialog."
  },
  "eventsDateRemove": "Remove",
  "@eventsDateRemove": {
    "description": "Item in a date's menu on an event's screen, and the confirm button of the dialog it opens. Takes the date off the event for good. A verb."
  },
  "eventsDateAddTitle": "Add a date",
  "@eventsDateAddTitle": {
    "description": "Title of the dialog that adds a date to an event: its label, when it starts and ends, and its place."
  },
  "eventsDateEditTitle": "Edit {date}",
  "@eventsDateEditTitle": {
    "description": "Title of the dialog that changes one of an event's dates, which it names by the date's label, or when it starts where it has none.",
    "placeholders": {
      "date": {
        "type": "String",
        "example": "Opening night"
      }
    }
  },
  "eventsDateSave": "Save",
  "@eventsDateSave": {
    "description": "Confirm button of the dialog that changes one of an event's dates. Disabled until something in the dialog changes."
  },
  "eventsDateAddConfirm": "Add",
  "@eventsDateAddConfirm": {
    "description": "Confirm button of the dialog that adds a date to an event. A verb."
  },
  "eventsDateDiscard": "Discard",
  "@eventsDateDiscard": {
    "description": "Button in the dialogs that add a date to an event or change one. Closes the dialog and keeps nothing typed or picked in it."
  },
  "eventsDateEditConfirmedNote": "Attendees aren't told when a confirmed date changes.",
  "@eventsDateEditConfirmedNote": {
    "description": "Note at the top of the dialog that changes one of an event's dates, shown when that date is confirmed. Nobody on the event is notified of the change, so the host may want to tell them."
  },
  "eventsDateConfirmTitle": "Confirm {date}?",
  "@eventsDateConfirmTitle": {
    "description": "Title of the dialog asking to confirm one of an event's proposed dates, which it names by the date's label, or when it starts where it has none.",
    "placeholders": {
      "date": {
        "type": "String",
        "example": "Fri, Nov 6 · 7:30 PM"
      }
    }
  },
  "eventsDateConfirmBody": "A confirmed date can be cancelled, but not set back to proposed.",
  "@eventsDateConfirmBody": {
    "description": "Body of the dialog asking to confirm one of an event's proposed dates. Says what can't be undone: once confirmed, the date can be called off but never made a proposal again."
  },
  "eventsDateDeclineTitle": "Decline {date}?",
  "@eventsDateDeclineTitle": {
    "description": "Title of the dialog asking to decline one of an event's proposed dates, which it names by the date's label, or when it starts where it has none.",
    "placeholders": {
      "date": {
        "type": "String",
        "example": "Fri, Nov 6 · 7:30 PM"
      }
    }
  },
  "eventsDateDeclineBody": "A declined date can't be proposed again.",
  "@eventsDateDeclineBody": {
    "description": "Body of the dialog asking to decline one of an event's proposed dates. Declining is permanent: the date can't be made a proposal again."
  },
  "eventsDateCancelTitle": "Cancel {date}?",
  "@eventsDateCancelTitle": {
    "description": "Title of the dialog asking to call off one of an event's confirmed dates, which it names by the date's label, or when it starts where it has none. Cancel here means call off, not close the dialog.",
    "placeholders": {
      "date": {
        "type": "String",
        "example": "Fri, Nov 6 · 7:30 PM"
      }
    }
  },
  "eventsDateCancelBody": "Everyone who answered this date is told. It can't be confirmed again.",
  "@eventsDateCancelBody": {
    "description": "Body of the dialog asking to call off one of an event's confirmed dates. Says two things, and a translation must keep both: everyone who said whether they could come on that date is notified, and the date can never be confirmed again."
  },
  "eventsDateCancelRemoveBody": "It's cancelled first, so everyone who answered is told, then removed. This can't be undone.",
  "@eventsDateCancelRemoveBody": {
    "description": "Body of the dialog asking to remove one of an event's confirmed dates. A confirmed date is removed in two steps: it is called off first, which notifies everyone who said whether they could come on it, and then taken off the event. Neither can be undone."
  },
  "eventsDateRemoveTitle": "Remove {date}?",
  "@eventsDateRemoveTitle": {
    "description": "Title of the dialog asking to take one of an event's dates off it, which it names by the date's label, or when it starts where it has none.",
    "placeholders": {
      "date": {
        "type": "String",
        "example": "Fri, Nov 6 · 7:30 PM"
      }
    }
  },
  "eventsDateRemoveBody": "This can't be undone.",
  "@eventsDateRemoveBody": {
    "description": "Body of the dialog asking to take a date that isn't confirmed off an event. The removal is permanent."
  },
  "eventsDateReason": "Reason (optional)",
  "@eventsDateReason": {
    "description": "Label of the text field in the dialog that calls off one of an event's dates, for why it is called off. It may be left empty. The reason shows under the date on the event's screen."
  },
  "eventsDateReasonTooLong": "Keep the reason to {max} characters or fewer.",
  "@eventsDateReasonTooLong": {
    "description": "Error under the reason field in the dialog that calls off one of an event's dates, when the reason is longer than the server takes. max is the most it takes, 1,000 today, and a reason of exactly max is accepted.",
    "placeholders": {
      "max": {
        "type": "int",
        "format": "decimalPattern",
        "example": "1000"
      }
    }
  },
  "eventsDateKeep": "Keep date",
  "@eventsDateKeep": {
    "description": "Button in the dialogs that confirm, decline, call off or remove one of an event's dates. Closes the dialog and changes nothing. Deliberately not 'Cancel': calling a date off is one of the actions these dialogs ask about."
  },
  "eventsDateCancelReason": "Reason: {reason}",
  "@eventsDateCancelReason": {
    "description": "Under a called-off date on an event's screen, below its status: why it was called off, as the person who called it off wrote it.",
    "placeholders": {
      "reason": {
        "type": "String",
        "example": "The venue flooded."
      }
    }
  },
  "eventsDateAdded": "Date added",
  "@eventsDateAdded": {
    "description": "Banner on an event's screen once the server has added the date the user asked for."
  },
  "eventsDateSaved": "Date saved",
  "@eventsDateSaved": {
    "description": "Banner on an event's screen once the server has saved the user's changes to one of its dates."
  },
  "eventsDateConfirmed": "Date confirmed",
  "@eventsDateConfirmed": {
    "description": "Banner on an event's screen once the server has confirmed one of its proposed dates."
  },
  "eventsDateDeclined": "Date declined",
  "@eventsDateDeclined": {
    "description": "Banner on an event's screen once the server has declined one of its proposed dates."
  },
  "eventsDateCancelled": "Date cancelled",
  "@eventsDateCancelled": {
    "description": "Banner on an event's screen once the server has called off one of its dates."
  },
  "eventsDateRemoved": "Date removed",
  "@eventsDateRemoved": {
    "description": "Banner on an event's screen once the server has taken one of its dates off it."
  },
  "eventsDateGone": "This date isn't on the event any more.",
  "@eventsDateGone": {
    "description": "Banner on an event's screen when a change to one of its dates found the date gone: someone removed it, or deleted the event, since the screen showed it. The screen has just been refreshed. A warning, not an error, except after removing the date, when it is what was asked."
  },
  "eventsDateRefused": "You can't change this date.",
  "@eventsDateRefused": {
    "description": "Banner on an event's screen when the server refused a change to one of its dates: the user is not allowed to make it, for example because their role on the event changed on another device."
  },
  "eventsDateFailed": "An error occurred while saving this change. You may need to try again.",
  "@eventsDateFailed": {
    "description": "Banner on an event's screen when a change to one of its dates ended without an answer that says what happened, most often because there was no connection. The change may or may not have gone through, so the copy must not say it didn't."
  },
  "eventsDateAddFailed": "An error occurred while adding this date. Check the dates below before adding it again.",
  "@eventsDateAddFailed": {
    "description": "Banner on an event's screen when adding a date ended without an answer that says what happened. The date may have been added all the same, and adding it again would add it twice, so the copy asks the user to look at the dates first, which have just been refreshed. It must not say the date wasn't added."
  },
  "eventsDateFailedUnexpected": "Something went wrong. Check the date below before trying again.",
  "@eventsDateFailedUnexpected": {
    "description": "Banner on an event's screen when a change to one of its dates failed for any reason other than the connection: the server rejected the request, or the app sent nothing, for example because a different account signed in from another tab. Unlike the connection failure it does not invite a retry straight away."
  },
  "eventsTypeAdultsOnly": "Adults only",
  "@eventsTypeAdultsOnly": {
    "description": "The kind of event the host chose, on the event's screen: for adults only."
  },
  "eventsTypeCasualGathering": "Casual gathering",
  "@eventsTypeCasualGathering": {
    "description": "The kind of event the host chose, on the event's screen: a relaxed get-together."
  },
