{
  "@@locale": "en",
  "eventsTitle": "Events",
  "@eventsTitle": {
    "description": "Title of the screen giving an overview of the user's events, and the label of the drawer entry that opens it. Also the title bar of the screen showing one event, whose own title is the heading under it."
  },
  "eventsGroupUpcoming": "Upcoming",
  "@eventsGroupUpcoming": {
    "description": "Heading of the group of events whose date is still ahead, or under way, soonest first. Also the title of the page listing the whole group."
  },
  "eventsGroupPlanning": "Planning",
  "@eventsGroupPlanning": {
    "description": "Heading of the group of events that have no confirmed date yet, because one is being chosen or none has been set. Also the title of the page listing the whole group."
  },
  "eventsGroupPast": "Past",
  "@eventsGroupPast": {
    "description": "Heading of the group of events whose every date is over, most recent first. Also the title of the page listing the whole group."
  },
  "eventsGroupArchived": "Archived",
  "@eventsGroupArchived": {
    "description": "Heading of the group of events the host has archived, latest date first. Also the title of the page listing the whole group."
  },
  "eventsGroupSeeAll": "See all ({count})",
  "@eventsGroupSeeAll": {
    "description": "Button beside a group's heading on the events overview, which shows only the first few events of each group. It opens a page listing every event in the group; the number is how many events the group holds. Screen readers hear eventsGroupSeeAllSpoken instead.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "eventsGroupSeeAllSpoken": "{group}: see all {count, plural, =1{1 event} other{{count} events}}",
  "@eventsGroupSeeAllSpoken": {
    "description": "What a screen reader says for the eventsGroupSeeAll button, which on its own would not say which group it opens or what the number counts. The group is one of the group headings, such as 'Upcoming'.",
    "placeholders": {
      "group": {
        "type": "String",
        "example": "Upcoming"
      },
      "count": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "eventsHomeHeading": "Upcoming events",
  "@eventsHomeHeading": {
    "description": "Heading of the upcoming events section on the home page (#613). The same whether it lists the user's own events or what's coming up that they aren't going to."
  },
  "eventsHomeSeeAll": "See all",
  "@eventsHomeSeeAll": {
    "description": "Link beside the home page's upcoming events (#613), over the user's own events, that opens the events screen. Keep it short: it shares a line with the heading and the row's previous and next buttons, and a long one drops them all below the heading on a narrow screen."
  },
  "eventsHomeSeeAllSpoken": "See all your events",
  "@eventsHomeSeeAllSpoken": {
    "description": "What a screen reader says for eventsHomeSeeAll (#613), because 'See all' alone doesn't say of what."
  },
  "eventsHomePrevious": "Previous events",
  "@eventsHomePrevious": {
    "description": "Tooltip and spoken label of the button on the home page's row of upcoming events (#669) that scrolls the row back to the events before the ones in view."
  },
  "eventsHomeNext": "Next events",
  "@eventsHomeNext": {
    "description": "Tooltip and spoken label of the button on the home page's row of upcoming events (#669) that scrolls the row on to the events after the ones in view."
  },
  "eventsHomeYourEvents": "Your events",
  "@eventsHomeYourEvents": {
    "description": "Link beside the home page's upcoming events (#613) when the user has none of their own listed there, that opens the events screen. Not 'See all', because the events screen doesn't list the rows shown here. Keep it short, as eventsHomeSeeAll."
  },
  "eventsHomeFallbackNote": "You have no upcoming events yet. Here's what's coming up.",
  "@eventsHomeFallbackNote": {
    "description": "Line above the home page's list of upcoming events the user isn't going to (#613), which they can see but aren't on. Says upcoming, not that they aren't going to anything, because they may host or attend an event with no date yet. Doesn't offer to join, because nobody can add themselves to an event yet."
  },
  "eventsHomeEmpty": "Nothing coming up right now.",
  "@eventsHomeEmpty": {
    "description": "Shown in the home page's upcoming events section (#613) when there's nothing to list, whether none are coming up, the device is offline, or a list couldn't be read. Deliberately names no cause, and doesn't say the user has no events: the link beside it leads to the ones this device holds."
  },
  "eventsGroupEmpty": "Nothing here right now.",
  "@eventsGroupEmpty": {
    "description": "Shown on the page listing one group of events when the group has no events left, for example once the last upcoming event has moved to Past."
  },
  "eventsLoading": "Loading your events",
  "@eventsLoading": {
    "description": "Announced and shown while the user's events are still being fetched for the first time."
  },
  "householdEventsLoading": "Loading this household's events",
  "@householdEventsLoading": {
    "description": "Announced and shown while a household's events are still being fetched for the first time, on the household's screen (#503). Names the household's events, because the user's own events are not what is loading."
  },
  "eventsEmptyTitle": "No events yet",
  "@eventsEmptyTitle": {
    "description": "Heading of the empty state shown when the user has no events at all."
  },
  "eventsEmptyBody": "Events you're hosting or invited to show up here.",
  "@eventsEmptyBody": {
    "description": "Body of the empty state shown when the user has no events at all. Says where events come from. The New event button, where there is one, sits under it."
  },
  "eventsError": "Your events couldn't be read.",
  "@eventsError": {
    "description": "Shown when the events kept on this device could not be read at all, so none can be displayed. Not a network failure."
  },
  "eventsErrorBody": "Something went wrong opening them on this device.",
  "@eventsErrorBody": {
    "description": "Body under eventsError, above a button that tries again. Says the failure is on this device, so that the user doesn't go looking for a connection problem."
  },
  "eventsRefreshFailed": "Couldn't refresh your events. What's shown may be out of date.",
  "@eventsRefreshFailed": {
    "description": "Banner shown when the user's events could not be refreshed from the server, for ANY reason: the server was unreachable, or it answered with an error. The events already on this device are still shown. Deliberately does not name a cause, because the screen does not know which one it was."
  },
  "eventsRefreshRetry": "Try again",
  "@eventsRefreshRetry": {
    "description": "Button that asks the server again: for the user's events, on the couldn't-refresh banner and when the events could not be read, for a household's events, on its screen, and for one event, on that event's screen. Kept as a plain retry: nothing here can promise the next attempt will work."
  },
  "eventsRefreshInProgress": "Refreshing…",
  "@eventsRefreshInProgress": {
    "description": "Replaces the couldn't-refresh banner copy while a refresh the user asked for is running, and is the retry button's label while it is disabled, on the events overview, on a household's events and on one event's screen. Shown ONLY for a refresh the user asked for: one started by reconnecting, by resuming the app or by opening the screen is not narrated."
  },
  "householdEventsEmpty": "No upcoming events with a confirmed date.",
  "@householdEventsEmpty": {
    "description": "Shown in a household's events section, on the household's screen under its Events heading (#503), when the household has no upcoming event this person can see. Says 'with a confirmed date' because the list leaves out events still choosing one, so 'No events' would be false."
  },
  "householdEventsRefreshFailed": "Couldn't refresh this household's events. What's shown may be out of date.",
  "@householdEventsRefreshFailed": {
    "description": "Banner above a household's events, on the household's screen (#503), when they could not be refreshed from the server, for ANY reason: the server was unreachable, or it answered with an error. The events already on this device are still shown. Deliberately does not name a cause, because the screen does not know which one it was."
  },
  "householdEventsLoadFailed": "Couldn't load this household's events.",
  "@householdEventsLoadFailed": {
    "description": "Shown in place of a household's events, on the household's screen (#503), when the events kept on this device could not be read at all, so none can be displayed. Not a network failure."
  },
  "eventsWhen": "{date} · {time}",
  "@eventsWhen": {
    "description": "When an event happens, on its row and in the dates on its screen: the day, then the time it starts, for a date in the current year, for example 'Fri, Nov 6 · 7:30 PM'. The time arrives already formatted, in the 12- or 24-hour form the user's device is set to. Reorder or change the punctuation as your language needs.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "MMMEd"
      },
      "time": {
        "type": "String",
        "example": "7:30 PM"
      }
    }
  },
  "eventsWhenWithYear": "{date} · {time}",
  "@eventsWhenWithYear": {
    "description": "eventsWhen for a date in another year, which carries the year, for example 'Wed, Jan 6, 2027 · 7:30 PM'. Reorder or change the punctuation as your language needs.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "yMMMEd"
      },
      "time": {
        "type": "String",
        "example": "7:30 PM"
      }
    }
  },
  "eventsDateBeingChosen": "Date being chosen",
  "@eventsDateBeingChosen": {
    "description": "In place of a date on an event's row, and in the dates on its screen, while the people invited are voting on when it should happen."
  },
  "eventsNoDateYet": "No date yet",
  "@eventsNoDateYet": {
    "description": "In place of a date on an event's row, and in the dates on its screen, when the event has no date set and no vote is choosing one."
  },
  "eventsRsvpAttending": "Going",
  "@eventsRsvpAttending": {
    "description": "An answer to an event's invitation, on the event's row (the user's own) and beside each person in its who's-coming list: they will attend."
  },
  "eventsRsvpMaybe": "Maybe",
  "@eventsRsvpMaybe": {
    "description": "An answer to an event's invitation, on the event's row (the user's own) and beside each person in its who's-coming list: they might attend."
  },
  "eventsRsvpNotAttending": "Not going",
  "@eventsRsvpNotAttending": {
    "description": "An answer to an event's invitation, on the event's row (the user's own) and beside each person in its who's-coming list: they will not attend."
  },
  "eventsRsvpInvited": "Invited",
  "@eventsRsvpInvited": {
    "description": "On the event's row (the user's own) and beside each person in its who's-coming list: they were invited and have not answered yet."
  },
  "eventsDetailSeparator": " · ",
  "@eventsDetailSeparator": {
    "description": "Shown between the parts of one line about an event, for example 'Back room · The Smiths · Going' on its row, 'Strategy night · Scheduled' on its screen, or 'Host · Going' beside a person coming to it. Keep or drop the surrounding spaces as your language's punctuation needs."
  },
  "eventsDetailSpokenSeparator": ", ",
  "@eventsDetailSpokenSeparator": {
    "description": "Joins the same parts when a screen reader reads such a line aloud, in place of eventsDetailSeparator, whose symbol would be read out. It should sound like a short pause between list items."
  },
  "eventsCreate": "New event",
  "@eventsCreate": {
    "description": "Label of the buttons that start creating an event: on the events overview, in its empty state, and on the page of each group of events."
  },
  "eventsDetailLoading": "Loading this event",
  "@eventsDetailLoading": {
    "description": "Announced and shown on the screen for one event while it is read for the first time, before anything about it is on this device."
  },
  "eventsDetailDates": "Dates",
  "@eventsDetailDates": {
    "description": "Heading of the section of an event's screen listing when it happens: each of its dates, or the dates proposed while a vote chooses one."
  },
  "eventsDetailAttendees": "Who's coming",
  "@eventsDetailAttendees": {
    "description": "Heading of the section of an event's screen listing the people invited to it, each with their role and their answer."
  },
  "eventsAttendeesGoing": "Going ({count})",
  "@eventsAttendeesGoing": {
    "description": "Heading of a group in the who's-coming section of an event's screen, over the people who answered Going, with how many they are. Screen readers announce it as a heading.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "eventsAttendeesMaybe": "Maybe ({count})",
  "@eventsAttendeesMaybe": {
    "description": "Heading of a group in the who's-coming section of an event's screen, over the people who answered Maybe, with how many they are. Screen readers announce it as a heading.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "eventsAttendeesNotAnswered": "Not answered ({count})",
  "@eventsAttendeesNotAnswered": {
    "description": "Heading of a group in the who's-coming section of an event's screen, over the people who were invited and have not answered yet, with how many they are. Screen readers announce it as a heading.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "eventsAttendeesNotGoing": "Not going ({count})",
  "@eventsAttendeesNotGoing": {
    "description": "Heading of a group in the who's-coming section of an event's screen, over the people who answered Not going, with how many they are. Screen readers announce it as a heading.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "eventsAttendeesOther": "Other answers ({count})",
  "@eventsAttendeesOther": {
    "description": "Heading of a group in the who's-coming section of an event's screen, over the people whose answer this version of the app does not recognise, with how many they are. Screen readers announce it as a heading.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "eventsRsvpQuestion": "Are you coming?",
  "@eventsRsvpQuestion": {
    "description": "In the who's-coming section of an event's screen, above the user's own three answer chips (Going, Maybe, Not going). Also the accessible name of that group of chips, which screen readers read before its chips."
  },
  "eventsRsvpAddNote": "Add a note",
  "@eventsRsvpAddNote": {
    "description": "Button under the user's own answer chips in the who's-coming section of an event's screen, when they have left no note with their answer. Opens a dialog to write a short note for the host and the others invited to read, such as 'Running late'."
  },
  "eventsRsvpEditNote": "Edit note",
  "@eventsRsvpEditNote": {
    "description": "The same button as eventsRsvpAddNote, when the user has already left a note with their answer. Opens a dialog to change or remove it."
  },
  "eventsRsvpAnswerInProgress": "{answer}, saving your answer…",
  "@eventsRsvpAnswerInProgress": {
    "description": "What a screen reader says for one of the user's own answer chips (Going, Maybe, Not going) on an event's screen while the answer it sent is being saved. The chip still shows only the answer, with a spinner, and can't be pressed until saving ends. The answer is one of eventsRsvpAttending, eventsRsvpMaybe or eventsRsvpNotAttending.",
    "placeholders": {
      "answer": {
        "type": "String",
        "example": "Maybe"
      }
    }
  },
  "eventsRsvpNoteInProgress": "Saving your note…",
  "@eventsRsvpNoteInProgress": {
    "description": "Shown in place of eventsRsvpAddNote or eventsRsvpEditNote on the note button, beside a spinner, while the note the user saved is being sent. The button can't be pressed until saving ends."
  },
  "eventsRsvpNotGoingTitle": "Not going?",
  "@eventsRsvpNotGoingTitle": {
    "description": "Title of the dialog that opens when the user taps Not going among their own answer chips on an event's screen, asking them to confirm that answer before it is sent."
  },
  "eventsRsvpNotGoingBody": "Nominations of games you're bringing will be paused, and those games will come off every date still to come. Your votes stop counting. Saying you're coming later brings the nominations back, but not the games.",
  "@eventsRsvpNotGoingBody": {
    "description": "Body of the Not going dialog on an event's screen. Says four things, and a translation must keep all four: nominations of the games the user is bringing are paused, whoever made them; those games are taken off each of the event's dates that hasn't happened yet; the user's votes no longer count; and answering Going or Maybe later brings the nominations back, but does not put the games back on those dates."
  },
  "eventsRsvpNotGoingKeep": "Keep my answer",
  "@eventsRsvpNotGoingKeep": {
    "description": "Button in the Not going dialog on an event's screen that closes it, sends nothing, and leaves the user's answer as it was. Deliberately not 'Cancel', which here could read as cancelling the event."
  },
  "eventsRsvpNotGoingConfirm": "Not going",
  "@eventsRsvpNotGoingConfirm": {
    "description": "Confirm button of the Not going dialog on an event's screen, shown in the error colour. Sends the user's answer that they are not going, with the consequences the dialog's body describes."
  },
  "eventsRsvpNoteTitle": "Your note",
  "@eventsRsvpNoteTitle": {
    "description": "Title of the dialog on an event's screen where the user writes, changes or removes the short note that goes with their answer to the invitation, such as 'Running late'."
  },
  "eventsRsvpNoteBody": "Everyone who can see who's coming can read it.",
  "@eventsRsvpNoteBody": {
    "description": "Body of the note dialog on an event's screen, above the note's field: the note shows on the user's row in the who's-coming section, to everyone allowed to see that section, such as the host and the others invited."
  },
  "eventsRsvpNoteLabel": "Note",
  "@eventsRsvpNoteLabel": {
    "description": "Label of the text field in the note dialog on an event's screen, holding the note that goes with the user's answer. Left empty, saving removes the note."
  },
  "eventsRsvpNoteKeep": "Cancel",
  "@eventsRsvpNoteKeep": {
    "description": "Button in the note dialog on an event's screen that closes it and leaves the note as it was."
  },
  "eventsRsvpNoteSave": "Save note",
  "@eventsRsvpNoteSave": {
    "description": "Button in the note dialog on an event's screen that sends the note, with the user's current answer, to the server. An empty field removes the note."
  },
  "eventsRsvpSaved": "Your answer is saved.",
  "@eventsRsvpSaved": {
    "description": "Banner on an event's screen once the server has saved the user's answer to the invitation (Going, Maybe or Not going) or the note that goes with it."
  },
  "eventsRsvpGone": "You're no longer on this event, or it was deleted.",
  "@eventsRsvpGone": {
    "description": "Banner on an event's screen when sending the user's answer found neither the event nor the user's place on it: the event was deleted, or someone removed the user from it, perhaps on another device. The server doesn't say which, and the screen reads the event again, which shows which. A warning, not an error."
  },
  "eventsRsvpRefused": "You can't answer for this event any more.",
  "@eventsRsvpRefused": {
    "description": "Banner on an event's screen when the server refused the user's answer to the invitation: they are no longer allowed to answer, for example because their role on the event changed on another device. The screen reads the event again."
  },
  "eventsRsvpChanged": "This event changed before your answer went through. Check it below before trying again.",
  "@eventsRsvpChanged": {
    "description": "Banner on an event's screen when the user's answer to the invitation wasn't sent or was turned down because the event had changed since the screen showed it: for example, it was cancelled or archived, or the user was taken off it, on another device while the Not going or note dialog was open. The screen may be reading the event again as it shows, and the copy must not say the event below is up to date. A warning, not an error."
  },
  "eventsRsvpFailed": "An error occurred while sending your answer. You may need to try again.",
  "@eventsRsvpFailed": {
    "description": "Banner on an event's screen when sending the user's answer to the invitation, or their note, ended without an answer that says what happened, most often because there was no connection. It may or may not have been saved, so the copy must not say it wasn't."
  },
  "eventsRsvpFailedUnexpected": "Something went wrong. Check your answer below before trying again.",
  "@eventsRsvpFailedUnexpected": {
    "description": "Banner on an event's screen when sending the user's answer to the invitation, or their note, failed for any reason other than the connection: the server rejected it, the server answered with something the app could not read, or the app sent nothing, for example because a different account signed in from another tab. An answer the app could not read may follow one that was saved, and the screen reads the event again, so the copy must not say it wasn't saved. Unlike the connection failure it does not invite a retry straight away."
  },
  "eventsAttendeeSomeone": "this person",
  "@eventsAttendeeSomeone": {
    "description": "Stands in for a person's name, inside another sentence, in the who's-coming section's menus, dialogs and banners on an event's screen, when the person has no name the app can show. It goes in place of {name} in the other eventsAttendee… strings where the name falls mid-sentence, so it is lower case where the language allows, on the Games tab in eventsGamesPersonLeftOut, eventsTakeBackTheirsConfirmTitle and the eventsGamesTheirs… banners (eventsGamesTheirsTakenBack and the eventsGamesTheirsStillSupplies… ones), and in its Nominations section in eventsNominatedBy, eventsNominationFrom and eventsNominationPaused. Where a sentence starts with the person, eventsAttendeeSomeoneStart is used instead."
  },
  "eventsAttendeeSomeoneStart": "This person",
  "@eventsAttendeeSomeoneStart": {
    "description": "Stands in for a person's name where a sentence on an event's screen starts with them, when the person has no name the app can show: the same as eventsAttendeeSomeone, written as a sentence's first words. It goes in place of {name} in eventsAttendeeRemoveGone, eventsAttendeeAnswerGone, eventsAttendeeAddAlreadyOn, eventsAttendeeAddRefused and eventsAddAttendeeAlreadyOn. On the Games tab it goes in place of {name} in eventsGamesTheirs, and names that person on their chip in the Whose games list (eventsGamesPeopleTitle) and under the search field while their games are kept. In the who-voted list of a nominated game it goes in place of {name} in eventsVoterLine and eventsVoterLineNotCounting."
  },
  "eventsAttendeeActions": "Actions for {name}",
  "@eventsAttendeeActions": {
    "description": "Tooltip and accessible name of the three-dot button beside a person in the who's-coming section of an event's screen. Opens a menu to set their answer to the invitation for them (Going, Maybe or Not going), or to remove them from the event. Every such person has one, so it names them: {name} is their name, or eventsAttendeeSomeone.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Ada Lovelace"
      }
    }
  },
  "eventsAttendeeRemove": "Remove from event",
  "@eventsAttendeeRemove": {
    "description": "Last item in the menu beside another person in the who's-coming section of an event's screen. Opens a dialog asking to confirm taking that person off the event."
  },
  "eventsAttendeeRemoveTitle": "Remove {name}?",
  "@eventsAttendeeRemoveTitle": {
    "description": "Title of the dialog asking the user to confirm removing a person from an event, opened from the menu beside another person in the who's-coming section of an event's screen. {name} is that person's name, or eventsAttendeeSomeone.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Ada Lovelace"
      }
    }
  },
  "eventsAttendeeRemoveBody": "Nominations of games {name} is bringing will be paused, and those games will come off every date still to come. Their votes stop counting. Adding them back brings the nominations back, but not the games.",
  "@eventsAttendeeRemoveBody": {
    "description": "Body of the remove dialog on an event's screen. Says four things, and a translation must keep all four: nominations of the games the person is bringing are paused, whoever made them; those games are taken off each of the event's dates that hasn't happened yet; the person's votes no longer count; and adding them to the event again brings the nominations back, but does not put the games back on those dates. Nominations the person made of games other people are bringing stay open, so it doesn't mention them.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Ada Lovelace"
      }
    }
  },
  "eventsAttendeeRemoveKeep": "Keep them",
  "@eventsAttendeeRemoveKeep": {
    "description": "Button in the remove dialog on an event's screen that closes it, sends nothing, and leaves the person on the event. Deliberately not 'Cancel', which here could read as cancelling the event."
  },
  "eventsAttendeeRemoveConfirm": "Remove",
  "@eventsAttendeeRemoveConfirm": {
    "description": "Confirm button of the remove dialog on an event's screen, shown in the error colour. Takes the person off the event, with the consequences the dialog's body describes."
  },
  "eventsAttendeeNotGoingTitle": "Mark {name} as not going?",
  "@eventsAttendeeNotGoingTitle": {
    "description": "Title of the dialog that opens when the user picks Not going from the menu beside another person in the who's-coming section of an event's screen, asking them to confirm that answer for that person before it is sent: they are recording someone else's answer, such as one given in person. {name} is that person's name, or eventsAttendeeSomeone.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Ada Lovelace"
      }
    }
  },
  "eventsAttendeeNotGoingBody": "Nominations of games {name} is bringing will be paused, and those games will come off every date still to come. Their votes stop counting. Changing the answer back brings the nominations back, but not the games.",
  "@eventsAttendeeNotGoingBody": {
    "description": "Body of that Not going dialog. Says four things, and a translation must keep all four: nominations of the games the person is bringing are paused, whoever made them; those games are taken off each of the event's dates that hasn't happened yet; the person's votes no longer count; and changing their answer to Going or Maybe later brings the nominations back, but does not put the games back on those dates.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Ada Lovelace"
      }
    }
  },
  "eventsAttendeeNotGoingKeep": "Keep their answer",
  "@eventsAttendeeNotGoingKeep": {
    "description": "Button in that Not going dialog that closes it, sends nothing, and leaves the person's answer as it was. Deliberately not 'Cancel', which here could read as cancelling the event. Its confirm button is eventsRsvpNotGoingConfirm."
  },
  "eventsAttendeeRemoved": "Removed {name}.",
  "@eventsAttendeeRemoved": {
    "description": "Banner on an event's screen once the server has taken the person off the event, after the user confirmed the remove dialog. {name} is that person's name, or eventsAttendeeSomeone.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Ada Lovelace"
      }
    }
  },
  "eventsAttendeeRemoveGone": "{name} was already off the event.",
  "@eventsAttendeeRemoveGone": {
    "description": "Banner on an event's screen when removing a person found them already gone: someone removed them, perhaps on another device, or the event itself is gone. Shown as a success, since they are off the event either way. The screen reads the event again, which shows the roster as it is. {name} is that person's name, or eventsAttendeeSomeoneStart.",
    "placeholders": {
      "name": {
