  "eventsAttendeeRosterChanged": "The roster changed before that went through. Check it below before trying again.",
  "@eventsAttendeeRosterChanged": {
    "description": "Banner on an event's screen when adding or removing a person, or setting their answer, wasn't sent or was turned down because the event or its people had changed since the screen showed them: for example, the person was removed, the event was cancelled, or the user's own role changed, on another device while a dialog was open. 'The roster' is the event's who's-coming list. The screen may be reading the event again as it shows, so the copy must not say the list below is up to date. A warning, not an error."
  },
  "eventsAttendeeWriteFailed": "Couldn't reach the server. Check the roster below before trying again.",
  "@eventsAttendeeWriteFailed": {
    "description": "Banner on an event's screen when adding or removing a person, or setting their answer, ended without an answer that says what happened, most often because there was no connection. It may or may not have gone through, so the copy must not say it didn't. 'The roster' is the event's who's-coming list. The screen starts reading the event again as the banner shows, and with the server out of reach that read often fails too, so the copy must not say the list below is up to date."
  },
  "eventsAttendeeWriteFailedUnexpected": "Something went wrong. Check the roster below before trying again.",
  "@eventsAttendeeWriteFailedUnexpected": {
    "description": "Banner on an event's screen when adding or removing a person, or setting their answer, failed for any reason other than the connection: the server rejected it, answered with something the app could not read, or the app sent nothing, for example because a different account signed in from another tab. It may have gone through, so the copy must not say it didn't. 'The roster' is the event's who's-coming list. The screen reads the event again after most of these, but not when nothing was sent, so the copy must not say the list below is up to date."
  },
  "eventsAddAttendee": "Add people",
  "@eventsAddAttendee": {
    "description": "Button in the who's-coming section of an event's screen, shown to someone who may add people to the event, such as its host. Opens the Add people page (eventsAddAttendeeTitle), where they find someone with an account and pick the role they'll have."
  },
  "eventsAddAttendeeInProgress": "Adding…",
  "@eventsAddAttendeeInProgress": {
    "description": "Shown in place of eventsAddAttendee on that button, beside a spinner, once the user has picked someone on the Add people page and the event's screen is sending the add. The button can't be pressed until it ends, and a banner then says how it went."
  },
  "eventsAddAttendeeTitle": "Add people",
  "@eventsAddAttendeeTitle": {
    "description": "Title of the page, opened from an event's screen, where the user finds someone with an account by searching for them, picks the role they'll have at the event, and adds them. One person at a time; they are added as invited, and answer for themselves."
  },
  "eventsAddAttendeeRole": "Role",
  "@eventsAddAttendeeRole": {
    "description": "Heading on the Add people page over the roles the user may give the person they add, one to pick, each with a line on what it lets them do. 'Role' is the part the person will have at the event: participant, guest, spectator and so on."
  },
  "eventsAddAttendeeAdd": "Add",
  "@eventsAddAttendeeAdd": {
    "description": "Last button on the Add people page. Adds the person picked from the search to the event, with the role picked under the Role heading, and goes back to the event, which says how it went. Unavailable until someone is picked, and while offline."
  },
  "eventsAddAttendeeAlreadyOn": "{name} is already on this event.",
  "@eventsAddAttendeeAlreadyOn": {
    "description": "Note under the search field on the Add people page, announced as it appears, when the user picks someone from the search who is already on the event. They aren't picked, and the user can search for someone else. {name} is that person's name, or eventsAttendeeSomeoneStart.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Ada Lovelace"
      }
    }
  },
  "eventsRoleDescriptionParticipant": "Answers, votes on dates and games, and brings games.",
