{
  "@@locale": "en",
  "collectionListTitle": "Collection",
  "@collectionListTitle": {
    "description": "Title of the screen listing the games the user owns, and the label of the drawer entry that opens it."
  },
  "collectionListLoading": "Loading your collection…",
  "@collectionListLoading": {
    "description": "Announced and shown while the collection is still being fetched for the first time."
  },
  "collectionListEmptyTitle": "No games yet",
  "@collectionListEmptyTitle": {
    "description": "Heading of the empty state shown when the user's collection holds no games."
  },
  "collectionListEmptyBody": "Games you add from the catalog will appear here.",
  "@collectionListEmptyBody": {
    "description": "Body of the empty state shown when the user's collection holds no games. Games are added from a game's screen in the catalog, which the Browse games button below it opens where the catalog is available."
  },
  "collectionListBrowse": "Browse games",
  "@collectionListBrowse": {
    "description": "Button on the empty collection's state that opens the catalog, where a game can be added to the collection from its screen."
  },
  "collectionListRefreshFailed": "This list may be out of date — we couldn't refresh it.",
  "@collectionListRefreshFailed": {
    "description": "Banner shown when the collection could not be refreshed from the server, for ANY reason: the server was unreachable, or it answered with an error. The cached games are still shown. Deliberately does not name a cause — the screen does not know which one it was."
  },
  "collectionRefreshRetry": "Try again",
  "@collectionRefreshRetry": {
    "description": "Button on the refresh banner that asks the server for the collection again. Kept as a plain retry: the refresh reports one undifferentiated failure, so nothing here can promise the next attempt will work."
  },
  "collectionRefreshInProgress": "Refreshing…",
  "@collectionRefreshInProgress": {
    "description": "Replaces the couldn't-refresh banner copy while a refresh the user asked for is running, and is the retry button's label while it is disabled. Shown ONLY for a user-initiated retry — a refresh triggered by reconnecting, by resuming the app or by opening the screen is not narrated."
  },
  "collectionListError": "We couldn't open your collection.",
  "@collectionListError": {
    "description": "Shown when the local collection could not be read at all, so no games can be displayed."
  },
  "collectionListTitleWithSubtitle": "{title}: {subtitle}",
  "@collectionListTitleWithSubtitle": {
    "description": "A game's name on its collection row when the game also has a subtitle, for example 'Catan: Seafarers'. Rows are sorted by the title alone, so the subtitle is often what tells two rows apart. Reorder or change the punctuation as your language needs.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Catan"
      },
      "subtitle": {
        "type": "String",
        "example": "Seafarers"
      }
    }
  },
  "collectionListDetailSeparator": " · ",
  "@collectionListDetailSeparator": {
    "description": "Shown between the parts of a collection row's second line, for example 'Board game · Physical · 2 copies'. Keep or drop the surrounding spaces as your language's punctuation needs."
  },
  "collectionListDetailSpokenSeparator": ", ",
  "@collectionListDetailSpokenSeparator": {
    "description": "Joins the same parts when a screen reader reads a collection row aloud, in place of collectionListDetailSeparator, whose symbol would be read out. It should sound like a short pause between list items."
  },
  "collectionListMediumPhysical": "Physical",
  "@collectionListMediumPhysical": {
    "description": "A physical copy of a game, such as a boxed board game or a game disc. Shown on a collection row for a copy the user owns, and as a choice in the add sheet's physical-or-digital field."
  },
  "collectionListMediumDigital": "Digital",
  "@collectionListMediumDigital": {
    "description": "A digital copy of a game, such as a download or an app. Shown on a collection row for a copy the user owns, and as a choice in the add sheet's physical-or-digital field."
  },
  "collectionListQuantity": "{count, plural, =1{1 copy} other{{count} copies}}",
  "@collectionListQuantity": {
    "description": "On a collection row: how many copies of the game the user owns. Shown only when it is more than one.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "collectionListRating": "{rating}/10",
  "@collectionListRating": {
    "description": "On a collection row: the user's own rating of the game, out of ten. The short visual form; screen readers hear collectionListRatingSpoken instead.",
    "placeholders": {
      "rating": {
        "type": "int",
        "example": "7"
      }
    }
  },
  "collectionListRatingSpoken": "Rated {rating} out of 10",
  "@collectionListRatingSpoken": {
    "description": "What a screen reader says for the user's own rating of a game on a collection row, in place of the short visual form '7/10'.",
    "placeholders": {
      "rating": {
        "type": "int",
        "example": "7"
      }
    }
  },
  "collectionListLastPlayed": "Last played {date}",
  "@collectionListLastPlayed": {
    "description": "On a collection row: the date the user last played the game.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "yMMMd"
      }
    }
  },
  "collectionListFavorite": "Favorite",
  "@collectionListFavorite": {
    "description": "Spoken by screen readers for the heart icon on a collection row, which marks a game the user has favorited."
  },
  "collectionStatsHeading": "Your stats",
  "@collectionStatsHeading": {
    "description": "Heading of the home page's card of game counts."
  },
  "collectionStatsOwned": "{count, plural, =1{1 game in your collection} other{{count} games in your collection}}",
  "@collectionStatsOwned": {
    "description": "On the home page's stats card: how many different games the user's collection holds. A game owned in two forms, such as boxed and digital, counts once.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "collectionStatsHouseholds": "{count, plural, =1{1 game across your households} other{{count} games across your households}}",
  "@collectionStatsHouseholds": {
    "description": "On the home page's stats card: how many different games the members of the user's households have shared with those households, the user's own included. A game several members own counts once.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "collectionStatsCreateOrJoin": "Create or join a household",
  "@collectionStatsCreateOrJoin": {
    "description": "A link on the home page's stats card, shown to a user who is in no household. It opens the households screen, where they can start one."
  },
  "addToCollectionTitle": "Add {title} ({platform})",
  "@addToCollectionTitle": {
    "description": "Heading of the sheet that adds a game to the user's collection, naming the game and the platform it is added on, for example \"Add Wingspan (Switch)\". Read by screen readers as the sheet's heading.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Wingspan"
      },
      "platform": {
        "type": "String",
        "example": "Switch"
      }
    }
  },
  "addToCollectionMediumLabel": "Physical or digital",
  "@addToCollectionMediumLabel": {
    "description": "Label of the add sheet's required choice between a physical copy (a boxed game, a disc) and a digital one (a download, an app)."
  },
  "addToCollectionMediumHint": "Choose one",
  "@addToCollectionMediumHint": {
    "description": "Shown in the add sheet's physical-or-digital field until the user picks one."
  },
  "addToCollectionMediumRequired": "Choose physical or digital.",
  "@addToCollectionMediumRequired": {
    "description": "Error under the add sheet's physical-or-digital field when the user submits without picking one."
  },
  "addToCollectionQuantityLabel": "Copies",
  "@addToCollectionQuantityLabel": {
    "description": "Label of the add sheet's field for how many copies the user is adding. Starts at 1."
  },
  "addToCollectionQuantityInvalid": "Enter a whole number, 1 or more.",
  "@addToCollectionQuantityInvalid": {
    "description": "Error under the add sheet's copies field when what was typed is not a whole number of at least 1: empty, zero, negative, a fraction or not a number."
  },
  "addToCollectionQuantityTooMany": "That's more copies than can be stored.",
  "@addToCollectionQuantityTooMany": {
    "description": "Error under the add sheet's copies field when the copies being added, together with any already in the collection, are more than the server can store (over 2,147,483,647). A storage limit, not a rule about how many copies a person may own."
  },
  "addToCollectionQuantityDecrease": "One fewer copy",
  "@addToCollectionQuantityDecrease": {
    "description": "Screen-reader name and tooltip of the minus button beside the add sheet's copies field. It lowers the copies by one, not below 1."
  },
  "addToCollectionQuantityIncrease": "One more copy",
  "@addToCollectionQuantityIncrease": {
    "description": "Screen-reader name and tooltip of the plus button beside the add sheet's copies field. It raises the copies by one."
  },
  "addToCollectionQuantityStepped": "{count, plural, =1{1 copy} other{{count} copies}}",
  "@addToCollectionQuantityStepped": {
    "description": "Announced to a screen reader, not shown, after the user presses the minus or plus button beside the add sheet's copies field: the copies the field now holds.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "addToCollectionRatingLabel": "Your rating (optional)",
  "@addToCollectionRatingLabel": {
    "description": "Label of the add sheet's optional rating, a whole number from 1 to 10."
  },
  "addToCollectionRatingNone": "No rating",
  "@addToCollectionRatingNone": {
    "description": "The add sheet's rating choice that leaves the game unrated. The default."
  },
  "addToCollectionRatingValue": "{rating} out of 10",
  "@addToCollectionRatingValue": {
    "description": "One of the add sheet's rating choices, for example \"7 out of 10\".",
    "placeholders": {
      "rating": {
        "type": "int",
        "example": "7"
      }
    }
  },
  "addToCollectionCommentLabel": "Comment (optional)",
  "@addToCollectionCommentLabel": {
    "description": "Label of the add sheet's optional free-text comment about the game."
  },
  "addToCollectionHavePhysical": "{count, plural, =1{You have 1 physical copy.} other{You have {count} physical copies.}}",
  "@addToCollectionHavePhysical": {
    "description": "On the add sheet, once the user picks Physical: how many physical copies of this game on this platform are already in their collection. Adding more raises that number.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "addToCollectionHaveDigital": "{count, plural, =1{You have 1 digital copy.} other{You have {count} digital copies.}}",
  "@addToCollectionHaveDigital": {
    "description": "On the add sheet, once the user picks Digital: how many digital copies of this game on this platform are already in their collection. Adding more raises that number.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "addToCollectionMakes": "Adding {adding} makes {total}.",
  "@addToCollectionMakes": {
    "description": "Follows the you-have sentence on the add sheet: the copies being added and the total they make with those already there, for example \"Adding 1 makes 3.\"",
    "placeholders": {
      "adding": {
        "type": "int",
        "example": "1"
      },
      "total": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "addToCollectionSubmit": "Add to collection",
  "@addToCollectionSubmit": {
    "description": "The add sheet's submit button."
  },
  "addToCollectionInProgress": "Adding…",
  "@addToCollectionInProgress": {
    "description": "Replaces the add sheet's submit label while the add is being saved, and is the disabled button's accessible name meanwhile."
  },
  "addToCollectionFailedTitle": "Couldn't add the game",
  "@addToCollectionFailedTitle": {
    "description": "Heading of the banner above the add sheet's submit button when the add failed. The sheet stays open with what the user entered."
  },
  "addToCollectionFailedBody": "Nothing was saved. Try again.",
  "@addToCollectionFailedBody": {
    "description": "Body of the banner above the add sheet's submit button when the add failed: nothing reached the collection, and submitting again retries it."
  },
  "addToCollectionQueued": "Added {title} to your collection on this device. It hasn't reached the server yet.",
  "@addToCollectionQueued": {
    "description": "Shown briefly on the game's screen after the add sheet closes with the game added on this device but not yet confirmed by the server: it couldn't be reached, or an earlier change to the same entry is still waiting. Must not promise when it will reach the server: the native app sends it later on its own, but the web app has nothing that does yet (#447).",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Wingspan"
      }
    }
  },
  "addToCollectionRefused": "The server didn't accept {title}. It's saved on this device: review it from the home screen to try again or discard it.",
  "@addToCollectionRefused": {
    "description": "Shown briefly on the game's screen after the add sheet closes when the server refused the add, so it will not sync on its own (#190). Points the user at the notice on the home screen, which opens the screen where changes that couldn't sync can be retried or discarded. Must not promise that it will sync later.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Wingspan"
      }
    }
  },
  "addToCollectionAdded": "Added {title} to your collection.",
  "@addToCollectionAdded": {
    "description": "Shown briefly on the game's screen after the add sheet closes with the game added and confirmed by the server.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Wingspan"
      }
    }
  }
}
