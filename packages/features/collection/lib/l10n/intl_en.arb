{
  "@@locale": "en",
  "collectionListTitle": "Collection",
  "@collectionListTitle": {
    "description": "Title of the screen listing the games the user owns, and the label of the drawer entry that opens it."
  },
  "collectionListLoading": "Loading your collection…",
  "@collectionListLoading": {
    "description": "Announced and shown while the collection is still being fetched for the first time."
  },
  "collectionListEmptyTitle": "No games yet",
  "@collectionListEmptyTitle": {
    "description": "Heading of the empty state shown when the user's collection holds no games."
  },
  "collectionListEmptyBody": "Games you add from the catalog will appear here.",
  "@collectionListEmptyBody": {
    "description": "Body of the empty state shown when the user's collection holds no games. Games are added from a game's screen in the catalog, which the Browse games button below it opens where the catalog is available."
  },
  "collectionListBrowse": "Browse games",
  "@collectionListBrowse": {
    "description": "Button on the empty collection's state that opens the catalog, where a game can be added to the collection from its screen."
  },
  "collectionListRefreshFailed": "This list may be out of date — we couldn't refresh it.",
  "@collectionListRefreshFailed": {
    "description": "Banner shown when the collection could not be refreshed from the server, for ANY reason: the server was unreachable, or it answered with an error. The cached games are still shown. Deliberately does not name a cause — the screen does not know which one it was."
  },
  "collectionRefreshRetry": "Try again",
  "@collectionRefreshRetry": {
    "description": "Button on the refresh banner that asks the server for the collection again. Kept as a plain retry: the refresh reports one undifferentiated failure, so nothing here can promise the next attempt will work."
  },
  "collectionRefreshInProgress": "Refreshing…",
  "@collectionRefreshInProgress": {
    "description": "Replaces the couldn't-refresh banner copy while a refresh the user asked for is running, and is the retry button's label while it is disabled. Shown ONLY for a user-initiated retry — a refresh triggered by reconnecting, by resuming the app or by opening the screen is not narrated."
  },
  "collectionListError": "We couldn't open your collection.",
  "@collectionListError": {
    "description": "Shown when the local collection could not be read at all, so no games can be displayed."
  },
  "collectionListTitleWithSubtitle": "{title}: {subtitle}",
  "@collectionListTitleWithSubtitle": {
    "description": "A game's name on its collection row when the game also has a subtitle, for example 'Catan: Seafarers'. Rows are sorted by the title alone, so the subtitle is often what tells two rows apart. Reorder or change the punctuation as your language needs.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Catan"
      },
      "subtitle": {
        "type": "String",
        "example": "Seafarers"
      }
    }
  },
  "collectionListDetailSeparator": " · ",
  "@collectionListDetailSeparator": {
    "description": "Shown between the parts of a collection row's second line, for example 'Board game · Physical · 2 copies'. Keep or drop the surrounding spaces as your language's punctuation needs."
  },
  "collectionListDetailSpokenSeparator": ", ",
  "@collectionListDetailSpokenSeparator": {
    "description": "Joins the same parts when a screen reader reads a collection row aloud, in place of collectionListDetailSeparator, whose symbol would be read out. It should sound like a short pause between list items. It also joins the copies listed for a game owned more than once (collectionListStackCopies), where it is shown as well as read."
  },
  "collectionLayoutList": "List",
  "@collectionLayoutList": {
    "description": "Tooltip and spoken name of the segment on the collection's layout toggle that shows the games as rows, one per line."
  },
  "collectionLayoutThumbnails": "Thumbnails",
  "@collectionLayoutThumbnails": {
    "description": "Tooltip and spoken name of the segment on the collection's layout toggle that shows the games as a grid of covers, each opening its collection entry."
  },
  "collectionListMediumPhysical": "Physical",
  "@collectionListMediumPhysical": {
    "description": "A physical copy of a game, such as a boxed board game or a game disc. Shown on a collection row and on a collection entry's detail for a copy the user owns, and as a choice in the add sheet's Medium field."
  },
  "collectionListMediumDigital": "Digital",
  "@collectionListMediumDigital": {
    "description": "A digital copy of a game, such as a download or an app. Shown on a collection row and on a collection entry's detail for a copy the user owns, and as a choice in the add sheet's Medium field."
  },
  "collectionListQuantity": "{count, plural, =1{1 copy} other{{count} copies}}",
  "@collectionListQuantity": {
    "description": "How many copies of the game the user owns. On a collection row it is shown only when it is more than one; on a collection entry's detail it is always shown.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "collectionListRating": "{rating}/10",
  "@collectionListRating": {
    "description": "On a collection row and a collection entry's detail: the user's own rating of the game, out of ten. The short visual form; screen readers hear collectionListRatingSpoken instead.",
    "placeholders": {
      "rating": {
        "type": "int",
        "example": "7"
      }
    }
  },
  "collectionListRatingSpoken": "Rated {rating} out of 10",
  "@collectionListRatingSpoken": {
    "description": "What a screen reader says for the user's own rating of a game on a collection row or a collection entry's detail, in place of the short visual form '7/10'.",
    "placeholders": {
      "rating": {
        "type": "int",
        "example": "7"
      }
    }
  },
  "collectionListLastPlayed": "Last played {date}",
  "@collectionListLastPlayed": {
    "description": "On a collection row and a collection entry's detail: the date the user last played the game.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "yMMMd"
      }
    }
  },
  "collectionListFavorite": "Favorite",
  "@collectionListFavorite": {
    "description": "Marks a game the user has favorited. Spoken by screen readers for the heart icon on a collection row, and shown beside the same icon on a collection entry's detail."
  },
  "collectionListStackCopies": "{count, plural, other{{count} copies}}: {platforms}",
  "@collectionListStackCopies": {
    "description": "On the collection row or cover of a game the user owns more than once, on different platforms or as both a physical and a digital copy: how many copies, then which, for example '2 copies: Tabletop, Steam'. Shown under the game's name on a row, and read by screen readers after the game's name on a row and on a cover. {count} is always two or more. {platforms} lists each copy's platform, with its medium where two copies share a platform (collectionPickerEntryWithMedium), joined by collectionListDetailSpokenSeparator.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      },
      "platforms": {
        "type": "String",
        "example": "Tabletop, Steam"
      }
    }
  },
  "collectionStatsHeading": "Your stats",
  "@collectionStatsHeading": {
    "description": "Heading of the home page's card of game counts."
  },
  "collectionStatsOwned": "{count, plural, =1{1 game in your collection} other{{count} games in your collection}}",
  "@collectionStatsOwned": {
    "description": "On the home page's stats card: how many different games the user's collection holds. A game owned in two forms, such as boxed and digital, counts once.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "collectionStatsHouseholds": "{count, plural, =1{1 game across your households} other{{count} games across your households}}",
  "@collectionStatsHouseholds": {
    "description": "On the home page's stats card: how many different games the members of the user's households have shared with those households, the user's own included. A game several members own counts once.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "collectionStatsCreateOrJoin": "Create or join a household",
  "@collectionStatsCreateOrJoin": {
    "description": "A link on the home page's stats card, shown to a user who is in no household. It opens the households screen, where they can start one."
  },
  "addToCollectionTitle": "Add {title}",
  "@addToCollectionTitle": {
    "description": "Heading of the sheet that adds a game to the user's collection, naming the game only, for example \"Add Wingspan\". The platform it is added on is the sheet's first field, not part of the heading. Read by screen readers as the sheet's heading.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Wingspan"
      }
    }
  },
  "addToCollectionPlatformLabel": "Platform",
  "@addToCollectionPlatformLabel": {
    "description": "Label of the add sheet's required choice of platform (for example Tabletop, Steam or Switch) to add the game on. It lists only the platforms where the user doesn't yet own the game both physically and digitally."
  },
  "addToCollectionPlatformHint": "Choose one",
  "@addToCollectionPlatformHint": {
    "description": "Shown in the add sheet's platform field until the user picks one, as the medium field below it shows until a medium is picked."
  },
  "addToCollectionPlatformRequired": "Choose a platform.",
  "@addToCollectionPlatformRequired": {
    "description": "Error under the add sheet's platform field when the user submits without picking one."
  },
  "addToCollectionMediumLabel": "Medium",
  "@addToCollectionMediumLabel": {
    "description": "Label of the add sheet's required choice between a physical copy (a boxed game, a disc) and a digital one (a download, an app). \"Medium\" is the form the copy takes, not a size. It offers only the media the user doesn't yet own on the platform chosen, and can start on a likely one, which the user can change."
  },
  "addToCollectionMediumHint": "Choose one",
  "@addToCollectionMediumHint": {
    "description": "Shown in the add sheet's Medium field until the user picks one."
  },
  "addToCollectionMediumRequired": "Choose physical or digital.",
  "@addToCollectionMediumRequired": {
    "description": "Error under the add sheet's Medium field when the user submits without picking one."
  },
  "addToCollectionQuantityLabel": "Copies",
  "@addToCollectionQuantityLabel": {
    "description": "Label of the copies field, shared by the add sheet and the edit sheet. On the add sheet it is how many copies the user is adding, starting at 1; on the edit sheet it is how many copies the entry holds, starting at the entry's own count."
  },
  "addToCollectionQuantityInvalid": "Enter a whole number, 1 or more.",
  "@addToCollectionQuantityInvalid": {
    "description": "Error under the copies field, on the add sheet and the edit sheet, when what was typed is not a whole number of at least 1: empty, zero, negative, a fraction or not a number."
  },
  "addToCollectionQuantityTooMany": "That's more copies than can be stored.",
  "@addToCollectionQuantityTooMany": {
    "description": "Error under the copies field, on the add sheet and the edit sheet, when the copies are more than the server can store (over 2,147,483,647): on the add sheet, the copies being added together with any already in the collection; on the edit sheet, the copies typed. A storage limit, not a rule about how many copies a person may own."
  },
  "addToCollectionQuantityDecrease": "One fewer copy",
  "@addToCollectionQuantityDecrease": {
    "description": "Screen-reader name and tooltip of the minus button beside the copies field, on the add sheet and the edit sheet. It lowers the copies by one, not below 1."
  },
  "addToCollectionQuantityIncrease": "One more copy",
  "@addToCollectionQuantityIncrease": {
    "description": "Screen-reader name and tooltip of the plus button beside the copies field, on the add sheet and the edit sheet. It raises the copies by one."
  },
  "addToCollectionQuantityStepped": "{count, plural, =1{1 copy} other{{count} copies}}",
  "@addToCollectionQuantityStepped": {
    "description": "Announced to a screen reader, not shown, after the user presses the minus or plus button beside the copies field, on the add sheet or the edit sheet: the copies the field now holds.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "addToCollectionRatingLabel": "Your rating (optional)",
  "@addToCollectionRatingLabel": {
    "description": "Label of the optional rating, a whole number from 1 to 10, shared by the add sheet and the edit sheet. On the edit sheet a rating already set can be changed but not removed."
  },
  "addToCollectionRatingNone": "No rating",
  "@addToCollectionRatingNone": {
    "description": "The add sheet's rating choice that leaves the game unrated, and its default. Also the edit sheet's starting choice for an entry with no rating, and what a collection entry's detail shows for one."
  },
  "addToCollectionRatingValue": "{rating} out of 10",
  "@addToCollectionRatingValue": {
    "description": "One of the rating choices on the add sheet and the edit sheet, for example \"7 out of 10\".",
    "placeholders": {
      "rating": {
        "type": "int",
        "example": "7"
      }
    }
  },
  "addToCollectionCommentLabel": "Comment (optional)",
  "@addToCollectionCommentLabel": {
    "description": "Label of the optional free-text comment about the game, shared by the add sheet and the edit sheet. On the edit sheet a comment already set can be changed but not emptied."
  },
  "addToCollectionHavePhysical": "{count, plural, =1{You have 1 physical copy.} other{You have {count} physical copies.}}",
  "@addToCollectionHavePhysical": {
    "description": "On the add sheet, once the user picks Physical: how many physical copies of this game on this platform are already in their collection. Adding more raises that number.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "addToCollectionHaveDigital": "{count, plural, =1{You have 1 digital copy.} other{You have {count} digital copies.}}",
  "@addToCollectionHaveDigital": {
    "description": "On the add sheet, once the user picks Digital: how many digital copies of this game on this platform are already in their collection. Adding more raises that number.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "addToCollectionMakes": "Adding {adding} makes {total}.",
  "@addToCollectionMakes": {
    "description": "Follows the you-have sentence on the add sheet: the copies being added and the total they make with those already there, for example \"Adding 1 makes 3.\"",
    "placeholders": {
      "adding": {
        "type": "int",
        "example": "1"
      },
      "total": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "addToCollectionSubmit": "Add to collection",
  "@addToCollectionSubmit": {
    "description": "The add sheet's submit button."
  },
  "addToCollectionInProgress": "Adding…",
  "@addToCollectionInProgress": {
    "description": "Replaces the add sheet's submit label while the add is being saved, and is the disabled button's accessible name meanwhile."
  },
  "addToCollectionFailedTitle": "Couldn't add the game",
  "@addToCollectionFailedTitle": {
    "description": "Heading of the banner above the add sheet's submit button when the add failed. The sheet stays open with what the user entered."
  },
  "addToCollectionFailedBody": "Nothing was saved. Try again.",
  "@addToCollectionFailedBody": {
    "description": "Body of the banner above the add sheet's submit button when the add failed: nothing reached the collection, and submitting again retries it."
  },
  "addToCollectionDismissedFailed": "Couldn't add {title} to your collection.",
  "@addToCollectionDismissedFailed": {
    "description": "Shown briefly on the game's screen when the add sheet was dismissed while its add was being saved, and the save then failed: nothing reached the collection. The sheet and its error banner are gone, so this is the only word of it. Must not suggest the add will happen later.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Wingspan"
      }
    }
  },
  "addToCollectionQueued": "Added {title} to your collection on this device. It hasn't reached the server yet.",
  "@addToCollectionQueued": {
    "description": "Shown briefly on the game's screen after the add sheet closes with the game added on this device but not yet confirmed by the server: it couldn't be reached, or an earlier change to the same entry is still waiting. Must not promise when it will reach the server: the app sends it later on its own, on every platform (#447).",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Wingspan"
      }
    }
  },
  "addToCollectionRefused": "The server didn't accept {title}. It's saved on this device: review it from the home screen to try again or discard it.",
  "@addToCollectionRefused": {
    "description": "Shown briefly on the game's screen after the add sheet closes when the server refused the add, so it will not sync on its own (#190). Points the user at the notice on the home screen, which opens the screen where changes that couldn't sync can be retried or discarded. Must not promise that it will sync later.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Wingspan"
      }
    }
  },
  "addToCollectionAdded": "Added {title} to your collection.",
  "@addToCollectionAdded": {
    "description": "Shown briefly on the game's screen after the add sheet closes with the game added and confirmed by the server.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Wingspan"
      }
    }
  },
  "editCollectionTitle": "Edit {title}",
  "@editCollectionTitle": {
    "description": "Heading of the sheet that edits a collection entry's copies, rating, comment, favorite and would-play-again, naming the game, for example \"Edit Wingspan\". Read by screen readers as the sheet's heading.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Wingspan"
      }
    }
  },
  "editCollectionFavorite": "Favorite",
  "@editCollectionFavorite": {
    "description": "Label of the switch in the edit sheet that marks the game as a favorite."
  },
  "editCollectionPlayAgain": "Would play again",
  "@editCollectionPlayAgain": {
    "description": "Label of the switch in the edit sheet that says the user would play the game again."
  },
  "editCollectionCommentCantClear": "A comment can't be removed yet. Change it instead.",
  "@editCollectionCommentCantClear": {
    "description": "Error under the edit sheet's comment field when the entry has a comment and the user emptied it. The server can't clear a comment yet, so the sheet asks for a different one."
  },
  "editCollectionSubmit": "Save",
  "@editCollectionSubmit": {
    "description": "Label of the edit sheet's submit button."
  },
  "editCollectionInProgress": "Saving…",
  "@editCollectionInProgress": {
    "description": "Replaces the edit sheet's submit label while the change is being saved, and is the disabled button's accessible name meanwhile."
  },
  "editCollectionFailedTitle": "Couldn't save your changes",
  "@editCollectionFailedTitle": {
    "description": "Heading of the banner above the edit sheet's submit button when the save failed. The sheet stays open with what the user entered."
  },
  "editCollectionFailedBody": "Nothing was changed. Try again.",
  "@editCollectionFailedBody": {
    "description": "Body of the banner above the edit sheet's submit button when the save failed: nothing was written, and saving again retries it."
  },
  "editCollectionFailedGoneBody": "It's no longer in your collection, perhaps removed on another device.",
  "@editCollectionFailedGoneBody": {
    "description": "Body of the edit sheet's failed-save banner, in place of editCollectionFailedBody, when the save failed because the entry was removed while the sheet was open. Saving again can't succeed. The app can't tell where it was removed, so it says 'perhaps'."
  },
  "removeFromCollectionTitle": "Remove {title}?",
  "@removeFromCollectionTitle": {
    "description": "Title of the dialog that asks the user to confirm removing a game from their collection, naming the game.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Wingspan"
      }
    }
  },
  "removeFromCollectionBody": "This says you no longer own it. Your plays, rating and comment are kept, and come back if you add it again.",
  "@removeFromCollectionBody": {
    "description": "Body of the remove-from-collection confirm dialog: removing marks the game as no longer owned, and keeps its plays, rating and comment for if it is added again."
  },
  "removeFromCollectionConfirm": "Remove",
  "@removeFromCollectionConfirm": {
    "description": "Label of the remove-from-collection dialog's confirm button."
  },
  "removeFromCollectionCancel": "Keep it",
  "@removeFromCollectionCancel": {
    "description": "Label of the remove-from-collection dialog's cancel button, which leaves the game in the collection."
  },
  "collectionEntryPlays": "{count, plural, =0{No plays recorded} =1{1 play} other{{count} plays}}",
  "@collectionEntryPlays": {
    "description": "On a collection entry's detail: how many plays of the game the user has recorded. Shown, not edited, here.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "collectionEntryLastPlayedNever": "Not played yet",
  "@collectionEntryLastPlayedNever": {
    "description": "On a collection entry's detail, in place of collectionListLastPlayed when the user has recorded no play of the game."
  },
  "collectionEntryPlayAgain": "Would play again",
  "@collectionEntryPlayAgain": {
    "description": "On a collection entry's detail: shown when the user has said they would play the game again, and absent otherwise."
  },
  "collectionEntryNoComment": "No comment",
  "@collectionEntryNoComment": {
    "description": "On a collection entry's detail, in place of the user's comment on the game when they haven't written one."
  },
  "collectionEntryGameDetails": "Game details",
  "@collectionEntryGameDetails": {
    "description": "Button on a collection entry's detail that opens the game's own page in the catalog."
  },
  "collectionEntryEdit": "Edit",
  "@collectionEntryEdit": {
    "description": "App bar button on a collection entry's detail that opens the sheet editing the entry's copies, rating, comment, favorite and would-play-again. Also the button's name to screen readers."
  },
  "collectionEntryRemove": "Remove",
  "@collectionEntryRemove": {
    "description": "App bar button on a collection entry's detail that asks whether to remove the game from the user's collection. Also the button's name to screen readers."
  },
  "collectionEntryGoneTitle": "No longer in your collection",
  "@collectionEntryGoneTitle": {
    "description": "Heading on a collection entry's detail when the entry went away while it was open, for example because it was removed on another of the user's devices."
  },
  "collectionEntryGoneBody": "It was removed, perhaps on another device.",
  "@collectionEntryGoneBody": {
    "description": "Body under collectionEntryGoneTitle. The app can't tell where the entry was removed, so it says 'perhaps'."
  },
  "collectionEntryError": "Couldn't load this entry.",
  "@collectionEntryError": {
    "description": "Shown on a collection entry's detail when the entry couldn't be read from this device."
  },
  "collectionEntrySaved": "Saved",
  "@collectionEntrySaved": {
    "description": "SnackBar after an edit to a collection entry was saved and the server has it."
  },
  "collectionEntrySavedQueued": "Saved on this device. It will sync when it can.",
  "@collectionEntrySavedQueued": {
    "description": "SnackBar after an edit to a collection entry was saved on this device but couldn't be sent to the server yet. It is sent later without the user doing anything."
  },
  "collectionEntryRefused": "The server didn't accept this change. See changes that couldn't sync.",
  "@collectionEntryRefused": {
    "description": "SnackBar after the server refused an edit to, or the removal of, a collection entry. The change is kept on this device, and the list of changes that couldn't sync is where the user retries or discards it."
  },
  "collectionEntryRemoved": "Removed {title}",
  "@collectionEntryRemoved": {
    "description": "SnackBar after a game was removed from the user's collection and the server has it, naming the game. Shown on the screen the user goes back to.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Wingspan"
      }
    }
  },
  "collectionEntryRemovedQueued": "Removed {title} on this device. It will sync when it can.",
  "@collectionEntryRemovedQueued": {
    "description": "SnackBar after a game was removed from the user's collection on this device but the removal couldn't be sent to the server yet, naming the game. It is sent later without the user doing anything. Shown on the screen the user goes back to.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Wingspan"
      }
    }
  },
  "collectionEntryRemoveFailed": "Couldn't remove {title}.",
  "@collectionEntryRemoveFailed": {
    "description": "SnackBar when removing a game from the user's collection failed, naming the game. Nothing was removed, and the entry stays open.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Wingspan"
      }
    }
  },
  "collectionEntryRemoving": "Removing…",
  "@collectionEntryRemoving": {
    "description": "Replaces the Remove button's label on a collection entry's detail while the removal is being saved and sent, and is the button's accessible name meanwhile. Announced to screen readers as it appears."
  },
  "collectionEntryLoading": "Loading this entry…",
  "@collectionEntryLoading": {
    "description": "Screen-reader name of the spinner shown on a collection entry's detail until the entry has been read from this device."
  },
  "collectionEntryErrorBody": "Try again, or go back to your collection.",
  "@collectionEntryErrorBody": {
    "description": "Body under collectionEntryError on a collection entry's detail, when the entry couldn't be read from this device. The button below it reads the entry again."
  },
  "collectionEntryRetry": "Try again",
  "@collectionEntryRetry": {
    "description": "Button on a collection entry's detail when the entry couldn't be read from this device: reads it from this device again. Kept as a plain retry: nothing here can promise the next attempt will work."
  },
  "collectionEntryCommentSpoken": "Your comment: {comment}",
  "@collectionEntryCommentSpoken": {
    "description": "What a screen reader says for the user's own comment on a collection entry's detail, in place of the comment shown alone, so the listener knows what the words are.",
    "placeholders": {
      "comment": {
        "type": "String",
        "example": "Best with five."
      }
    }
  },
  "collectionEntryPlatformSpoken": "Platform: {platform}",
  "@collectionEntryPlatformSpoken": {
    "description": "What a screen reader says for the platform line under the game's title on a collection entry's detail, in place of the platform's name shown alone, for example \"Platform: Board game\".",
    "placeholders": {
      "platform": {
        "type": "String",
        "example": "Board game"
      }
    }
  },
  "collectionEntryMediumSpoken": "Format: {medium}",
  "@collectionEntryMediumSpoken": {
    "description": "What a screen reader says for whether the copy is physical or digital on a collection entry's detail, in place of the word shown alone. {medium} is collectionListMediumPhysical or collectionListMediumDigital, for example \"Format: Physical\".",
    "placeholders": {
      "medium": {
        "type": "String",
        "example": "Physical"
      }
    }
  },
  "collectionPickerTitle": "{title}: your copies",
  "@collectionPickerTitle": {
    "description": "Heading of the pop-up that opens from a game the user owns more than one copy of, on different platforms or as both a physical and a digital copy. It lists the copies, and tapping one opens it. A screen reader also announces it as the pop-up's name when it opens. {title} is the game's name.",
