{
  "@@locale": "en",
  "householdListTitle": "Households",
  "@householdListTitle": {
    "description": "Title of the screen listing the households the user belongs to, and the label of the drawer entry that opens it."
  },
  "householdListLoading": "Loading your households\u2026",
  "@householdListLoading": {
    "description": "Announced and shown while the household list is still being fetched for the first time."
  },
  "householdListEmptyTitle": "No households yet",
  "@householdListEmptyTitle": {
    "description": "Heading of the empty state shown when the user belongs to no households."
  },
  "householdListEmptyBody": "A household is the group you share your games with. Create one to get started.",
  "@householdListEmptyBody": {
    "description": "Body of the empty state shown when the user belongs to no households."
  },
  "householdListNotSynced": "Not yet synced",
  "@householdListNotSynced": {
    "description": "Badge on a household row that exists only on this device, or has local changes the server has not confirmed."
  },
  "householdListRefreshFailed": "This list may be out of date \u2014 we couldn't refresh it.",
  "@householdListRefreshFailed": {
    "description": "Banner shown when the household list could not be refreshed from the server, for ANY reason: the server was unreachable, or it answered with an error. The cached households are still shown. Deliberately does not name a cause \u2014 the screen does not know which one it was."
  },
  "householdRefreshRetry": "Try again",
  "@householdRefreshRetry": {
    "description": "Button on the refresh banner that asks the server for the household data again. Shared by the household list and the household detail screen \u2014 both banners run the same pass, and a per-screen wording would be two translations of one action. Kept as a plain retry: the drain reports one undifferentiated failure, so nothing here can promise the next attempt will work."
  },
  "householdRefreshInProgress": "Refreshing\u2026",
  "@householdRefreshInProgress": {
    "description": "Replaces the couldn't-refresh banner copy while a refresh the user asked for is running, and is the retry button's label while it is disabled. Shown ONLY for a user-initiated retry \u2014 a refresh triggered by reconnecting or by resuming the app is not narrated."
  },
  "householdListError": "We couldn't open your households.",
  "@householdListError": {
    "description": "Shown when the local household list could not be read at all, so no households can be displayed."
  },
  "householdDetailLoading": "Loading this household\u2026",
  "@householdDetailLoading": {
    "description": "Announced and shown while the household detail screen is still reading the local cache, or while the first hydrate pass is still filling it."
  },
  "householdDetailMembers": "{count, plural, =0{No members} =1{1 member} other{{count} members}}",
  "@householdDetailMembers": {
    "description": "Number of people in the household, shown on the household detail screen. Zero is reachable only transiently, before the member rows are cached.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "householdDetailYourRole": "Your role",
  "@householdDetailYourRole": {
    "description": "Label above the current user's own membership role on the household detail screen."
  },
  "householdDetailRoleOwner": "Owner",
  "@householdDetailRoleOwner": {
    "description": "The current user's role in this household: they own it."
  },
  "householdDetailRoleAdmin": "Admin",
  "@householdDetailRoleAdmin": {
    "description": "The current user's role in this household: they administer it but do not own it."
  },
  "householdDetailRoleMember": "Member",
  "@householdDetailRoleMember": {
    "description": "The current user's role in this household: an ordinary member."
  },
  "householdDetailRoleGuest": "Guest",
  "@householdDetailRoleGuest": {
    "description": "The current user's role in this household: a guest, the most limited role."
  },
  "householdDetailRoleUnknown": "A role this app doesn't recognise",
  "@householdDetailRoleUnknown": {
    "description": "Shown in place of the current user's role when the server granted a custom role name this client has no translation for. This is real data about the server, NOT a parsing failure \u2014 the wire adapter throws on a malformed role rather than degrading to this."
  },
  "householdDetailRefreshFailed": "This may be out of date \u2014 we couldn't refresh it.",
  "@householdDetailRefreshFailed": {
    "description": "Banner shown on the household detail screen when the last refresh from the server did not complete, for ANY reason. What is shown is the cached copy. Deliberately does not name a cause \u2014 the screen does not know which one it was."
  },
  "householdDetailNotFoundTitle": "We couldn't find this household",
  "@householdDetailNotFoundTitle": {
    "description": "Heading shown when the requested household is not readable: it is not cached, the user is not a member, or it has been deleted. The three are deliberately indistinguishable."
  },
  "householdDetailNotFoundBody": "It may have been deleted, or you may no longer be a member.",
  "@householdDetailNotFoundBody": {
    "description": "Body of the not-found state on the household detail screen. Hedged on purpose: the client cannot tell a deleted household from one the user was removed from, and must not claim either."
  },
  "householdDetailNotFoundAction": "Back to households",
  "@householdDetailNotFoundAction": {
    "description": "Button on the not-found state that returns the user to the household list."
  },
  "householdDetailError": "We couldn't open this household.",
  "@householdDetailError": {
    "description": "Shown when the local read for this household failed outright, so nothing about it can be displayed."
  },
  "createHouseholdTitle": "Create household",
  "@createHouseholdTitle": {
    "description": "Title of the create-household screen."
  },
  "createHouseholdNameLabel": "Household name",
  "@createHouseholdNameLabel": {
    "description": "Label for the required household name field."
  },
  "createHouseholdNameRequired": "Enter a name for your household.",
  "@createHouseholdNameRequired": {
    "description": "Validation error shown when the household name is empty."
  },
  "createHouseholdDescriptionLabel": "Description (optional)",
  "@createHouseholdDescriptionLabel": {
    "description": "Label for the optional household description field."
  },
  "createHouseholdSubmit": "Create household",
  "@createHouseholdSubmit": {
    "description": "Label for the button that submits the create-household form."
  },
  "createHouseholdInProgress": "Creating household…",
  "@createHouseholdInProgress": {
    "description": "Progress label announced and shown while the household is being created"
  },
  "createHouseholdSynced": "Household created.",
  "@createHouseholdSynced": {
    "description": "Confirmation shown when the household was created and confirmed by the server."
  },
  "createHouseholdQueued": "Household created. It'll finish syncing when you're back online.",
  "@createHouseholdQueued": {
    "description": "Confirmation shown when the household was created locally but not yet confirmed by the server."
  },
  "createHouseholdError": "Something went wrong creating your household. Please try again.",
  "@createHouseholdError": {
    "description": "Error shown when the household could not be created locally."
  }
}
