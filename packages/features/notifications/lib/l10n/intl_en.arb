{
  "@@locale": "en",
  "notificationsTitle": "Notifications",
  "@notificationsTitle": {
    "description": "Title of the page that lists every notification the signed-in user has on this server, read or not, and the label of the navigation menu's entry that opens it. Not the invite inbox, which is a different page."
  },
  "notificationUnknownTitle": "A notification this version of the app can't show",
  "@notificationUnknownTitle": {
    "description": "Title of a notification's row, on the Notifications page and in the preview the bell in the header opens, for a notification the app can't word: the server sent a kind of notification this version doesn't know, or one whose details it can't read. The row opens nothing; the user can only mark it read."
  },
  "notificationHouseholdInviteReceivedTitle": "{inviterName} invited you to {householdName}",
  "@notificationHouseholdInviteReceivedTitle": {
    "description": "Title of a notification telling the user they were invited to join a household. Tapping it opens the user's invites, where they can accept or decline. {inviterName} is the name of the person who sent the invite and {householdName} is the household's name, both as the server gives them.",
    "placeholders": {
      "inviterName": {
        "type": "String",
        "example": "Ana"
      },
      "householdName": {
        "type": "String",
        "example": "The Smiths"
      }
    }
  },
  "notificationHouseholdInviteAwaitingApprovalTitle": "{inviterName}'s invite to {householdName} is awaiting approval",
  "@notificationHouseholdInviteAwaitingApprovalTitle": {
    "description": "Title of a notification sent to a household's owners and admins when a member invited someone and the invite needs one of them to approve it before it is sent. Tapping it opens the household's invites awaiting approval. {inviterName} is the member who made the invite and {householdName} is the household's name, both as the server gives them. The line under it says who the invite is for.",
    "placeholders": {
      "inviterName": {
        "type": "String",
        "example": "Ana"
      },
      "householdName": {
        "type": "String",
        "example": "The Smiths"
      }
    }
  },
  "notificationInviteeDetail": "For {invitee}",
  "@notificationInviteeDetail": {
    "description": "Second line of the notification that a household invite is awaiting approval: who the invite is for. {invitee} is the name the invite was sent with or, when it was sent to an email address with no name, that address, as the server gives it.",
    "placeholders": {
      "invitee": {
        "type": "String",
        "example": "Bo"
      }
    }
  },
  "notificationInviteeUnnamedDetail": "For someone the invite doesn't name",
  "@notificationInviteeUnnamedDetail": {
    "description": "Second line of the notification that a household invite is awaiting approval, when the server gave neither a name nor an email address for the person invited."
  },
  "notificationHouseholdInviteAcceptedTitle": "{memberName} joined {householdName}",
  "@notificationHouseholdInviteAcceptedTitle": {
    "description": "Title of a notification sent to a household's members when someone accepted an invite and became a member. Tapping it opens the household. {memberName} is the new member's name and {householdName} is the household's name, both as the server gives them.",
    "placeholders": {
      "memberName": {
        "type": "String",
        "example": "Bo"
      },
      "householdName": {
        "type": "String",
        "example": "The Smiths"
      }
    }
  },
  "notificationHouseholdInviteDeclinedTitle": "{invitee} declined an invite to {householdName}",
  "@notificationHouseholdInviteDeclinedTitle": {
    "description": "Title of a notification sent to the person who made a household invite, and to the household's owners and admins, when the person invited declined it. Tapping it opens the invites. {invitee} is the name the invite was sent with or, when it was sent to an email address with no name, that address; {householdName} is the household's name. All come from the server as they are.",
    "placeholders": {
      "invitee": {
        "type": "String",
        "example": "Bo"
      },
      "householdName": {
        "type": "String",
        "example": "The Smiths"
      }
    }
  },
  "notificationHouseholdInviteDeclinedUnnamedTitle": "Someone declined an invite to {householdName}",
  "@notificationHouseholdInviteDeclinedUnnamedTitle": {
    "description": "Title of the notification that a household invite was declined, when the server gave neither a name nor an email address for the person invited. Tapping it opens the invites. {householdName} is the household's name as the server gives it.",
    "placeholders": {
      "householdName": {
        "type": "String",
        "example": "The Smiths"
      }
    }
  },
  "notificationHouseholdOwnershipTransferredTitle": "Ownership of {householdName} passed to you from {previousOwnerName}",
  "@notificationHouseholdOwnershipTransferredTitle": {
    "description": "Title of a notification telling the user they are now the owner of a household, the one member with final say over it. Tapping it opens the household. {householdName} is the household's name and {previousOwnerName} is the name of the member who owned it before, both as the server gives them.",
    "placeholders": {
      "householdName": {
        "type": "String",
        "example": "The Smiths"
      },
      "previousOwnerName": {
        "type": "String",
        "example": "Ana"
      }
    }
  },
  "notificationHouseholdOwnershipTransferredUnnamedTitle": "Ownership of {householdName} passed to you from the previous owner",
  "@notificationHouseholdOwnershipTransferredUnnamedTitle": {
    "description": "Title of the notification that the user is now the owner of a household, when the previous owner's account was deleted and the server no longer has their name. Tapping it opens the household. {householdName} is the household's name as the server gives it.",
    "placeholders": {
      "householdName": {
        "type": "String",
        "example": "The Smiths"
      }
    }
  },
  "notificationUnreadLabel": "Unread",
  "@notificationUnreadLabel": {
    "description": "Read by a screen reader before the title of a notification the user hasn't read yet. On screen, an unread notification's title is bold instead."
  },
  "notificationDataGatewayAutoDisabledTitle": "{gatewayName} was switched off automatically",
  "@notificationDataGatewayAutoDisabledTitle": {
    "description": "Title of a notification sent to server admins when a data gateway, a source the server gets game information from, was switched off automatically after repeated failures, not by an admin's choice, so the title says it happened automatically. Tapping it opens that data gateway's page. {gatewayName} is the data gateway's name as the server gives it. The line under it says why, and the text under that is the error the data gateway last gave.",
    "placeholders": {
      "gatewayName": {
        "type": "String",
        "example": "BoardGameGeek"
      }
    }
  },
  "notificationDataGatewayConnectDetail": "It couldn't connect, again and again",
  "@notificationDataGatewayConnectDetail": {
    "description": "Second line of the notification that a data gateway was switched off: the reason, when the server couldn't connect to it on one attempt after another."
  },
  "notificationDataGatewayCallDetail": "Its calls kept failing",
  "@notificationDataGatewayCallDetail": {
    "description": "Second line of the notification that a data gateway was switched off: the reason, when the server reached it but its calls failed on one attempt after another."
  },
  "notificationDataGatewayGenericDetail": "It failed too many times in a row",
  "@notificationDataGatewayGenericDetail": {
    "description": "Second line of the notification that a data gateway was switched off, when the server gave a reason this version of the app has no words for."
  },
  "notificationDataGatewayCapabilitiesLostTitle": "{gatewayName} lost some capabilities",
  "@notificationDataGatewayCapabilitiesLostTitle": {
    "description": "Title of a notification sent to server admins when a check of a data gateway, a source the server gets game information from, found it no longer does things the server was using it for. Tapping it opens that data gateway's page, which lists them. {gatewayName} is the data gateway's name as the server gives it.",
    "placeholders": {
      "gatewayName": {
        "type": "String",
        "example": "BoardGameGeek"
      }
    }
  },
  "notificationDataGatewayCapabilitiesLostDetail": "{count, plural, one{{count} thing the server was using it for is gone} other{{count} things the server was using it for are gone}}",
  "@notificationDataGatewayCapabilitiesLostDetail": {
    "description": "Second line of the notification that a data gateway lost capabilities: how many of the things the server was using it for, such as searching, it can no longer do. {count} is at least 1.",
    "placeholders": {
      "count": {
        "type": "int",
        "format": "decimalPattern",
        "example": "2"
      }
    }
  },
  "notificationUsernameVariantAssignedTitle": "Your username is {username}, because {requestedUsername} was taken",
  "@notificationUsernameVariantAssignedTitle": {
    "description": "Title of a notification sent to a new user whose first sign-in through a provider brought a username that another account already had, so the server gave them the nearest free one. {username} is the username the account got, such as jason-2. {requestedUsername} is the one the provider offered, which was taken. Both are user data, inserted as they are and never translated.",
    "placeholders": {
      "username": {
        "type": "String",
        "example": "jason-2"
      },
      "requestedUsername": {
        "type": "String",
        "example": "jason"
      }
    }
  },
  "notificationUsernameVariantAssignedChangeAllowedDetail": "You can change your username",
  "@notificationUsernameVariantAssignedChangeAllowedDetail": {
    "description": "Second line of the notification that a new user got a different username from the one they asked for: said when the server lets users change their username, as it did when the notification was sent. It does not say where, because the app has no place to change a username yet; #1145 adds one, and this line is then reworded to point to it. It is not a button."
  },
  "notificationUsernameVariantAssignedChangeNotAllowedDetail": "A server admin can change it",
  "@notificationUsernameVariantAssignedChangeNotAllowedDetail": {
    "description": "Second line of the notification that a new user got a different username from the one they asked for: said when the server does not let users change their username themselves, so only a server admin can."
  },
  "notificationReceivedAt": "{date} at {time}",
  "@notificationReceivedAt": {
    "description": "When a notification arrived, on its row on the Notifications page and in the preview the bell in the header opens: the date, then the time of day, in the device's time zone.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "yMMMd",
        "example": "Nov 27, 2026"
      },
      "time": {
        "type": "DateTime",
        "format": "jm",
        "example": "3:04 PM"
      }
    }
  },
  "notificationMarkRead": "Mark read",
  "@notificationMarkRead": {
    "description": "Button under a notification that opens nothing, such as one this version of the app can't show, on the Notifications page and in the preview the bell in the header opens. It marks that notification read, so it no longer counts as unread. It shows only while the notification is unread."
  },
  "notificationCopyError": "Copy error",
  "@notificationCopyError": {
    "description": "Button under a notification on the Notifications page whose quoted text is an error message, as when a DataGateway was switched off after repeated failures. It copies that message, exactly as the server sent it, to the clipboard, so a server admin can look it up or report it."
  },
  "notificationErrorCopied": "Error copied",
  "@notificationErrorCopied": {
    "description": "Said once notificationCopyError has copied a notification's error message to the clipboard."
  },
  "notificationErrorCopyFailed": "Couldn't copy the error. Try again.",
  "@notificationErrorCopyFailed": {
    "description": "Said when notificationCopyError couldn't copy a notification's error message to the clipboard."
  },
  "notificationsBellTooltip": "Notifications",
  "@notificationsBellTooltip": {
    "description": "Tooltip of the bell button in the header, shown when a mouse rests on it. The bell opens a preview of the latest notifications. Screen readers hear the button's name, which gives the unread count, instead."
  },
  "notificationsBellLabel": "{count, plural, =0{Notifications} other{Notifications, {count} unread}}",
  "@notificationsBellLabel": {
    "description": "What a screen reader calls the bell button in the header, which opens a preview of the latest notifications. {count} is how many notifications the user hasn't read, always the real number, even when the badge on the bell shows 99+. With none unread, or before the count is known, it is just Notifications.",
    "placeholders": {
      "count": {
        "type": "int",
        "format": "decimalPattern",
        "example": "3"
      }
    }
  },
  "notificationsLoading": "Loading your notifications…",
  "@notificationsLoading": {
    "description": "Shown, and read by a screen reader, while the user's notifications are on their way from the server: on the Notifications page, and in the preview of the latest ones that the bell in the header opens."
  },
  "notificationsEmptyTitle": "No notifications yet",
  "@notificationsEmptyTitle": {
    "description": "Title shown when the server has no notifications for the user, read or unread: on the Notifications page, and in the preview of the latest ones that the bell in the header opens."
  },
  "notificationsEmptyBody": "When something needs you, such as an invite, it shows up here.",
  "@notificationsEmptyBody": {
    "description": "Line under the title when the user has no notifications, saying what will appear there: on the Notifications page, and in the preview the bell in the header opens."
  },
  "notificationsLoadFailed": "Couldn't load your notifications",
  "@notificationsLoadFailed": {
    "description": "Title shown when the user's notifications couldn't be read from the server, so there is nothing to show: on the Notifications page, and in the preview of the latest ones that the bell in the header opens. A Try again button follows."
  },
  "notificationsLoadFailedOfflineBody": "Check your connection, then try again.",
  "@notificationsLoadFailedOfflineBody": {
    "description": "Line under the title when the notifications couldn't load because the server didn't answer, on the Notifications page or in the preview the bell in the header opens: the device may be offline, or the server down."
  },
  "notificationsLoadFailedRefusedBody": "The server wouldn't send your notifications. If trying again doesn't help, tell the server's admin.",
  "@notificationsLoadFailedRefusedBody": {
    "description": "Line under the title when the notifications couldn't load because the server answered and refused, on the Notifications page or in the preview the bell in the header opens. Trying again is unlikely to help, so it points to the person who runs the server."
  },
  "notificationsRetry": "Try again",
  "@notificationsRetry": {
    "description": "Button that reads the notifications from the server again after reading them failed: under the failure on the Notifications page and in the preview the bell in the header opens, and on the banner at the top of the page when a refresh failed."
  },
  "notificationsRefresh": "Refresh",
  "@notificationsRefresh": {
    "description": "Name and tooltip of the button in the Notifications page's header that reads the notifications from the server again, as pulling the list down does."
  },
  "notificationsRefreshing": "Refreshing…",
  "@notificationsRefreshing": {
    "description": "Name and tooltip of the Notifications page's refresh button, and the name of the Try again on the page's banner after a refresh failed, while the notifications are being read from the server again."
  },
  "notificationsRefreshFailed": "Couldn't refresh your notifications. They may be out of date.",
  "@notificationsRefreshFailed": {
    "description": "Banner at the top of the Notifications page when reading the notifications again failed. The notifications already shown stay, and the banner's Try again reads them again. It names no cause."
  },
  "notificationsMarkAllRead": "Mark all read",
  "@notificationsMarkAllRead": {
    "description": "Button that marks every notification the user has read, shown ones or not, with no confirmation, since nothing is lost: they stay listed, shown read. It sits above the list on the Notifications page, and above the latest notifications in the preview the bell in the header opens, while any notification listed there is unread."
  },
  "notificationsMarkingAllRead": "Marking all read…",
  "@notificationsMarkingAllRead": {
    "description": "What the Mark all read button says, and is called by a screen reader, while the server is marking every notification read: on the Notifications page and in the preview the bell in the header opens."
  },
  "notificationsLoadMore": "Load more",
  "@notificationsLoadMore": {
    "description": "Button under the list on the Notifications page that reads the next, older notifications from the server and adds them below."
  },
  "notificationsLoadingMore": "Loading more…",
  "@notificationsLoadingMore": {
    "description": "What the Load more button says, and is called by a screen reader, while the next notifications are being read from the server."
  },
  "notificationsMarkAllFailedOffline": "Couldn't mark your notifications read. Check your connection, then try again.",
  "@notificationsMarkAllFailedOffline": {
    "description": "Banner when Mark all read failed because the server didn't answer. The notifications show unread again, and Mark all read can be pressed again. On the Notifications page it sits at the foot of the page, and stays until the next Mark all read answers or the user dismisses it. In the preview the bell in the header opens, it sits under the Mark all read button, and stays until the next Mark all read answers."
  },
  "notificationsMarkAllRefused": "The server wouldn't mark your notifications read.",
  "@notificationsMarkAllRefused": {
    "description": "Banner when the server answered Mark all read and refused it. The notifications show unread again. On the Notifications page it sits at the foot of the page, and stays until the next Mark all read answers or the user dismisses it. In the preview the bell in the header opens, it sits under the Mark all read button, and stays until the next Mark all read answers."
  },
  "notificationsLoadMoreFailedOffline": "Couldn't load more notifications. Check your connection, then choose Load more.",
  "@notificationsLoadMoreFailedOffline": {
    "description": "Banner at the foot of the Notifications page when Load more failed because the server didn't answer. The notifications already shown stay, and Load more can be pressed again. Load more is the button's name."
  },
  "notificationsLoadMoreRefused": "The server wouldn't load more notifications. Refresh to start again from the newest.",
  "@notificationsLoadMoreRefused": {
    "description": "Banner at the foot of the Notifications page when the server answered Load more and refused it, so asking again is unlikely to help. Refreshing reads the newest notifications again, from the top of the list."
  },
  "notificationsDismiss": "Dismiss",
  "@notificationsDismiss": {
    "description": "Button on a banner at the foot of the Notifications page, saying that Mark all read or Load more failed. It takes the banner away."
  },
  "notificationsPreviewTitle": "Notifications",
  "@notificationsPreviewTitle": {
    "description": "Heading of the pop-up the bell in the header opens, which shows the five latest notifications, read or not, with a button to the Notifications page for the rest. A screen reader also calls the pop-up this as it opens. Not the invite inbox, which is a different page."
  },
  "notificationsPreviewSeeAll": "See all",
  "@notificationsPreviewSeeAll": {
    "description": "Button at the foot of the pop-up the bell in the header opens, which shows the five latest notifications. It opens the Notifications page, which lists every notification, read or not, a page at a time."
  },
  "notificationEventCreatedTitle": "New event: {eventTitle}",
  "@notificationEventCreatedTitle": {
    "description": "Title of a notification sent to a household's members when an event was created for the household. Tapping it opens the event. {eventTitle} is the event's title as the server gives it.",
    "placeholders": {
      "eventTitle": {
        "type": "String",
        "example": "Friday Night Games"
      }
    }
  },
  "notificationEventReopenedTitle": "{eventTitle} was reopened",
  "@notificationEventReopenedTitle": {
    "description": "Title of a notification sent to an event's attendees when an event that had been cancelled was opened again. Tapping it opens the event. {eventTitle} is the event's title as the server gives it.",
    "placeholders": {
      "eventTitle": {
        "type": "String",
        "example": "Friday Night Games"
      }
    }
  },
  "notificationEventCancelledTitle": "{eventTitle} was cancelled",
  "@notificationEventCancelledTitle": {
    "description": "Title of a notification sent to an event's attendees when the event was cancelled. Tapping it opens the event. {eventTitle} is the event's title as the server gives it. The reason the host gave, when they gave one, is shown under it as they wrote it.",
    "placeholders": {
      "eventTitle": {
        "type": "String",
        "example": "Friday Night Games"
      }
    }
  },
  "notificationEventDeletedTitle": "{eventTitle} was deleted",
  "@notificationEventDeletedTitle": {
    "description": "Title of a notification sent to an event's attendees when the event was deleted. It opens nothing, since the event is gone: the user can only mark it read. {eventTitle} is the event's title as the server gives it.",
    "placeholders": {
      "eventTitle": {
        "type": "String",
        "example": "Friday Night Games"
      }
    }
  },
  "notificationEventAttendeeRemovedTitle": "You were removed from {eventTitle}",
  "@notificationEventAttendeeRemovedTitle": {
    "description": "Title of a notification sent to a person who another person took off an event's list of attendees. It opens the event, which they may still be able to see, as when it is their household's or public. {eventTitle} is the event's title as the server gives it.",
    "placeholders": {
      "eventTitle": {
        "type": "String",
        "example": "Friday Night Games"
      }
    }
  },
  "notificationEventRsvpReceivedTitle": "{attendeeName} replied to {eventTitle}",
  "@notificationEventRsvpReceivedTitle": {
    "description": "Title of a notification sent to an event's hosts and co-hosts when someone replied to the event, to say whether they are coming. Tapping it opens the event. {attendeeName} is the person's name as the server gives it. {eventTitle} is the event's title as the server gives it.",
    "placeholders": {
      "attendeeName": {
        "type": "String",
        "example": "Ana"
      },
      "eventTitle": {
        "type": "String",
        "example": "Friday Night Games"
      }
    }
  },
  "notificationEventRsvpReceivedNoAccountTitle": "Someone without an account replied to {eventTitle}",
  "@notificationEventRsvpReceivedNoAccountTitle": {
    "description": "Title of a notification sent to an event's hosts and co-hosts when someone without an account, such as a person invited by link who has not registered, replied to the event to say whether they are coming, so the server has no name for them. The title does not call them a guest, which is a role in events and households. Tapping it opens the event. {eventTitle} is the event's title as the server gives it.",
    "placeholders": {
      "eventTitle": {
        "type": "String",
        "example": "Friday Night Games"
      }
    }
  },
  "notificationEventRsvpChangedTitle": "{changedByName} changed your reply to {eventTitle}",
  "@notificationEventRsvpChangedTitle": {
    "description": "Title of a notification sent to an attendee when another person changed their reply to an event, the answer saying whether they are coming. Tapping it opens the event. {changedByName} is the person who changed it, as the server gives it. {eventTitle} is the event's title as the server gives it. The line under it says the new answer.",
    "placeholders": {
      "changedByName": {
        "type": "String",
        "example": "Bo"
      },
      "eventTitle": {
        "type": "String",
        "example": "Friday Night Games"
      }
    }
  },
  "notificationEventRsvpChangedUnnamedTitle": "Your reply to {eventTitle} was changed",
  "@notificationEventRsvpChangedUnnamedTitle": {
    "description": "Title of a notification sent to an attendee when their reply to an event, the answer saying whether they are coming, was changed by something other than a person with an account, so the server has no name to give. Tapping it opens the event. {eventTitle} is the event's title as the server gives it. The line under it says the new answer.",
    "placeholders": {
      "eventTitle": {
        "type": "String",
        "example": "Friday Night Games"
      }
    }
  },
  "notificationEventRsvpNowAttendingDetail": "Now: Going",
  "@notificationEventRsvpNowAttendingDetail": {
    "description": "Second line of the notification that someone changed the user's reply to an event: the new answer is that they are going."
  },
  "notificationEventRsvpNowMaybeDetail": "Now: Maybe",
  "@notificationEventRsvpNowMaybeDetail": {
    "description": "Second line of the notification that someone changed the user's reply to an event: the new answer is that they might go."
  },
  "notificationEventRsvpNowNotAttendingDetail": "Now: Not going",
  "@notificationEventRsvpNowNotAttendingDetail": {
    "description": "Second line of the notification that someone changed the user's reply to an event: the new answer is that they are not going."
  },
  "notificationEventRsvpNowInvitedDetail": "Now: Invited",
  "@notificationEventRsvpNowInvitedDetail": {
    "description": "Second line of the notification that someone changed the user's reply to an event: the reply was cleared, so they are invited and have not answered."
  },
  "notificationEventInviteReceivedTitle": "{inviterName} invited you to {eventTitle}",
  "@notificationEventInviteReceivedTitle": {
    "description": "Title of a notification telling the user they were invited to an event. It opens nothing for now, since the app has no page for an invite to an event: the user can only mark it read. {inviterName} is the name of the person who invited them, as the server gives it. {eventTitle} is the event's title as the server gives it.",
    "placeholders": {
      "inviterName": {
        "type": "String",
        "example": "Ana"
      },
      "eventTitle": {
        "type": "String",
        "example": "Friday Night Games"
      }
    }
  },
  "notificationEventInviteAcceptedTitle": "{inviteeName} accepted your invite to {eventTitle}",
  "@notificationEventInviteAcceptedTitle": {
    "description": "Title of a notification sent to the person who invited someone to an event, when the person invited accepted. Tapping it opens the event. {inviteeName} is the name of the person invited, as the server gives it. {eventTitle} is the event's title as the server gives it.",
    "placeholders": {
      "inviteeName": {
        "type": "String",
        "example": "Cy"
      },
      "eventTitle": {
        "type": "String",
        "example": "Friday Night Games"
      }
    }
  },
  "notificationEventInviteDeclinedTitle": "{inviteeName} declined your invite to {eventTitle}",
  "@notificationEventInviteDeclinedTitle": {
    "description": "Title of a notification sent to the person who invited someone to an event, when the person invited declined. Tapping it opens the event. {inviteeName} is the name of the person invited, as the server gives it. {eventTitle} is the event's title as the server gives it.",
    "placeholders": {
      "inviteeName": {
        "type": "String",
        "example": "Cy"
      },
      "eventTitle": {
        "type": "String",
        "example": "Friday Night Games"
      }
    }
  },
  "notificationEventOccurrenceProposedTitle": "A new date was proposed for {eventTitle}",
  "@notificationEventOccurrenceProposedTitle": {
    "description": "Title of a notification telling the user that a date was proposed for an event. Tapping it opens the event on its Games tab, on that date. {eventTitle} is the event's title as the server gives it. The line under it names the date, when the server gave one.",
    "placeholders": {
      "eventTitle": {
        "type": "String",
        "example": "Friday Night Games"
      }
    }
  },
  "notificationEventOccurrenceConfirmedTitle": "A date for {eventTitle} was confirmed",
  "@notificationEventOccurrenceConfirmedTitle": {
    "description": "Title of a notification telling the user that one of an event's dates was confirmed, so it is going ahead on that date. Tapping it opens the event on its Games tab, on that date. {eventTitle} is the event's title as the server gives it. The line under it names the date, when the server gave one.",
    "placeholders": {
      "eventTitle": {
        "type": "String",
        "example": "Friday Night Games"
      }
